# 复制为 .env 后填写真实值，.env 已在 .gitignore 中，不会被提交。
#
# 程序启动时会自动读取它：先找 tasks.yaml 所在目录，再找当前工作目录，
# 不需要手动 export。已经存在的环境变量优先于本文件，所以临时
# `NTFY_TOPIC=xxx radar run` 可以盖过文件里的值。
#
# tasks.yaml 里用 ${VAR_NAME} 引用这里的变量，配置文件本身就不必写明文密钥，
# 可以放心提交到 GitHub。
#
# 注意：这个文件里只放「密钥 / Cookie / 账号」这类东西。
# 演出 ID、车站名、日期这些业务参数放 tasks.yaml。

# ===========================================================================
# 一、监控平台凭据
# ===========================================================================

# ---- 12306 铁路 ----
# 可选。不填也能查询余票（走匿名会话）；填了成功率更高。
# 获取方式：浏览器登录 12306 后 F12 -> Network -> 任意请求的 Cookie 头，整段复制。
RAIL12306_COOKIE=

# ---- 机票（Amadeus 正规开放 API）----
# 到 https://developers.amadeus.com 注册 → My Self-Service Workspace →
# 建一个 App → 复制 API Key 与 API Secret。
# Test 环境免费、不限量（数据是缓存的，不能真出票），足够做监控。
AMADEUS_CLIENT_ID=
AMADEUS_CLIENT_SECRET=
# 留空走 Test 环境。正式环境（要签约）填 https://api.amadeus.com
AMADEUS_HOST=

# ---- 大麦 ----
# 必填。大麦接口要先算 mtop 签名，而签名用的 token 就在 Cookie 里的 _m_h5_tk。
# 获取方式：浏览器登录大麦 → F12 → Application → Cookies → damai.cn →
# 把整条 Cookie（至少含 _m_h5_tk、_m_h5_tk_enc）复制到这里。
# 注意：Cookie 几十天会失效，届时余票查询会报「令牌过期」，回来换一条即可。
DAMAI_COOKIE=

# ---- 猫眼 ----
# **不需要填。** 2026-09-30 实测：猫眼的余票接口是公开的（网关
# m.dianping.com/myshow，只认一个 sellChannel=7），不带 Cookie 也能跑。
# 填了会被带上，仅此而已——别为了它去折腾 F12。
MAOYAN_COOKIE=

# ---- 摩天轮票务 ----
# **同样不需要填。** 网关 unify.moretickets.com 的公开接口，匿名可用。
# 注意它只认 POST + application/json，GET 会返回一个 12123 空壳。
MORETICKETS_COOKIE=

# ---- 纷玩岛 ----
# 建议用网页版票务页的 Cookie（小程序接口带 wx 加密参数，本项目不做签名逆向）。
FENWANDAO_COOKIE=

# ===========================================================================
# 二、通知渠道
# ===========================================================================
# 怎么选：跑 `radar channels`，会列出全部渠道的免费额度和准备成本。
# 默认推荐 ntfy —— 不用注册、不用 API Key。

# ---- ntfy（零注册，默认推荐）----
# 不需要账号。装一个 ntfy App（Android / iOS / Web 都有），订阅下面这个名字即可。
# 值就是「频道名」，同时也相当于密码：别人猜到就能收到你的通知，
# 所以请用一段随机字符串，别用 ticket 这种。生成一个：
#   python -c "import secrets;print('ntfy-radar-'+secrets.token_hex(6))"
# 想更私密或想扩容，可以自建：docker run -d -p 8080:80 binwiederhier/ntfy serve
NTFY_TOPIC=

# ---- Bark（iOS 专用，走 APNs，比 ntfy 更即时）----
# 装 Bark App，首页会显示一串设备码；也可以直接粘贴整条推送地址。
BARK_KEY=

# ---- PushPlus（微信推送，需实名）----
# https://www.pushplus.plus/ 微信扫码登录 → 个人中心 → 复制 Token。
# 实名认证后免费额度 200 条/天。未实名调用会返回 905，消息发不出去。
# 直达微信最省事，但免费额度由平台说了算，所以没设成默认渠道。
PUSHPLUS_TOKEN=

# ---- Server酱（微信推送）----
# https://sct.ftqq.com/ 扫码登录后获取 SendKey。
# 注意：免费版每天只能发 5 条，做余票监控偏少；要更大额度得订阅（3 元/月起）。
SERVERCHAN_SENDKEY=

# ---- 钉钉机器人 ----
# 群设置 -> 智能群助手 -> 添加机器人 -> 自定义 -> 安全设置勾选「加签」
DINGTALK_WEBHOOK=
DINGTALK_SECRET=

# ---- 企业微信群机器人 ----
# 群设置 -> 群机器人 -> 添加 -> 复制 Webhook 地址
WECOM_WEBHOOK=

# ---- Telegram ----
# 找 @BotFather 创建机器人拿 token；chat_id 找 @userinfobot 查
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# ---- 邮件（SMTP）----
SMTP_HOST=smtp.qq.com
SMTP_PORT=465
SMTP_USER=
# QQ 邮箱要用「授权码」，不是登录密码
SMTP_PASSWORD=
SMTP_TO=

# ===========================================================================
# 三、AI 配置助手（可选，不影响监控）
# ===========================================================================
# 只有 `radar infer` 用得到：新接一个平台时，把 F12 抓到的响应 JSON 丢给它，
# 让它替你推断 items_path / seat_name / seat_status 这些字段路径。
# 推断结果会自动用真实解析器跑一遍验证，猜错会被当场退回重试。
#
# 不填这些也完全能跑监控 —— 这是开发期辅助工具，不是运行期依赖。
# 任何 OpenAI 兼容网关都行（B.AI / Agnes / 自建 vLLM 等）。
# 注意：海外网关需要代理，且代理要能覆盖命令行（全局或 TUN 模式）。
LLM_BASE_URL=https://api.b.ai/v1
LLM_API_KEY=
LLM_MODEL=deepseek-v4-flash
