# 运行数据：余票快照与变更历史，不要提交
# 注意用 data/* 而不是 data/，否则 !data/.gitkeep 这条否定规则不生效
data/*
!data/.gitkeep
*.db
*.db-wal
*.db-shm

# 本地配置：含 cookie / sendkey，绝不提交
tasks.yaml
.env
.env.local

# Python
__pycache__/
*.py[cod]
*.egg-info/
.eggs/
build/
dist/
.venv/
venv/
env/

# 本机便捷脚本：含机器专属的 python 绝对路径，不进仓库
run-monitor.cmd
login.cmd
onboard.cmd

# 双击启动脚本留下的日志（login.log / monitor.log / onboard.log）
*.log

# 工具
.pytest_cache/
.ruff_cache/
.mypy_cache/
.coverage
htmlcov/

# 编辑器 / 系统
.vscode/
.idea/
.DS_Store
Thumbs.db

# 微信开发者工具生成的本机私有配置（每人不同，不进仓库）
project.private.config.json

# 字体源文件 8MB，子集化后已入包，不进仓库
tools/font-src/
open_devtools.bat

# 服务端自持凭据（大麦 Cookie / 纷玩岛 token），绝不提交
server/config.json
server/server.log
