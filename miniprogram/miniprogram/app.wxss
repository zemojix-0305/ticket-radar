/* ==========================================================================
   全局设计令牌 + 通用组件
   --------------------------------------------------------------------------
   风格：ins 高级风（第七轮）。用户明确：白色系为主、高级、不要可爱。
   · 背景 #F7F7FA 淡灰白 + 纯白卡，近黑 #1C1C1E 做主色（主 CTA/选中态）；
   · 彩色只留给语义：有票绿 / 无票灰 / 异常红 / 提醒琥珀；
   · 大标题排版 + 克制线性图标，无插画无贴纸（狐狸已按要求移除）；
   · 平台名一律用本名：大麦 / 猫眼 / 摩天轮 / 票星球 / 12306。

   硬规则不变：
   1. 零渐变。骨架屏呼吸脉冲。
   2. 主色唯一：近黑。彩色只来自语义色。
   3. 所有可点元素必须有按压反馈（hover-class）。
   4. 对比度用 tools/check_palette.py 校验（WCAG AA）。
   ========================================================================== */
page {
  --bg: #F7F7FA;
  --card: #FFFFFF;

  --ink: #1C1C1E;

  --brand: #1C1C1E;
  --brand-deep: #000000;
  --brand-weak: #F1F1F4;
  --brand-line: #E2E2E6;

  --ok: #237A45;
  --ok-weak: #E3F5EA;
  --none: #6B6B73;
  --none-weak: #F1F1F4;
  --bad: #C43C2C;
  --bad-weak: #FCEBE9;
  --warn: #9B6E0A;
  --warn-weak: #FFF7E0;

  --t1: #1C1C1E;
  --t2: #5A5A60;
  --t3: #6C6C75;
  --line: rgba(28, 28, 30, 0.07);

  --r: 22px;
  --r-sm: 16px;
  --gut: 10px;

  --on-brand: #FFFFFF;
  --disabled: #E2E2E6;
  --bar-idle: #E5E5EA;

  --shadow: 0 2px 8px rgba(28, 28, 30, 0.05), 0 10px 24px rgba(28, 28, 30, 0.04);
  --shadow-brand: 0 4px 14px rgba(28, 28, 30, 0.18);

  background: var(--bg);
  font-family: -apple-system, "PingFang SC", "Hiragino Sans GB", "Microsoft YaHei", sans-serif;
  font-size: 14px;
  color: var(--t1);
  letter-spacing: 0.2px;
}

/* ---------- 卡片 ---------- */
.card {
  background: var(--card);
  border-radius: var(--r);
  margin: var(--gut);
  overflow: hidden;
  box-shadow: var(--shadow);
}
.card-pad { padding: 18px 20px; }

/* ---------- inset grouped list（保留，用于设置类页面）---------- */
.group { margin: var(--gut); background: var(--card); border-radius: var(--r); box-shadow: var(--shadow); }
.g-row {
  display: flex;
  align-items: center;
  gap: 12px;
  padding: 14px 16px;
  position: relative;
}
.g-row + .g-row::after {
  content: '';
  position: absolute;
  left: 16px; right: 0; top: 0;
  height: 1px;
  background: var(--line);
  transform: scaleY(0.5);
  transform-origin: top;
}
.g-row:last-child::after { display: none; }

/* ---------- 文字 ---------- */
.t1 { font-size: 16px; font-weight: 600; color: var(--t1); letter-spacing: 0.2px; }
.t2 { font-size: 13px; color: var(--t2); letter-spacing: 0.2px; }
.t3 { font-size: 12px; color: var(--t3); letter-spacing: 0.3px; }
.num {
  font-size: 32px;
  font-weight: 700;
  line-height: 1.1;
  font-variant-numeric: tabular-nums;
  letter-spacing: -0.5px;
}

/* ---------- 状态标签 ---------- */
.tag {
  display: inline-block;
  padding: 3px 11px;
  border-radius: 999px;
  font-size: 12px;
  line-height: 18px;
  white-space: nowrap;
  letter-spacing: 0.2px;
}
.tag-ok { color: var(--ok); background: var(--ok-weak); }
.tag-none { color: var(--none); background: var(--none-weak); }
.tag-bad { color: var(--bad); background: var(--bad-weak); }
.tag-warn { color: var(--warn); background: var(--warn-weak); }
.tag-brand { color: var(--brand); background: var(--brand-weak); }

/* ---------- 按压反馈 ---------- */
.press { transition: opacity 0.15s ease; }
.press-hover { opacity: 0.6; }
.press-card { transition: opacity 0.15s ease, transform 0.15s ease; }
.press-card-hover { opacity: 0.92; transform: scale(0.985); }

/* ---------- 按钮 ---------- */
.btn {
  display: flex;
  align-items: center;
  justify-content: center;
  height: 46px;
  padding: 0 22px;
  border-radius: 23px;
  font-size: 15px;
  font-weight: 500;
  line-height: 1;
  letter-spacing: 0.5px;
  box-sizing: border-box;
}
.btn::after { border: none; }
.btn-primary {
  background: var(--brand);
  color: var(--on-brand);
  box-shadow: var(--shadow-brand);
}
.btn-primary[disabled] { background: var(--disabled); color: var(--on-brand); box-shadow: none; }
.btn-ghost {
  background: var(--brand-weak);
  color: var(--brand);
}
.btn-line {
  background: transparent;
  color: var(--t2);
  border: 1px solid var(--brand-line);
}

/* ---------- 空状态 ----------
   空状态必须给出下一步动作。装饰用极简线条圆环，不用插画。 */
.empty { padding: 44px 32px; text-align: center; }
.empty-mark {
  width: 64px;
  height: 64px;
  margin: 0 auto 16px;
  border-radius: 50%;
  border: 2px solid var(--line);
  position: relative;
}
.empty-mark::before {
  content: '';
  position: absolute;
  left: 50%;
  top: -8px;
  width: 4px;
  height: 4px;
  border-radius: 50%;
  background: var(--brand-weak);
  transform: translateX(-50%);
  border: 1px solid var(--t3);
}
.empty-title { font-size: 15px; font-weight: 500; color: var(--t1); margin-bottom: 7px; }
.empty-sub { font-size: 13px; color: var(--t3); line-height: 1.8; letter-spacing: 0.2px; }

/* ---------- 骨架屏 ---------- */
.sk {
  background: var(--bar-idle);
  border-radius: 8px;
  animation: sk-pulse 1.4s ease infinite;
}
@keyframes sk-pulse {
  0%, 100% { opacity: 1; }
  50% { opacity: 0.45; }
}

/* ---------- 底部弹层 ---------- */
.mask {
  position: fixed;
  left: 0; right: 0; top: 0; bottom: 0;
  background: rgba(28, 28, 30, 0.32);
  z-index: 90;
}
.sheet {
  position: fixed;
  left: 0; right: 0; bottom: 0;
  z-index: 91;
  background: var(--card);
  border-radius: 28px 28px 0 0;
  padding: 14px 20px calc(20px + env(safe-area-inset-bottom));
}
.sheet-grab {
  width: 36px; height: 4px; border-radius: 2px;
  background: var(--bar-idle); margin: 0 auto 16px;
}
.sheet-title { font-size: 17px; font-weight: 600; margin-bottom: 4px; letter-spacing: 0.2px; }
.sheet-sub { font-size: 12px; color: var(--t3); margin-bottom: 16px; line-height: 1.7; }

/* ---------- 表单 ---------- */
.field { margin-bottom: 16px; }
.field-lbl { font-size: 13px; color: var(--t2); margin-bottom: 8px; letter-spacing: 0.2px; }
.input, .input-pick {
  width: 100%;
  box-sizing: border-box;
  height: 46px;
  padding: 0 16px;
  background: var(--bg);
  border-radius: var(--r-sm);
  font-size: 15px;
  color: var(--t1);
}
.input-pick { line-height: 46px; }

/* ---------- 分区标题 ---------- */
.sec {
  display: flex;
  align-items: baseline;
  justify-content: space-between;
  padding: 22px 20px 10px;
}
.sec-title {
  font-size: 14px;
  font-weight: 600;
  color: var(--t1);
  display: flex;
  align-items: center;
  gap: 7px;
  letter-spacing: 0.4px;
}
.sec-title::before {
  content: '';
  width: 6px;
  height: 6px;
  border-radius: 50%;
  background: var(--brand);
  flex-shrink: 0;
}
.sec-more { font-size: 12px; color: var(--t3); letter-spacing: 0.2px; }

/* ---------- 底部安全留白 ---------- */
.safe { height: 28px; }
