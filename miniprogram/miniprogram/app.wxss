/* ==========================================================================
   全局设计令牌 + 通用组件
   --------------------------------------------------------------------------
   风格：纯白极简（第八轮）。参考用户给的两张图 + 喜茶小程序：
   · 纯白底 #FFFFFF，无色块无阴影堆叠——分区靠 1px 细线和大留白；
   · 唯一点缀色：钴蓝 #2456DB（参考图按钮蓝），只给主 CTA 和关键交互；
     粉色全部删除。
   · 手写体点缀：楷体（Kaiti SC）用于页面标题与装饰字——对应参考图
     左上角「羽衣甘蓝 鲜榨」的手写感；
   · 刺绣字点缀：虚线描边胶囊 .stitch-tag，模拟缝线效果；
   · 英文小注：小号大写 + 大字距（参考图 MUSHROOM BAKERY 的排法）；
   · 平台名一律本名：大麦 / 猫眼 / 摩天轮 / 票星球 / 12306。

   硬规则不变：
   1. 零渐变。骨架屏呼吸脉冲。
   2. 彩色只来自钴蓝 + 语义色（有票绿/无票灰/异常红/提醒琥珀）。
   3. 所有可点元素必须有按压反馈（hover-class）。
   4. 对比度用 tools/check_palette.py 校验（WCAG AA）。
   ========================================================================== */
/* ---------- 界面字体：龙藏手写体 ----------
   「Long Cang / 龙藏」子集（316KB，只含界面用到的 983 字），OFL 免费商用。
   钢笔手写感，用在页面大标题/留言/开屏——ins 手账的「字」担当。
   要换其他手写体时：1) 拿到 ttf；2) 跑
   python tools/subset_font.py <ttf> miniprogram/miniprogram/fonts/hand.woff2
   生僻字（用户随手输入的）会自动退回楷体/系统字体。 */
@font-face {
  font-family: "HandCN";
  src: url("/fonts/hand.woff2") format("woff2");
  font-weight: normal;
  font-style: normal;
}

page {
  --bg: #FFFFFF;
  --bg-soft: #F7F7F8;      /* 输入框/代码块的极浅灰底 */

  --card: #FFFFFF;

  --ink: #1A1A1A;

  --brand: #2456DB;        /* 钴蓝，唯一点缀色 */
  --brand-deep: #1D47B8;
  --brand-weak: #EDF1FE;
  --brand-line: #C9D4F6;

  /* accent = brand 的别名（monitor 页样式引用的是 accent 名） */
  --accent: #2456DB;
  --accent-weak: #EDF1FE;

  --ok: #1E7A46;
  --ok-weak: #E6F4EB;
  --none: #6A6A6F;
  --none-weak: #F4F4F5;
  --bad: #BC3B2C;
  --bad-weak: #FBEAE7;
  --warn: #96690A;
  --warn-weak: #FBF3DC;

  --t1: #1A1A1A;
  --t2: #6E6E73;
  --t3: #75757A;
  --line: #ECECEC;

  --r: 16px;
  --r-sm: 12px;
  --gut: 12px;

  --on-brand: #FFFFFF;
  --disabled: #E5E5E7;
  --bar-idle: #EDEDEF;

  --shadow: none;           /* 极简风：不用阴影，分区靠细线 */
  --shadow-brand: none;

  background: var(--bg);
  font-family: -apple-system, "PingFang SC", "Hiragino Sans GB", "Microsoft YaHei", sans-serif;
  font-size: 14px;
  color: var(--t1);
  letter-spacing: 0.2px;
}

/* ---------- 手写体点缀 ----------
   楷体栈：iOS 有 Kaiti SC，安卓退化到 KaiTi/楷体，再退化到衬线。
   只用在标题和装饰短语上，正文不用——可读性优先。 */
.font-hand {
  font-family: "HandCN", "Kaiti SC", "STKaiti", "楷体", "Yuanti SC", serif;
  font-weight: 400;
}

/* ---------- 英文小注 ----------
   参考图 MUSHROOM BAKERY 的排法：小号大写 + 大字距。 */
.en-note {
  font-size: 10px;
  letter-spacing: 2.5px;
  text-transform: uppercase;
  color: var(--t3);
}

/* ---------- 刺绣字点缀 ----------
   虚线描边胶囊 = 缝线。里面配楷体字，就是「绣」在界面上的小标签。 */
.stitch-tag {
  display: inline-flex;
  align-items: center;
  gap: 5px;
  padding: 3px 12px;
  border: 1.5px dashed #B8B8BC;
  border-radius: 999px;
  font-family: "HandCN", "Kaiti SC", "STKaiti", "楷体", serif;
  font-size: 12px;
  color: var(--t2);
  line-height: 18px;
}

/* ---------- 卡片：极简风用细线代替阴影 ---------- */
.card {
  background: var(--card);
  border-radius: var(--r);
  margin: var(--gut);
  overflow: hidden;
  border: 1px solid var(--line);
}
.card-pad { padding: 18px 20px; }

/* ---------- inset grouped list（设置类页面）---------- */
.group { margin: var(--gut); background: var(--card); border-radius: var(--r); border: 1px solid var(--line); }
.g-row {
  display: flex;
  align-items: center;
  gap: 12px;
  padding: 14px 16px;
  position: relative;
}
.g-row + .g-row::after {
  content: '';
  position: absolute;
  left: 16px; right: 0; top: 0;
  height: 1px;
  background: var(--line);
  transform: scaleY(0.5);
  transform-origin: top;
}
.g-row:last-child::after { display: none; }

/* ---------- 文字 ---------- */
.t1 { font-size: 16px; font-weight: 600; color: var(--t1); letter-spacing: 0.2px; }
.t2 { font-size: 13px; color: var(--t2); letter-spacing: 0.2px; }
.t3 { font-size: 12px; color: var(--t3); letter-spacing: 0.3px; }
.num {
  font-size: 32px;
  font-weight: 700;
  line-height: 1.1;
  font-variant-numeric: tabular-nums;
  letter-spacing: -0.5px;
}

/* ---------- 状态标签 ---------- */
.tag {
  display: inline-block;
  padding: 3px 11px;
  border-radius: 999px;
  font-size: 12px;
  line-height: 18px;
  white-space: nowrap;
  letter-spacing: 0.2px;
}
.tag-ok { color: var(--ok); background: var(--ok-weak); }
.tag-none { color: var(--none); background: var(--none-weak); }
.tag-bad { color: var(--bad); background: var(--bad-weak); }
.tag-warn { color: var(--warn); background: var(--warn-weak); }
.tag-brand { color: var(--brand); background: var(--brand-weak); }

/* ---------- 按压反馈 ---------- */
.press { transition: opacity 0.15s ease; }
.press-hover { opacity: 0.6; }
.press-card { transition: opacity 0.15s ease, transform 0.15s ease; }
.press-card-hover { opacity: 0.92; transform: scale(0.985); }

/* ---------- 按钮 ---------- */
.btn {
  display: flex;
  align-items: center;
  justify-content: center;
  height: 46px;
  padding: 0 22px;
  border-radius: 23px;
  font-size: 15px;
  font-weight: 500;
  line-height: 1;
  letter-spacing: 0.5px;
  box-sizing: border-box;
}
.btn::after { border: none; }
.btn-primary {
  background: var(--brand);
  color: var(--on-brand);
}
.btn-primary[disabled] { background: var(--disabled); color: var(--on-brand); }
.btn-ghost {
  background: var(--bg-soft);
  color: var(--t1);
}
.btn-line {
  background: transparent;
  color: var(--t2);
  border: 1px solid var(--line);
}

/* ---------- 空状态 ----------
   空状态必须给出下一步动作。装饰 = 一根简笔横线 + 楷体短语。 */
.empty { padding: 48px 32px; text-align: center; }
.empty-mark {
  width: 44px;
  height: 2px;
  margin: 0 auto 18px;
  background: var(--line);
  position: relative;
}
.empty-mark::before,
.empty-mark::after {
  content: '';
  position: absolute;
  top: -3px;
  width: 8px;
  height: 8px;
  border-radius: 50%;
  border: 1.5px solid var(--line);
  background: var(--card);
}
.empty-mark::before { left: -16px; }
.empty-mark::after { right: -16px; }
.empty-title { font-size: 15px; font-weight: 500; color: var(--t1); margin-bottom: 7px; }
.empty-sub { font-size: 13px; color: var(--t3); line-height: 1.8; letter-spacing: 0.2px; }

/* ---------- 骨架屏 ---------- */
.sk {
  background: var(--bar-idle);
  border-radius: 8px;
  animation: sk-pulse 1.4s ease infinite;
}
@keyframes sk-pulse {
  0%, 100% { opacity: 1; }
  50% { opacity: 0.45; }
}

/* ---------- 底部弹层 ---------- */
.mask {
  position: fixed;
  left: 0; right: 0; top: 0; bottom: 0;
  background: rgba(26, 26, 26, 0.32);
  z-index: 90;
}
.sheet {
  position: fixed;
  left: 0; right: 0; bottom: 0;
  z-index: 91;
  background: var(--card);
  border-radius: 24px 24px 0 0;
  padding: 14px 20px calc(20px + env(safe-area-inset-bottom));
}
.sheet-grab {
  width: 36px; height: 4px; border-radius: 2px;
  background: var(--bar-idle); margin: 0 auto 16px;
}
.sheet-title { font-size: 17px; font-weight: 600; margin-bottom: 4px; letter-spacing: 0.2px; }
.sheet-sub { font-size: 12px; color: var(--t3); margin-bottom: 16px; line-height: 1.7; }

/* ---------- 表单 ---------- */
.field { margin-bottom: 16px; }
.field-lbl { font-size: 13px; color: var(--t2); margin-bottom: 8px; letter-spacing: 0.2px; }
.input, .input-pick {
  width: 100%;
  box-sizing: border-box;
  height: 46px;
  padding: 0 16px;
  background: var(--bg-soft);
  border-radius: var(--r-sm);
  font-size: 15px;
  color: var(--t1);
}
.input-pick { line-height: 46px; }

/* ---------- 分区标题 ----------
   不用圆点：手写体中文 + 英文小注，参考图的双语排版。 */
.sec {
  display: flex;
  align-items: baseline;
  justify-content: space-between;
  padding: 24px 20px 12px;
}
.sec-title {
  font-family: "HandCN", "Kaiti SC", "STKaiti", "楷体", serif;
  font-size: 19px;
  color: var(--t1);
  letter-spacing: 1px;
}
.sec-more { font-size: 12px; color: var(--t3); letter-spacing: 0.2px; }

/* ---------- 底部安全留白 ---------- */
.safe { height: 28px; }
