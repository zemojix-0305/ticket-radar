/* ==========================================================================
   全局设计令牌 + 通用组件
   --------------------------------------------------------------------------
   风格：白底 Y2K × coquette 天使系（第十六轮）。
   · 底色仍以白为主（相纸白 #FBFCFE），但不再抗拒浅色块：
     极浅蓝天灰 --bg-soft / 长春花蓝浅底 --brand-weak 大面积用；
   · 主色：长春花蓝 #4461CF（periwinkle，Y2K 的电子天使感），
     白底对比 4.7:1，过 WCAG AA；
   · 辅色：薄荷 teal / 薰衣草 lav / 银 —— 全部从参考图来
     （天使翅膀、百合、锦鲤、音符、Y2K 旋涡那一系浅色）；
   · coquette 小巧思：和纸胶带（蓝）+ 纯 CSS 蝴蝶结 .bow + 蕾丝点线 .lace
     + Y2K 小星 ✦（.spark）；
   · 拼贴墙：每页垫一层 .bg-collage（board2 贴纸素材，透明度 0.08~0.16），
     只在卡片留白处露出来，像桌面上垫的拼贴纸；
   · 全部文字回归系统默认字体（第十五轮起不再有任何 font-family 声明）；
   · 平台名一律本名：大麦 / 猫眼 / 摩天轮 / B站会员购 / 票星球 / 12306。

   硬规则不变：
   1. 零渐变（蕾丝点线/条码用的是 repeating 图案，不是颜色渐变）。
   2. 彩色只来自长春花蓝 + 语义色（有票绿/无票灰/异常红/提醒琥珀）。
   3. 所有可点元素必须有按压反馈（hover-class）。
   4. 对比度用 tools/check_palette.py 校验（WCAG AA）。
   ========================================================================== */

page {
  --bg: #FBFCFE;          /* 相纸白：比纯白多一丁点冷调 */
  --bg-soft: #F0F4FC;     /* 输入框/代码块的极浅蓝天灰 */

  --card: #FFFFFF;

  --ink: #23283B;         /* 蓝黑墨水色，比纯黑柔和 */

  --brand: #4461CF;       /* 长春花蓝，Y2K 主色（白底 5.5:1） */
  --brand-deep: #3A54B8;  /* 深一档（白底 6.7:1） */
  --brand-weak: #EDF2FE;
  --brand-line: #C7D5F7;

  /* accent = brand 的别名（monitor 页样式引用的是 accent 名） */
  --accent: #4461CF;
  --accent-weak: #EDF2FE;

  /* Y2K 辅色：薄荷 / 薰衣草 / 银（弱底色用于标签和装饰） */
  --mint: #0E6E5F;
  --mint-weak: #E2F4EF;
  --lav: #6A5BC4;
  --lav-weak: #F0EDFB;
  --silver: #8E9BB3;

  --ok: #1E7A46;
  --ok-weak: #E6F4EB;
  --none: #6A6A6F;
  --none-weak: #F4F4F5;
  --bad: #BC3B2C;
  --bad-weak: #FBEAE7;
  --warn: #96690A;
  --warn-weak: #FBF3DC;

  --t1: #23283B;
  --t2: #5A6070;
  --t3: #6B7385;
  --line: #E8EDF6;

  --r: 16px;
  --r-sm: 12px;
  --gut: 12px;

  --on-brand: #FFFFFF;
  --disabled: #E5E5E7;
  --bar-idle: #EDEDEF;

  --shadow: none;           /* 极简风：不用阴影，分区靠细线 */
  --shadow-brand: none;

  background: var(--bg);
  font-size: 14px;
  color: var(--t1);
  letter-spacing: 0.2px;
}

/* ---------- 标题强调 ----------
   第十五轮：所有自定义字体（龙藏体/站酷快乐体/楷体）全部取消，
   全站文字回归系统默认字体。标题只靠字重和字距做层级。 */
.title-strong {
  font-weight: 600;
  letter-spacing: 0.5px;
}

/* ---------- 英文小注 ----------
   参考图 MUSHROOM BAKERY 的排法：小号大写 + 大字距。 */
.en-note {
  font-size: 10px;
  letter-spacing: 2.5px;
  text-transform: uppercase;
  color: var(--t3);
}

/* ---------- 刺绣字点缀 ----------
   虚线描边胶囊 = 缝线，绣在界面上的小标签（字体已回归系统默认）。 */
.stitch-tag {
  display: inline-flex;
  align-items: center;
  gap: 5px;
  padding: 3px 12px;
  border: 1.5px dashed #B8B8BC;
  border-radius: 999px;
  font-size: 12px;
  color: var(--t2);
  line-height: 18px;
}

/* ---------- 卡片：极简风用细线代替阴影 ---------- */
.card {
  background: var(--card);
  border-radius: var(--r);
  margin: var(--gut);
  overflow: hidden;
  border: 1px solid var(--line);
}
.card-pad { padding: 18px 20px; }

/* ---------- inset grouped list（设置类页面）---------- */
.group { margin: var(--gut); background: var(--card); border-radius: var(--r); border: 1px solid var(--line); }
.g-row {
  display: flex;
  align-items: center;
  gap: 12px;
  padding: 14px 16px;
  position: relative;
}
.g-row + .g-row::after {
  content: '';
  position: absolute;
  left: 16px; right: 0; top: 0;
  height: 1px;
  background: var(--line);
  transform: scaleY(0.5);
  transform-origin: top;
}
.g-row:last-child::after { display: none; }

/* ---------- 文字 ---------- */
.t1 { font-size: 16px; font-weight: 600; color: var(--t1); letter-spacing: 0.2px; }
.t2 { font-size: 13px; color: var(--t2); letter-spacing: 0.2px; }
.t3 { font-size: 12px; color: var(--t3); letter-spacing: 0.3px; }
.num {
  font-size: 32px;
  font-weight: 700;
  line-height: 1.1;
  font-variant-numeric: tabular-nums;
  letter-spacing: -0.5px;
}

/* ---------- 状态标签 ---------- */
.tag {
  display: inline-block;
  padding: 3px 11px;
  border-radius: 999px;
  font-size: 12px;
  line-height: 18px;
  white-space: nowrap;
  letter-spacing: 0.2px;
}
.tag-ok { color: var(--ok); background: var(--ok-weak); }
.tag-none { color: var(--none); background: var(--none-weak); }
.tag-bad { color: var(--bad); background: var(--bad-weak); }
.tag-warn { color: var(--warn); background: var(--warn-weak); }
.tag-brand { color: var(--brand); background: var(--brand-weak); }

/* ---------- 按压反馈 ---------- */
.press { transition: opacity 0.15s ease; }
.press-hover { opacity: 0.6; }
.press-card { transition: opacity 0.15s ease, transform 0.15s ease; }
.press-card-hover { opacity: 0.92; transform: scale(0.985); }

/* ---------- 按钮 ---------- */
.btn {
  display: flex;
  align-items: center;
  justify-content: center;
  height: 46px;
  padding: 0 22px;
  border-radius: 23px;
  font-size: 15px;
  font-weight: 500;
  line-height: 1;
  letter-spacing: 0.5px;
  box-sizing: border-box;
}
.btn::after { border: none; }
.btn-primary {
  background: var(--brand);
  color: var(--on-brand);
}
.btn-primary[disabled] { background: var(--disabled); color: var(--on-brand); }
.btn-ghost {
  background: var(--bg-soft);
  color: var(--t1);
}
.btn-line {
  background: transparent;
  color: var(--t2);
  border: 1px solid var(--line);
}

/* ---------- 空状态 ----------
   空状态必须给出下一步动作。装饰 = 一根简笔横线 + 楷体短语。 */
.empty { padding: 48px 32px; text-align: center; }
.empty-mark {
  width: 44px;
  height: 2px;
  margin: 0 auto 18px;
  background: var(--line);
  position: relative;
}
.empty-mark::before,
.empty-mark::after {
  content: '';
  position: absolute;
  top: -3px;
  width: 8px;
  height: 8px;
  border-radius: 50%;
  border: 1.5px solid var(--line);
  background: var(--card);
}
.empty-mark::before { left: -16px; }
.empty-mark::after { right: -16px; }
.empty-title { font-size: 15px; font-weight: 500; color: var(--t1); margin-bottom: 7px; }
.empty-sub { font-size: 13px; color: var(--t3); line-height: 1.8; letter-spacing: 0.2px; }

/* ---------- 骨架屏 ---------- */
.sk {
  background: var(--bar-idle);
  border-radius: 8px;
  animation: sk-pulse 1.4s ease infinite;
}
@keyframes sk-pulse {
  0%, 100% { opacity: 1; }
  50% { opacity: 0.45; }
}

/* ---------- 底部弹层 ---------- */
.mask {
  position: fixed;
  left: 0; right: 0; top: 0; bottom: 0;
  background: rgba(26, 26, 26, 0.32);
  z-index: 90;
}
.sheet {
  position: fixed;
  left: 0; right: 0; bottom: 0;
  z-index: 91;
  background: var(--card);
  border-radius: 24px 24px 0 0;
  padding: 14px 20px calc(20px + env(safe-area-inset-bottom));
}
.sheet-grab {
  width: 36px; height: 4px; border-radius: 2px;
  background: var(--bar-idle); margin: 0 auto 16px;
}
.sheet-title { font-size: 17px; font-weight: 600; margin-bottom: 4px; letter-spacing: 0.2px; }
.sheet-sub { font-size: 12px; color: var(--t3); margin-bottom: 16px; line-height: 1.7; }

/* ---------- 表单 ---------- */
.field { margin-bottom: 16px; }
.field-lbl { font-size: 13px; color: var(--t2); margin-bottom: 8px; letter-spacing: 0.2px; }
.input, .input-pick {
  width: 100%;
  box-sizing: border-box;
  height: 46px;
  padding: 0 16px;
  background: var(--bg-soft);
  border-radius: var(--r-sm);
  font-size: 15px;
  color: var(--t1);
}
.input-pick { line-height: 46px; }

/* ---------- 分区标题 ----------
   不用圆点：手写体中文 + 英文小注，参考图的双语排版。 */
.sec {
  display: flex;
  align-items: baseline;
  justify-content: space-between;
  padding: 24px 20px 12px;
}
.sec-title {
  font-size: 19px;
  font-weight: 600;
  color: var(--t1);
  letter-spacing: 0.5px;
  white-space: nowrap;   /* 标题类一律单行，折行=排版事故 */
}

/* ---------- 和纸胶带点缀 ----------
   手账感的核心小巧思：一条半透明玫瑰粉胶带斜贴在页面标题左上角，
   像把这一块「贴」上去的。纯 CSS，不占包体积。
   父容器需要 position:relative。 */
.tape {
  position: absolute;
  top: -7px;
  left: 16px;
  width: 54px;
  height: 15px;
  background: rgba(78, 107, 224, 0.14);
  transform: rotate(-4deg);
  border-radius: 2px;
  pointer-events: none;
}

/* ---------- 蝴蝶结点缀（coquette）----------
   三个部件：左右两个环（::before/::after）+ 中间结 .bow-k。
   纯 CSS，不占包体积。用法：
   <view class="bow"><view class="bow-k"></view></view> */
.bow {
  position: relative;
  width: 30px;
  height: 18px;
  flex-shrink: 0;
}
.bow::before,
.bow::after {
  content: '';
  position: absolute;
  top: 2px;
  width: 12px;
  height: 14px;
  background: var(--brand-weak);
  border: 1.5px solid var(--brand);
}
.bow::before {
  left: 1px;
  border-radius: 70% 15% 70% 15%;
  transform: rotate(-10deg);
}
.bow::after {
  right: 1px;
  border-radius: 15% 70% 15% 70%;
  transform: rotate(10deg);
}
.bow-k {
  position: absolute;
  left: 50%;
  top: 50%;
  width: 8px;
  height: 8px;
  margin: -4px 0 0 -4px;
  background: var(--brand);
  border-radius: 3px;
  z-index: 1;
}
.sec-more { font-size: 12px; color: var(--t3); letter-spacing: 0.2px; }

/* ---------- 底部安全留白 ---------- */
.safe { height: 28px; }

/* ---------- 背景拼贴层（coquette 手账墙，第十五轮）----------
   每个页面 .page 里放一个 <view class="bg-collage">，内嵌若干
   <image class="bg-stk">，素材直接用 images/board2 里的贴纸。
   三个设计约束：
   1. z-index:-1 —— 压在一切内容（含卡片白底）之下，只在留白缝隙透出，
      绝不在文字上糊一层；
   2. 透明度 0.06~0.14 —— 「透明度很高的拼贴素材」，远看是肌理，近看才认出；
   3. pointer-events:none —— 纯装饰，不抢点击。
   注意：父级 .page 需要 position:relative（各页 wxss 已加）。 */
.bg-collage {
  position: absolute;
  top: 0; left: 0; right: 0; bottom: 0;
  min-height: 100%;
  overflow: hidden;
  pointer-events: none;
  z-index: -1;
}
.bg-stk { position: absolute; }
.bg-faint  { opacity: 0.09; }   /* 大块素材：最淡 */
.bg-soft   { opacity: 0.13; }   /* 中等素材 */
.bg-visible { opacity: 0.18; }  /* 小星星：稍亮，点到为止 */

/* ---------- Y2K 浅色光晕（第十六轮）----------
   参考图是「天使系」的浅色空气感：浅蓝/薄荷/薰衣草的大色块。
   用纯色圆（不是渐变）以很低的存在感垫在页面角落，配合拼贴层
   做出「相纸上有光」的感觉。用法：放在 .bg-collage 里。 */
.bg-tint {
  position: absolute;
  border-radius: 50%;
  pointer-events: none;
}
.bg-tint-blue  { background: var(--brand-weak); }
.bg-tint-mint  { background: var(--mint-weak); }
.bg-tint-lav   { background: var(--lav-weak); }
.bg-tint-a { width: 260px; height: 260px; top: -90px; right: -70px; opacity: 0.85; }
.bg-tint-b { width: 200px; height: 200px; top: 38%; left: -80px; opacity: 0.7; }
.bg-tint-c { width: 230px; height: 230px; bottom: -60px; right: -60px; opacity: 0.6; }

/* ---------- 蕾丝点线（coquette 分隔线）----------
   一行等距小圆点，模仿蕾丝花边。用于分区之间，比直线软。 */
.lace {
  height: 9px;
  background-image: radial-gradient(circle, var(--brand-line) 2.2px, transparent 2.8px);
  background-size: 13px 9px;
  background-repeat: repeat-x;
  background-position: center top;
  opacity: 0.9;
}

/* ---------- Y2K 四角星（文字符号，不引入字体）---------- */
.spark { color: var(--brand); font-size: 12px; }
.spark-lg { color: var(--brand); font-size: 16px; }
