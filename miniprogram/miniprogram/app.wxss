page{background:#F5F6F7;font-family:-apple-system,BlinkMacSystemFont,"Segoe UI",Roboto,"Helvetica Neue",sans-serif;}
.card{background:#fff;border-radius:10px;padding:14px 16px;margin:10px 12px;box-shadow:0 1px 3px rgba(0,0,0,.06);}
.row{display:flex;align-items:center;justify-content:space-between;}
.dim{color:#9CA3AF;font-size:12px;}
.muted{color:#6B7280;font-size:13px;}
.ok{color:#0F6E56;background:#E1F5EE;}
.bad{color:#B42318;background:#FEE4E2;}
.tag{display:inline-block;padding:2px 8px;border-radius:10px;font-size:12px;}
