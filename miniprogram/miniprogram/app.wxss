/* vant 图标字体内联（原版从 at.alicdn.com 远程加载，小程序无法请求外部域名，
   于是所有 van-icon 都渲染成豆腐块——「已删除」那个带叉的方框就是它）。
   放在 app.wxss 是因为自定义组件里的 @font-face 在部分基础库不生效。 */
@font-face{font-display:auto;font-family:vant-icon;font-style:normal;font-weight:400;src:url(data:font/woff;charset=utf-8;base64,) format("woff")}

/* ==========================================================================
   全局设计令牌 + 通用组件（第十九轮：回归白色灵动）
   --------------------------------------------------------------------------
   风格语言 = 白色灵动（第七轮 ins 高级风的回归与精修）：
   · 淡灰白底 #F7F7FA + 纯白卡 #FFFFFF，分区靠柔和阴影与大留白，不靠描边；
   · 近黑 #1C1C1E 做唯一主色（主 CTA / 选中态 / tabs 下划线）；
   · 彩色只留给语义：有票绿 / 无票灰 / 异常红 / 提醒琥珀；
   · 大圆角 22px（--r）是「灵动」的核心，配柔和双阴影；
   · 克制线性图标，无插画无手账元素（胶带/印章/打孔线/条码全数废除）；
   · 全部文字回归系统默认字体（第十五轮起零 font-family，硬规则）；
   · 拼贴只留在开屏与背景层（bg-stk，透明度 0.06~0.12，远看肌理近看才认出）。

   配色均过 WCAG AA（tools/check_palette.py 校验）。
   ========================================================================== */

page {
  /* ---------- 纸面 ---------- */
  --paper:      #F7F7FA;   /* 页面底：淡灰白 */
  --paper-deep: #F1F1F4;   /* 深一档底（输入框/代码块） */
  --card:       #FFFFFF;   /* 卡片：纯白 */
  --card2:      #F7F7F8;   /* 卡内嵌块 */

  /* ---------- 墨 ---------- */
  --ink:        #1C1C1E;   /* 主文字：近黑 */
  --ink2:       #5A5A60;   /* 次文字 */
  --ink3:       #6C6C75;   /* 弱文字 / 占位符（纸面 5.2:1） */
  --line:       #ECECEC;   /* 细线 */
  --line2:      #E2E2E6;   /* 强分隔 */

  /* ---------- 主色：近黑（唯一强调色，替代所有花色） ---------- */
  --accent:      #1C1C1E;
  --accent-deep: #000000;
  --accent-weak: #F1F1F4;

  /* ---------- 语义色 ---------- */
  --stamp:      #C43C2C;   /* 异常 / 售罄 / 回流提醒（纸面 5.4:1） */
  --stamp-weak: #FCEBE9;
  --warn:       #8D6308;   /* 提醒 / 公告（纸面 5.0:1） */
  --warn-weak:  #FFF7E0;

  /* ---------- 形状与节奏：大圆角是灵动感核心 ---------- */
  --r:      22px;     /* 卡片 / 按钮：大圆角 */
  --r-sm:   16px;     /* 卡内嵌块 */
  --r-pill: 999px;    /* 功能：药丸 */
  --gut:    12px;

  --on-brand:  #FFFFFF;
  --disabled:  #E2E2E6;
  --bar-idle:  #E5E5EA;

  /* ---------- 阴影：柔和双阴影，禁纯黑重投影 ---------- */
  --shadow:       0 2px 8px rgba(28, 28, 30, 0.05), 0 10px 24px rgba(28, 28, 30, 0.04);
  --shadow-brand: 0 4px 14px rgba(28, 28, 30, 0.18);

  background: var(--paper);
  font-size: 14px;
  color: var(--ink);
  letter-spacing: 0.2px;
}

/* ==========================================================================
   旧令牌别名（兼容各页历史类名，全部指向白色灵动色板；新代码请用新名）
   ========================================================================== */
page {
  --bg:         var(--paper);
  --bg-soft:    var(--card2);
  --brand:      var(--accent);
  --brand-deep: var(--accent-deep);
  --brand-weak: var(--accent-weak);
  --brand-line: var(--line2);
  --ok:         #237A45;
  --ok-weak:    #E3F5EA;
  --none:       #6B6B73;
  --none-weak:  #F1F1F4;
  --bad:        var(--stamp);
  --bad-weak:   var(--stamp-weak);
  --t1:         var(--ink);
  --t2:         var(--ink2);
  --t3:         var(--ink3);
}

/* ---------- 标题强调：只靠字重与字距做层级（系统默认字体） ---------- */
.title-strong {
  font-weight: 600;
  letter-spacing: 0.5px;
}

/* ---------- 纸卡片：纯白 + 大圆角 + 柔和阴影，无描边 ---------- */
.card, .paper {
  background: var(--card);
  border-radius: var(--r);
  margin: var(--gut);
  overflow: hidden;
  position: relative;
  box-shadow: var(--shadow);
}
.card-pad { padding: 18px 20px; }

/* ---------- 分组列表（设置类页面） ---------- */
.group { margin: var(--gut); background: var(--card); border-radius: var(--r); box-shadow: var(--shadow); }
.g-row {
  display: flex;
  align-items: center;
  gap: 12px;
  padding: 14px 16px;
  position: relative;
}
.g-row + .g-row::after {
  content: '';
  position: absolute;
  left: 16px; right: 0; top: 0;
  height: 1px;
  background: var(--line);
  transform: scaleY(0.5);
  transform-origin: top;
}
.g-row:last-child::after { display: none; }

/* ---------- 文字 ---------- */
.t1 { font-size: 16px; font-weight: 600; color: var(--ink); letter-spacing: 0.2px; }
.t2 { font-size: 13px; color: var(--ink2); letter-spacing: 0.2px; }
.t3 { font-size: 12px; color: var(--ink3); letter-spacing: 0.3px; }
.num {
  font-size: 32px;
  font-weight: 700;
  line-height: 1.1;
  font-variant-numeric: tabular-nums;
  letter-spacing: -0.5px;
}

/* ---------- 状态标签：实心弱色药丸，无描边 ---------- */
.tag {
  display: inline-block;
  padding: 2px 10px;
  border-radius: var(--r-pill);
  font-size: 11px;
  line-height: 17px;
  white-space: nowrap;
  letter-spacing: 0.5px;
  color: var(--ink2);
  background: var(--none-weak);
}
.tag-ok    { color: var(--ok); background: var(--ok-weak); }
.tag-brand { color: var(--ink); background: var(--accent-weak); }
.tag-none  { color: var(--none); background: var(--none-weak); }
.tag-bad   { color: var(--stamp); background: var(--stamp-weak); }
.tag-warn  { color: var(--warn); background: var(--warn-weak); }
/* 已下架 / 已暂停：这两个状态以前没有样式类，落到 .tag 基类上跟「无票」长得一模一样，
   用户分不出「这票没了」和「我把它关了」 */
.tag-off   { color: var(--ink3); background: var(--none-weak); }
.tag-pause { color: var(--ink3); background: var(--none-weak); }

/* ---------- 按压反馈 ---------- */
.press { transition: opacity 0.15s ease; }
.press-hover { opacity: 0.6; }
.press-card { transition: opacity 0.15s ease, transform 0.15s ease; }
.press-card-hover { opacity: 0.92; transform: scale(0.985); }

/* ---------- 按钮：大圆角，主按钮近黑实心 ---------- */
.btn {
  display: flex;
  align-items: center;
  justify-content: center;
  height: 44px;
  padding: 0 20px;
  border-radius: var(--r-pill);
  font-size: 15px;
  font-weight: 500;
  line-height: 1;
  letter-spacing: 1px;
  box-sizing: border-box;
}
.btn::after { border: none; }
.btn-primary {
  background: var(--accent);
  color: var(--on-brand);
}
.btn-primary[disabled] { background: var(--disabled); color: var(--on-brand); }
.btn-ghost {
  background: var(--card);
  color: var(--ink);
  border: 1px solid var(--line2);
}
.btn-line {
  background: transparent;
  color: var(--ink2);
  border: 1px solid var(--line);
}

/* ---------- 空状态：给出下一步动作 ---------- */
.empty { padding: 48px 32px; text-align: center; }
.empty-mark {
  width: 36px;
  height: 4px;
  border-radius: var(--r-pill);
  margin: 0 auto 18px;
  background: var(--disabled);
}
.empty-title { font-size: 15px; font-weight: 500; color: var(--ink); margin-bottom: 7px; }
.empty-sub { font-size: 13px; color: var(--ink3); line-height: 1.8; letter-spacing: 0.2px; }

/* ---------- 骨架屏 ---------- */
.sk {
  background: var(--bar-idle);
  border-radius: 8px;
  animation: sk-pulse 1.4s ease infinite;
}
@keyframes sk-pulse {
  0%, 100% { opacity: 1; }
  50% { opacity: 0.45; }
}

/* ---------- 底部弹层：白面 + 大圆角顶部 ---------- */
.mask {
  position: fixed;
  left: 0; right: 0; top: 0; bottom: 0;
  background: rgba(28, 28, 30, 0.4);
  z-index: 90;
}
.sheet {
  position: fixed;
  left: 0; right: 0; bottom: 0;
  z-index: 91;
  background: var(--card);
  border-radius: 20px 20px 0 0;
  padding: 14px 20px calc(20px + env(safe-area-inset-bottom));
}
.sheet-grab {
  width: 36px; height: 4px; border-radius: 2px;
  background: var(--disabled); margin: 0 auto 16px;
}
.sheet-title { font-size: 17px; font-weight: 600; margin-bottom: 4px; letter-spacing: 0.2px; }
.sheet-sub { font-size: 12px; color: var(--ink3); margin-bottom: 16px; line-height: 1.7; }

/* ---------- 表单：浅灰底输入框 ---------- */
.field { margin-bottom: 16px; }
.field-lbl { font-size: 13px; color: var(--ink2); margin-bottom: 8px; letter-spacing: 0.2px; }
.input, .input-pick {
  width: 100%;
  box-sizing: border-box;
  height: 44px;
  padding: 0 14px;
  background: var(--paper-deep);
  border: 1px solid var(--line);
  border-radius: var(--r-sm);
  font-size: 15px;
  color: var(--ink);
}
.input-pick { line-height: 44px; }

/* ---------- 分区标题 ---------- */
.sec {
  display: flex;
  align-items: baseline;
  justify-content: space-between;
  padding: 24px 20px 12px;
}
.sec-title {
  font-size: 19px;
  font-weight: 600;
  color: var(--ink);
  letter-spacing: 0.5px;
  white-space: nowrap;   /* 标题类一律单行，折行=排版事故 */
}
.sec-more { font-size: 12px; color: var(--ink3); letter-spacing: 0.2px; }

/* ---------- 底部安全留白 ---------- */
.safe { height: 28px; }

/* ---------- 背景拼贴层（开屏与页面留白处的贴纸肌理） ----------
   每个页面 .page 里放一个 <view class="bg-collage">，内嵌若干
   <image class="bg-stk">，素材用 images/board2 贴纸。
   约束：z-index:-1 压在内容下；透明度 0.06~0.12（远看肌理近看才认出）；
   pointer-events:none 不抢点击。父级 .page 需 position:relative。 */
.bg-collage {
  position: absolute;
  top: 0; left: 0; right: 0; bottom: 0;
  min-height: 100%;
  overflow: hidden;
  pointer-events: none;
  z-index: -1;
}
.bg-stk { position: absolute; }
.bg-faint  { opacity: 0.06; }
.bg-soft   { opacity: 0.09; }
.bg-visible { opacity: 0.12; }

/* ==========================================================================
   Vant Weapp 白色灵动主题覆盖
   --------------------------------------------------------------------------
   vant 组件开启了 addGlobalClass:true，app.wxss 的选择器可以穿透进
   组件内部。用 page 后代选择器抬高优先级，压过组件自带样式。
   ========================================================================== */
page .van-tabs__wrap { background: transparent; }
page .van-tab {
  color: var(--ink3);
  font-size: 14px;
  letter-spacing: 0.5px;
}
page .van-tab--active {
  color: var(--ink);
  font-weight: 600;
}
page .van-tabs__line {
  background: var(--accent);
  border-radius: 1px;
}
page .van-toast {
  background: var(--ink);
  border-radius: 12px;
  padding: 14px 16px;
}
page .van-toast__text {
  color: var(--card);
  font-size: 14px;
  letter-spacing: 0.5px;
}
page .van-toast__icon { color: var(--card); }
page .van-toast__loading { color: var(--card); }
page .van-dialog {
  background: var(--card);
  border-radius: 16px;
  overflow: hidden;
}
page .van-dialog__header {
  color: var(--ink);
  font-size: 16px;
  font-weight: 600;
  padding-top: 22px;
}
page .van-dialog__message {
  color: var(--ink2);
  font-size: 14px;
  line-height: 1.7;
}
page .van-dialog__message-text { color: var(--ink2); }
page .van-dialog__cancel,
page .van-dialog__confirm {
  font-size: 15px;
  letter-spacing: 1px;
}
page .van-dialog__cancel { color: var(--ink2); }
page .van-dialog__confirm { color: var(--accent); font-weight: 500; }
page .van-dialog__footer--round-button .van-dialog__cancel,
page .van-dialog__footer--round-button .van-dialog__confirm { border-radius: var(--r-pill); }
page .van-hairline--top-bottom::after,
page .van-hairline--top::after { border-color: var(--line); }
page .van-overlay { background: rgba(28, 28, 30, 0.4); }
