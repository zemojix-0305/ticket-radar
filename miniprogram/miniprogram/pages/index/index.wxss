.wrap{padding-bottom:20px;}
.head{display:flex;align-items:center;justify-content:space-between;padding:14px 16px 2px;}
.title{font-size:20px;font-weight:600;color:#1F2329;}
.mini{font-size:13px;color:#185FA5;background:#E6F1FB;padding:4px 12px;border-radius:14px;line-height:1.6;}
.head-acts{display:flex;gap:8px;}
.at{padding:0 16px 6px;}
.left{flex:1;min-width:0;}
.name{display:block;font-size:15px;color:#1F2329;font-weight:500;}
.sub{display:block;margin-top:2px;}
.item{padding:8px 0 8px 10px;border-left:2px solid #E5E6EB;margin:8px 0 0;}
.i-label{display:block;font-size:14px;color:#1F2329;}
.err{margin-top:8px;padding:8px 10px;background:#FEE4E2;border-radius:6px;}
.bad-text{font-size:13px;color:#B42318;display:block;}
.empty{padding:28px 16px;text-align:center;}
.mask{position:fixed;inset:0;background:rgba(0,0,0,.4);z-index:9;}
.sheet{position:fixed;left:0;right:0;bottom:0;background:#fff;border-radius:16px 16px 0 0;padding:18px 16px 24px;z-index:10;}
.sheet-title{font-size:16px;font-weight:600;margin-bottom:14px;color:#1F2329;}
.field{display:flex;align-items:center;margin-bottom:10px;}
.lbl{width:64px;font-size:14px;color:#6B7280;flex-shrink:0;}
.inp,.pick{flex:1;border:1px solid #E5E6EB;border-radius:8px;padding:9px 12px;font-size:14px;background:#F9FAFB;color:#1F2329;}
.hint{display:block;font-size:12px;color:#9CA3AF;margin:-6px 0 10px 64px;}
.acts{display:flex;gap:10px;margin-top:18px;}
.acts button{flex:1;border-radius:8px;font-size:15px;}
.ghost{background:#F5F6F7;color:#6B7280;}
.primary{background:#185FA5;color:#fff;}
