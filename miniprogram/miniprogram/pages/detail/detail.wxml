<!-- 演出详情：纸感票根手账。大海报 + 票根场次 + 盯这场 -->
<view class="page">

  <!-- 背景拼贴层：仅保留 bg-stk 拼贴 -->
  <view class="bg-collage">
    <image class="bg-stk bg-faint bg-love"  src="/images/board2/origami20.png" mode="aspectFit" />
    <image class="bg-stk bg-faint bg-swirl" src="/images/board2/cartoon12.png" mode="aspectFit" />
    <image class="bg-stk bg-visible bg-star1" src="/images/board2/origami1.png" mode="aspectFit" />
  </view>

  <!-- 加载中 -->
  <view class="card sk-card" wx:if="{{loading}}">
    <view class="sk sk-poster"></view>
    <view class="sk sk-t" style="width:70%"></view>
    <view class="sk" style="width:45%;height:12px;margin-top:12px"></view>
  </view>

  <!-- 失败 -->
  <view class="card empty" wx:if="{{!loading && error}}">
    <view class="empty-mark"></view>
    <view class="empty-title">详情没拿到</view>
    <view class="empty-sub">{{error}}</view>
    <view class="empty-btn press" bindtap="reload" hover-class="press-hover">重试</view>
  </view>

  <block wx:if="{{!loading && !error}}">
    <!-- 大海报：没图（如 12306 车次）就整块不渲染，不留空占位 -->
    <view class="hero" wx:if="{{poster}}">
      <image class="hero-poster" src="{{poster}}" mode="aspectFill" />
      <image class="hero-stk stk-a" src="/images/board2/origami21.png" mode="aspectFit" />
    </view>

    <!-- 标题信息区：虚线分栏 -->
    <view class="card info">
      <view class="info-name">{{name}}</view>
      <view class="info-meta">
        <text class="tag tag-brand">{{label}}</text>
        <text class="tag tag-none" wx:if="{{city}}">{{city}}</text>
      </view>
      <view class="info-row" wx:if="{{venue}}">场馆 · {{venue}}</view>
      <view class="info-row" wx:if="{{date}}">时间 · {{date}}</view>
      <view class="info-row" wx:if="{{saleNote}}">{{saleNote}}</view>
      <view class="info-row info-price" wx:if="{{price}}">{{price}}</view>
    </view>

    <!-- 降级提示：详情接口被风控拦住，只展示能拿到的部分 -->
    <view class="card empty" wx:if="{{degraded}}">
      <view class="empty-title">{{sessions.length ? '票档明细暂时拿不到' : '场次和票档暂时拿不到'}}</view>
      <view class="empty-sub">{{degradeMsg}}</view>
      <view class="empty-btn press" bindtap="reload" hover-class="press-hover">再试一次</view>
    </view>

    <!-- 场次 × 票档：多选网格（对齐竞品「演出详情」交互） -->
    <block wx:if="{{sessions.length}}">
      <view class="sec">
        <view class="sec-title title-strong">选场次和票价</view>
        <view class="sec-sub">勾要盯的场次与价位；价格一个都不勾＝整场任何价位回流都提醒</view>
      </view>
      <view class="card picker">
        <view class="sess2" wx:for="{{sessions}}" wx:key="name" wx:for-item="s" wx:for-index="si">
          <view class="sess2-head" data-si="{{si}}" bindtap="toggleSession" hover-class="press-hover">
            <view class="sess2-box {{s.selected ? 'on' : ''}}">{{s.selected ? '✓' : ''}}</view>
            <view class="sess2-name">{{s.name}}</view>
          </view>
          <view class="sess2-tags" wx:if="{{s.tiers.length}}">
            <view
              class="ptier {{t.selected ? 'on' : ''}} {{t.available ? '' : 'off'}}"
              wx:for="{{s.tiers}}"
              wx:key="name"
              wx:for-item="t"
              data-si="{{si}}"
              data-name="{{t.name}}"
              bindtap="toggleTier"
              hover-class="{{t.available ? 'press-hover' : 'none-hover'}}"
            >{{t.name}}</view>
          </view>
          <view class="sess2-empty" wx:else>这个平台没给票档明细，这场按整场盯</view>
        </view>
      </view>
    </block>
    <view class="sec-more" wx:if="{{!degraded && !sessions.length}}">{{noTiers ? '这个平台的票档明细要登录后可见——先「盯整场」，有动静就提醒你' : '这个演出暂时没拿到场次——先「盯整场」，有动静会告诉你'}}</view>
  </block>

  <!-- 底部操作栏：降级时也能盯整场——点进来只有标题又没有出路，最劝退 -->
  <view class="actionbar" wx:if="{{!loading && !error}}">
    <view class="action-btn press {{adding ? 'busy' : ''}}" bindtap="addMonitor" hover-class="press-hover">
      {{adding ? '安排上了…' : subText}}
    </view>
  </view>

  <view class="safe"></view>
</view>

<van-toast id="van-toast" />
<van-dialog id="van-dialog" />
