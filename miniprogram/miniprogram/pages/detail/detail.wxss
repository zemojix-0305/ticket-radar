.page { padding-bottom: 96px; position: relative; }

/* ---------- 背景拼贴定位（和 shows 页同款语法）---------- */
.bg-love   { width: 120px; height: 120px; top: 520px; right: -24px; transform: rotate(14deg); }
.bg-swirl  { width: 96px;  height: 96px;  top: 900px; left: -20px; }
.bg-star1  { width: 30px;  height: 30px;  top: 240px; left: 8%; transform: rotate(-12deg); }

/* ---------- 大海报 ---------- */
.hero {
  position: relative;
  margin: 12px 16px 0;
  padding: 10px 10px 12px;
}
.hero-poster {
  display: block;
  width: 100%;
  height: 200px;
  border-radius: var(--r);
  border: 1px solid var(--line2);
  background: var(--card2);
}
.hero-poster-blank {
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 13px;
  color: var(--ink3);
  letter-spacing: 1px;
}
.hero-stk { position: absolute; width: 44rpx; height: 44rpx; }
.hero-stk.stk-a { right: 18rpx; bottom: 26rpx; transform: rotate(12deg); opacity: 0.95; }

/* ---------- 标题信息卡（虚线分栏）---------- */
.info { padding: 16px 18px; }
.info-name {
  font-size: 18px;
  font-weight: 600;
  color: var(--ink);
  line-height: 1.45;
  letter-spacing: 0.3px;
}
.info-meta {
  display: flex;
  flex-wrap: wrap;
  gap: 6px;
  margin-top: 10px;
}
.info-row {
  margin-top: 8px;
  padding-top: 8px;
  border-top: 1px dashed var(--line);
  font-size: 13px;
  color: var(--ink2);
  line-height: 1.6;
}
.info-price {
  font-size: 16px;
  font-weight: 600;
  color: var(--accent);
}

/* ---------- 分区标题 ---------- */
.sec {
  display: flex;
  align-items: baseline;
  justify-content: space-between;
  padding: 18px 20px 10px;
}
.sec-title { font-size: 17px; font-weight: 600; color: var(--ink); letter-spacing: 0.5px; white-space: nowrap; }

/* ---------- 票根卡 ---------- */
.ticket { padding: 4px 0; }
.sess { padding: 14px 16px; }
.sess-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 10px;
  padding-bottom: 10px;
  border-bottom: 1px solid var(--line);
}
.sess-name {
  font-size: 15px;
  font-weight: 600;
  color: var(--ink);
  letter-spacing: 0.3px;
}

/* ---------- 票档行 ---------- */
.tier {
  display: flex;
  align-items: center;
  gap: 10px;
  padding: 10px 2px;
}
.tier + .tier { border-top: 1px dashed var(--line); }
.tier-dot {
  width: 8px;
  height: 8px;
  border-radius: 50%;
  background: var(--bar-idle);
  flex-shrink: 0;
}
.tier-dot.on { background: var(--accent); }
.tier-name {
  flex: 1;
  min-width: 0;
  font-size: 14px;
  color: var(--ink);
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}
.tier-price {
  font-size: 13px;
  font-weight: 600;
  color: var(--ink);
  white-space: nowrap;
}
.sess-empty {
  padding: 12px 2px 4px;
  font-size: 12px;
  color: var(--ink3);
  line-height: 1.7;
}

/* ---------- 底部操作栏（accent 大按钮，2px 直角）---------- */
.actionbar {
  position: fixed;
  left: 0; right: 0; bottom: 0;
  padding: 12px 16px calc(12px + env(safe-area-inset-bottom));
  background: var(--card);
  border-top: 1px solid var(--line);
  display: flex;
}
.action-btn {
  flex: 1;
  height: 46px;
  border-radius: var(--r);
  background: var(--accent);
  color: var(--on-brand);
  font-size: 15px;
  font-weight: 600;
  letter-spacing: 1px;
  display: flex;
  align-items: center;
  justify-content: center;
}
.action-btn.busy { background: var(--accent-deep); }

/* ---------- 骨架/空态 ---------- */
.sk-poster {
  width: 100%;
  height: 200px;
  border-radius: var(--r);
  margin-bottom: 16px;
}
.empty-btn {
  margin: 14px auto 0;
  padding: 8px 22px;
  border-radius: var(--r-pill);
  background: var(--accent-weak);
  color: var(--accent);
  font-size: 13px;
  width: fit-content;
}
