.page { padding-bottom: 96px; position: relative; }

/* ---------- 背景拼贴定位（和 shows 页同款语法）---------- */
.bg-love   { width: 120px; height: 120px; top: 520px; right: -24px; transform: rotate(14deg); }
.bg-swirl  { width: 96px;  height: 96px;  top: 900px; left: -20px; }
.bg-star1  { width: 30px;  height: 30px;  top: 240px; left: 8%; transform: rotate(-12deg); }

/* ---------- 大海报 ---------- */
.hero {
  position: relative;
  margin: 12px 16px 0;
  padding: 10px 10px 12px;
}
.hero-poster {
  display: block;
  width: 100%;
  height: 200px;
  border-radius: var(--r);
  border: 1px solid var(--line2);
  background: var(--card2);
}
.hero-poster-blank {
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 13px;
  color: var(--ink3);
  letter-spacing: 1px;
}
.hero-stk { position: absolute; width: 44rpx; height: 44rpx; }
.hero-stk.stk-a { right: 18rpx; bottom: 26rpx; transform: rotate(12deg); opacity: 0.95; }

/* ---------- 标题信息卡（虚线分栏）---------- */
.info { padding: 16px 18px; }
.info-name {
  font-size: 18px;
  font-weight: 600;
  color: var(--ink);
  line-height: 1.45;
  letter-spacing: 0.3px;
}
.info-meta {
  display: flex;
  flex-wrap: wrap;
  gap: 6px;
  margin-top: 10px;
}
.info-row {
  margin-top: 8px;
  padding-top: 8px;
  border-top: 1px dashed var(--line);
  font-size: 13px;
  color: var(--ink2);
  line-height: 1.6;
}
.info-price {
  font-size: 16px;
  font-weight: 600;
  color: var(--accent);
}

/* ---------- 开售倒计时 ---------- */
.info-countdown {
  display: flex;
  align-items: center;
  gap: 6px;
  font-size: 13px;
  color: var(--ink2);
}
.countdown-icon { font-size: 14px; }
.countdown-label { color: var(--ink3); }
.countdown-num {
  margin-left: auto;
  font-size: 15px;
  font-weight: 700;
  color: var(--accent);
  font-variant-numeric: tabular-nums;
}

/* ---------- 分区标题 ---------- */
.sec {
  display: flex;
  align-items: baseline;
  justify-content: space-between;
  padding: 18px 20px 10px;
}
.sec-title { font-size: 17px; font-weight: 600; color: var(--ink); letter-spacing: 0.5px; white-space: nowrap; }

/* ---------- 票根卡 ---------- */
.ticket { padding: 4px 0; }
.sess { padding: 14px 16px; }
.sess-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 10px;
  padding-bottom: 10px;
  border-bottom: 1px solid var(--line);
}
.sess-name {
  font-size: 15px;
  font-weight: 600;
  color: var(--ink);
  letter-spacing: 0.3px;
}

/* ---------- 票档行 ---------- */
.tier {
  display: flex;
  align-items: center;
  gap: 10px;
  padding: 10px 2px;
}
.tier + .tier { border-top: 1px dashed var(--line); }
.tier-dot {
  width: 8px;
  height: 8px;
  border-radius: 50%;
  background: var(--bar-idle);
  flex-shrink: 0;
}
.tier-dot.on { background: var(--accent); }
.tier-name {
  flex: 1;
  min-width: 0;
  font-size: 14px;
  color: var(--ink);
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}
.tier-price {
  font-size: 13px;
  font-weight: 600;
  color: var(--ink);
  white-space: nowrap;
}
.sess-empty {
  padding: 12px 2px 4px;
  font-size: 12px;
  color: var(--ink3);
  line-height: 1.7;
}

/* ---------- 底部操作栏（accent 大按钮，2px 直角）---------- */
.actionbar {
  position: fixed;
  left: 0; right: 0; bottom: 0;
  padding: 12px 16px calc(12px + env(safe-area-inset-bottom));
  background: var(--card);
  border-top: 1px solid var(--line);
  display: flex;
}
.action-btn {
  flex: 1;
  height: 46px;
  border-radius: var(--r);
  background: var(--accent);
  color: var(--on-brand);
  font-size: 15px;
  font-weight: 600;
  letter-spacing: 1px;
  display: flex;
  align-items: center;
  justify-content: center;
}
.action-btn.busy { background: var(--accent-deep); }

/* ---------- 骨架/空态 ---------- */
.sk-poster {
  width: 100%;
  height: 200px;
  border-radius: var(--r);
  margin-bottom: 16px;
}
.empty-btn {
  margin: 14px auto 0;
  padding: 8px 22px;
  border-radius: var(--r-pill);
  background: var(--accent-weak);
  color: var(--accent);
  font-size: 13px;
  width: fit-content;
}

/* ---------- 只盯某个价位 ---------- */
.tierpick { padding: 4px 18px 12px; }
.tierpick-title { font-size: 13px; color: var(--ink3); margin-bottom: 10px; }
.tierpick-chips { display: flex; flex-wrap: wrap; gap: 10px; }
.tier-chip {
  padding: 8px 14px;
  border-radius: var(--r-pill);
  background: var(--card2);
  font-size: 13px;
  color: var(--ink2);
}
.tier-chip.on {
  background: var(--accent-weak);
  color: var(--accent);
  font-weight: 600;
}
.tierpick-hint { font-size: 12px; color: var(--ink3); margin-top: 10px; }

/* ---------- 场次 × 票档 多选网格（第35轮，对齐竞品「演出详情」） ---------- */
.sec-sub {
  font-size: 12px;
  color: var(--ink3, #8A8378);
  margin-top: 4px;
  line-height: 1.5;
}
.picker {
  padding: 4px 14px 8px;
}
.sess2 {
  padding: 10px 0 4px;
  border-bottom: 1px dashed var(--line, rgba(0, 0, 0, 0.08));
}
.sess2:last-child { border-bottom: none; }
.sess2-head {
  display: flex;
  align-items: center;
  gap: 9px;
  padding: 2px 0 8px;
}
.sess2-box {
  width: 19px;
  height: 19px;
  flex-shrink: 0;
  border-radius: 5px;
  border: 1.5px solid #B9AED8;
  background: #fff;
  color: #fff;
  font-size: 13px;
  line-height: 18px;
  text-align: center;
}
.sess2-box.on {
  background: var(--brand, #6B4FA8);
  border-color: var(--brand, #6B4FA8);
}
.sess2-name {
  flex: 1;
  min-width: 0;
  font-size: 14px;
  font-weight: 500;
  color: var(--ink, #2A2620);
}
.sess2-tags {
  display: flex;
  flex-wrap: wrap;
  gap: 8px;
  padding: 0 0 10px 28px;
}
.ptier {
  min-width: 58px;
  padding: 7px 11px;
  border: 1px solid #CFC6E4;
  border-radius: 8px;
  background: #fff;
  color: #4A3F63;
  font-size: 13px;
  text-align: center;
}
.ptier.on {
  border-color: var(--brand, #6B4FA8);
  color: var(--brand, #6B4FA8);
  background: var(--brand-weak, rgba(107, 79, 168, 0.08));
  font-weight: 500;
}
/* 不可用的档位：灰按钮、按不下去 */
.ptier.off {
  color: #B8B2C4;
  border-color: #E6E2EE;
  background: #F6F5F9;
}
.sess2-empty {
  font-size: 12px;
  color: var(--ink3, #8A8378);
  padding: 0 0 12px 28px;
}
.none-hover { opacity: 1; }

/* 票档价格标签（只展示不勾选）：与可勾选的 .ptier 视觉上要能区分——
   这里是纯文字标签、无边框可点感，避免用户以为能点。 */
.tierline {
  display: flex;
  flex-wrap: wrap;
  gap: 6px;
  margin-top: 8px;
}
.tierline-tag {
  padding: 3px 8px;
  border-radius: 6px;
  background: #F4F1FA;
  color: #6B6180;
  font-size: 12px;
}

/* 巡演分站行：左名字、右「进入」，整行可点 */
.stop {
  display: flex;
  align-items: center;
  gap: 10px;
  padding: 11px 4px;
  border-bottom: 1px solid #F0EDF6;
}
.stop:last-child {
  border-bottom: none;
  padding-bottom: 2px;
}
.stop-name {
  flex: 1;
  font-size: 14px;
  color: var(--ink, #2E2A3A);
}
.stop-when {
  font-size: 12px;
  color: var(--ink3, #8A8378);
}
.stop-go {
  font-size: 12px;
  color: var(--brand, #6B4FA8);
  padding-left: 6px;
}
