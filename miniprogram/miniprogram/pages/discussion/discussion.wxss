/* 讨论区：问题反馈白板风格 */
.page { padding-bottom: 8px; position: relative; }

/* ---------- 背景拼贴层定位（素材见 wxml，样式在 app.wxss）---------- */
.bg-love2  { width: 100px; height: 100px; top: 400px; left: -20px; transform: rotate(-12deg); }
.bg-leaf   { width: 90px;  height: 90px;  top: 760px; right: -16px; transform: rotate(10deg); }
.bg-star5  { width: 26px;  height: 26px;  top: 160px; right: 16%; transform: rotate(-10deg); }
.bg-star6  { width: 22px;  height: 22px;  top: 1100px; left: 10%; transform: rotate(14deg); }

/* ---------- 顶部标题区 ---------- */
.board-header {
  padding: 28px 18px 16px;
  border-bottom: 1px solid var(--line);
  display: flex;
  align-items: center;
  justify-content: space-between;
  position: relative;   /* 容纳胶带 */
}
.board-head-l { flex: 1; min-width: 0; }
.board-title {
  font-size: 26px;
  font-weight: 600;
  color: var(--t1);
  letter-spacing: 0.5px;
  white-space: nowrap;   /* 标题类一律单行 */
}
/* 和监控页/演出页同款的手账贴纸点缀 */
.board-stks { display: flex; align-items: center; gap: 2px; }
.board-stk {
  width: 30px;
  height: 30px;
  margin-top: 2px;
  transform: rotate(10deg);
  opacity: 0.95;
}
.board-line {
  width: 40px;
  height: 2px;
  background: var(--accent);
  margin-top: 10px;
}

/* ---------- 分类筛选：van-tabs 当切换条，纸感主题在 app.wxss 覆盖 ---------- */

/* ---------- 搜索栏 ---------- */
.searchbar {
  display: flex;
  align-items: center;
  gap: 8px;
  padding: 10px 12px;
}
.search-box {
  flex: 1;
  min-width: 0;
  display: flex;
  align-items: center;
  height: 40px;
  padding: 0 14px;
  background: var(--card);
  border-radius: 20px;
  border: 1px solid var(--line);
}
.search-ico {
  width: 13px;
  height: 13px;
  border: 2px solid var(--t3);
  border-radius: 50%;
  flex-shrink: 0;
  position: relative;
}
.search-ico::after {
  content: '';
  position: absolute;
  right: -5px;
  bottom: -3px;
  width: 6px;
  height: 2px;
  background: var(--t3);
  transform: rotate(45deg);
}
.search-inp {
  flex: 1;
  min-width: 0;
  margin-left: 9px;
  font-size: 15px;
  color: var(--t1);
}
.search-ph { color: var(--t3); font-size: 14px; }
.search-clear { font-size: 13px; color: var(--t3); padding-left: 8px; }

/* ---------- 帖子板 ---------- */
.post-board {
  padding: 6px 0 14px;
}
/* 便签墙：纸片 + 夹子。每张便签随机小角度旋转，像随手钉上去的 */
.note-wrap {
  position: relative;
  margin: 14px 14px 4px;
  padding: 26px 18px 20px;
  min-height: 120px;
}
.note-bg {
  position: absolute;
  left: 0;
  top: 0;
  width: 100%;
  height: 100%;
  z-index: 0;
}
.note-clip {
  position: absolute;
  top: -14px;
  left: 50%;
  transform: translateX(-50%);
  width: 44px;
  height: 44px;
  z-index: 2;
}
.note-body {
  position: relative;
  z-index: 1;
}
.note-head {
  display: flex;
  align-items: center;
  gap: 8px;
  margin-bottom: 8px;
}
.note-avatar {
  width: 30px;
  height: 30px;
  border-radius: 50%;
  background: rgba(255, 255, 255, 0.6);
  flex-shrink: 0;
}
.post-meta {
  flex: 1;
  min-width: 0;
  display: flex;
  flex-direction: column;
}
.note-name {
  font-size: 13px;
  font-weight: 500;
  color: #3A4A45;
}
.note-time {
  font-size: 11px;
  color: #7A8B84;
}
.note-text {
  font-size: 14px;
  color: #2E3A36;
  line-height: 1.7;
  word-break: break-word;
}
/* 标签贴纸：白底虚线框，像贴在便签上的小标签 */
.post-tags {
  display: flex;
  flex-wrap: wrap;
  gap: 6px;
  margin-top: 10px;
}
.post-tag {
  font-size: 11px;
  color: #4A6A5F;
  background: rgba(255, 255, 255, 0.65);
  border: 1px dashed #9FB8AE;
  padding: 2px 8px;
  border-radius: 10px;
}
.post-type-tag {
  font-size: 11px;
  padding: 2px 8px;
  border-radius: 10px;
  background: var(--brand-weak);
  color: var(--brand);
}

/* ---------- 加载更多 ---------- */
.load-more {
  text-align: center;
  padding: 16px;
  font-size: 13px;
}

/* ---------- 底部说明 ---------- */
.board-footer {
  padding: 16px;
  text-align: center;
  border-top: 1px solid var(--line);
}
.stitch-text {
  font-size: 11px;
  color: var(--t3);
  
}

/* ---------- 发帖悬浮按钮 ---------- */
.fab {
  position: fixed;
  right: 16px;
  bottom: calc(24px + env(safe-area-inset-bottom));
  width: 52px;
  height: 52px;
  border-radius: 26px;
  background: var(--accent);
  display: flex;
  align-items: center;
  justify-content: center;
  z-index: 50;
  box-shadow: 0 4px 12px rgba(42, 38, 32, 0.18);
}
.fab-icon {
  font-size: 22px;
  color: var(--on-brand);
}

/* ---------- 弹层（纸面样式来自 app.wxss 的 .sheet / .field / .input / .field-lbl）---------- */
.post-area {
  height: 120px;
  padding: 12px 14px;
  line-height: 1.6;
  resize: none;
}
.type-selector {
  display: flex;
  gap: 10px;
}
.type-opt {
  flex: 1;
  text-align: center;
  padding: 10px 0;
  background: var(--bg);
  border-radius: 12px;
  border: 1px solid var(--line);
  font-size: 13px;
  color: var(--t2);
}
.type-opt.active {
  background: var(--accent-weak);
  border-color: var(--accent);
  color: var(--accent);
  font-weight: 500;
}
.acts {
  display: flex;
  gap: 10px;
  margin-top: 20px;
}
.acts .btn {
  flex: 1;
}

/* ---------- 失败 / 空 ---------- */
.fail {
  padding: 16px;
  margin: 12px;
  background: var(--bad-weak);
  border-radius: 12px;
  border: 1px dashed var(--bad);
}
.fail-t {
  font-size: 15px;
  color: var(--bad);
  margin-bottom: 6px;
}
.fail-b {
  font-size: 13px;
  color: var(--t2);
  line-height: 1.6;
}
.empty {
  padding: 44px 32px;
  text-align: center;
}
.empty-mark {
  width: 64px;
  height: 64px;
  margin: 0 auto 16px;
  background: var(--brand-weak);
  border-radius: 20px;
  background-image: url("data:image/png;base64,");
  background-repeat: no-repeat;
  background-position: center;
  background-size: 80%;
}
.empty-title {
  font-size: 17px;
  font-weight: 600;
  color: var(--t1);
  margin-bottom: 6px;
}
.empty-sub {
  font-size: 13px;
  color: var(--t3);
  margin-bottom: 12px;
}
.stitch-hint {
  display: inline-block;
  padding: 6px 14px;
  border: 1.5px dashed var(--brand-line);
  border-radius: 20px;
  font-size: 12px;
  color: var(--t3);
  
}

/* ---------- 发帖：素材选择 + 实时预览 ---------- */
.stk-scroll {
  white-space: nowrap;
  margin-top: 10px;
}
.stk-opt {
  display: inline-flex;
  flex-direction: column;
  align-items: center;
  margin-right: 10px;
  width: 64px;
}
.stk-thumb {
  width: 56px;
  height: 56px;
  border-radius: 10px;
  border: 2px solid transparent;
  background: var(--none-weak);
}
.stk-opt.active .stk-thumb {
  border-color: var(--brand);
  box-shadow: 0 0 0 3px var(--brand-weak);
}
.stk-lbl {
  font-size: 11px;
  color: var(--t3);
  margin-top: 4px;
}
.stk-opt.active .stk-lbl { color: var(--brand); }

.stk-preview-wrap {
  position: relative;
  margin-top: 12px;
  height: 190px;
  border-radius: 12px;
  overflow: hidden;
  background: var(--none-weak);
}
.stk-preview-bg {
  width: 100%;
  height: 100%;
}
.stk-preview-text {
  position: absolute;
  left: 24px;
  right: 24px;
  top: 52px;
  
  font-size: 15px;
  line-height: 1.7;
  color: #3A3A3E;
  word-break: break-word;
  max-height: 110px;
  overflow: hidden;
}

/* ---------- 放大查看 ---------- */
.zoom-mask {
  position: fixed;
  left: 0; top: 0; right: 0; bottom: 0;
  background: rgba(26, 26, 26, 0.55);
  z-index: 200;
  display: flex;
  align-items: center;
  justify-content: center;
  animation: zoom-fade 0.2s ease-out;
}
@keyframes zoom-fade {
  from { opacity: 0; }
  to { opacity: 1; }
}
.zoom-card {
  position: relative;
  width: 82vw;
  animation: zoom-pop 0.25s cubic-bezier(0.34, 1.56, 0.64, 1);
}
@keyframes zoom-pop {
  from { transform: scale(0.75); opacity: 0; }
  to { transform: scale(1); opacity: 1; }
}
.zoom-close {
  position: absolute;
  top: -44px;
  right: 0;
  width: 34px;
  height: 34px;
  line-height: 32px;
  text-align: center;
  border-radius: 50%;
  background: rgba(255, 255, 255, 0.92);
  color: var(--t1);
  font-size: 22px;
  z-index: 2;
}
.zoom-note-wrap {
  position: relative;
  transform: rotate(0deg);
}
.zoom-note-bg {
  width: 100%;
  display: block;
}
.zoom-note-body {
  position: absolute;
  left: 9%;
  right: 9%;
  top: 10%;
}
.zoom-note-text {
  
  font-size: 17px;
  line-height: 1.8;
  color: #3A3A3E;
  word-break: break-word;
}
.note-text-dark { color: #F4F1E8; }

/* 便签上的「点击放大」提示 */
.note-zoom-hint {
  margin-top: 10px;
  font-size: 11px;
  color: var(--t3);
  opacity: 0.7;
}
