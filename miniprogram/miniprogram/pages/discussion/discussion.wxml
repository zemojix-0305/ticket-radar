<!-- 讨论区：问题反馈白板 + 留言墙 -->
<view class="page">

  <!-- 背景拼贴层：贴纸素材压到 0.07~0.14 透明度，只在留白处透出 -->
  <view class="bg-collage">
    <view class="bg-tint bg-tint-mint bg-tint-b"></view>
    <image class="bg-stk bg-faint bg-love2"   src="/images/board2/collage13.png" mode="aspectFit" />
    <image class="bg-stk bg-faint bg-leaf"    src="/images/board2/collage12.png" mode="aspectFit" />
    <image class="bg-stk bg-visible bg-star5" src="/images/board2/origami1.png"  mode="aspectFit" />
    <image class="bg-stk bg-visible bg-star6" src="/images/board2/origami24.png" mode="aspectFit" />
  </view>

  <!-- 顶部标题区 -->
  <view class="board-header">
    <view class="tape"></view>
    <view class="board-head-l">
      <view class="board-title title-strong">问题反馈</view>
      <view class="board-subtitle">FEEDBACK <text class="spark">✦</text></view>
      <view class="board-line"></view>
    </view>
    <view class="bow"><view class="bow-k"></view></view>
    <view class="board-stks">
      <image class="board-stk stk-a" src="/images/board2/origami13.png" mode="aspectFit" />
      <image class="board-stk stk-b" src="/images/board2/cartoon1.png" mode="aspectFit" />
    </view>
  </view>

  <!-- 分类筛选 -->
  <view class="board-tabs">
    <view class="tab {{currentTab===0 ? 'active' : ''}}" data-tab="0" bindtap="onTab" hover-class="press-hover">全部</view>
    <view class="tab {{currentTab===1 ? 'active' : ''}}" data-tab="1" bindtap="onTab" hover-class="press-hover">问题反馈</view>
    <view class="tab {{currentTab===2 ? 'active' : ''}}" data-tab="2" bindtap="onTab" hover-class="press-hover">建议留言</view>
    <view class="tab {{currentTab===3 ? 'active' : ''}}" data-tab="3" bindtap="onTab" hover-class="press-hover">求助求助</view>
  </view>

  <!-- 搜索栏 -->
  <view class="searchbar">
    <view class="search-box">
      <text class="search-ico"></text>
      <input
        class="search-inp"
        placeholder="搜帖子 / 场次 / 关键词"
        placeholder-class="search-ph"
        value="{{kw}}"
        confirm-type="search"
        bindinput="onInput"
        bindconfirm="doSearch"
      />
      <text class="search-clear press" wx:if="{{kw}}" bindtap="clearSearch" hover-class="press-hover">清除</text>
    </view>
  </view>

  <!-- 失败 -->
  <view class="card fail" wx:if="{{fail}}">
    <view class="fail-t">读不到帖子</view>
    <view class="fail-b">{{fail}}</view>
  </view>

  <!-- 空状态 -->
  <view class="card empty" wx:if="{{!loading && !posts.length && !fail}}">
    <view class="empty-mark"></view>
    <view class="empty-title">还没有反馈</view>
    <view class="empty-sub">第一条你来写。</view>
    <view class="stitch-hint">点击右下角 ✍ 发布</view>
  </view>

  <!-- 帖子流 - 留言墙：手账便签 + 小夹子 -->
  <view class="post-board" wx:for="{{posts}}" wx:key="_id">
    <view class="note-wrap" style="transform: rotate({{item.rot}}deg);">
      <!-- 便签纸背景（8 种轮换，含自带的小夹子） -->
      <image class="note-bg" src="/images/board/note{{item.noteIdx}}.png" mode="widthFix" />
      <!-- 顶部装饰小夹子（13 种轮换），盖在便签上沿 -->
      <image class="note-clip" src="/images/board/clip{{item.clipIdx}}.png" mode="aspectFit" />
      <view class="note-body">
        <view class="note-head">
          <image class="note-avatar" src="{{item.avatar || '/images/avatar_fox.png'}}" mode="aspectFill" />
          <view class="post-meta">
            <text class="note-name">{{item.nickname}}</text>
            <text class="note-time">{{item.rel}}</text>
          </view>
          <view class="post-type-tag" wx:if="{{item.type}}">{{item.type}}</view>
        </view>
        <view class="note-text">{{item.content}}</view>
        <view class="post-tags" wx:if="{{item.tags && item.tags.length}}">
          <text class="post-tag" wx:for="{{item.tags}}" wx:for-item="tag" wx:key="*this">#{{tag}}</text>
        </view>
      </view>
    </view>
  </view>

  <!-- 加载更多 -->
  <view class="load-more" wx:if="{{posts.length && hasMore}}" bindtap="loadMore" hover-class="press-hover">
    <text class="t3">{{loading ? '加载中…' : '加载更多'}}</text>
  </view>
  <view class="load-more" wx:if="{{posts.length && !hasMore}}">
    <text class="t3">没有更多了</text>
  </view>

  <!-- 底部说明 -->
  <view class="board-footer">
    <text class="t3 stitch-text">数据来自社区 · 每五分钟刷新一次</text>
  </view>

  <!-- 发帖悬浮按钮 -->
  <view class="fab press" bindtap="openPost" hover-class="press-hover">
    <text class="fab-icon">✍</text>
  </view>

</view>

<!-- 发帖弹窗 -->
<view class="mask" wx:if="{{showPost}}" bindtap="closePost"></view>
<view class="sheet" wx:if="{{showPost}}">
  <view class="sheet-grab"></view>
  <view class="sheet-title">发布反馈</view>
  <view class="sheet-sub">友善交流，禁止黄牛广告、转账引流。违者删帖。</view>

  <view class="field">
    <view class="field-lbl">内容（500 字内）</view>
    <textarea
      class="input post-area"
      placeholder="例如：孙燕姿广州二开大概什么时候？"
      maxlength="500"
      value="{{postContent}}"
      bindinput="onPostInput"
    />
  </view>

  <view class="field">
    <view class="field-lbl">挑一张纸写</view>
    <!-- 素材选择：横向滚动一排缩略图 -->
    <scroll-view class="stk-scroll" scroll-x enable-flex>
      <view class="stk-opt {{postSticker===s.key?'active':''}}"
            wx:for="{{stickers}}" wx:for-item="s" wx:key="key"
            data-key="{{s.key}}" bindtap="onPickSticker" hover-class="press-hover">
        <image class="stk-thumb" src="{{s.bg}}" mode="aspectFill" />
        <text class="stk-lbl">{{s.label}}</text>
      </view>
    </scroll-view>
    <!-- 实时预览：写的字直接落在选的素材上 -->
    <view class="stk-preview-wrap">
      <image class="stk-preview-bg" src="{{previewBg}}" mode="aspectFill" />
      <view class="stk-preview-text">{{postContent || '你写的字会出现在这里'}}</view>
    </view>
  </view>

  <view class="field">
    <view class="field-lbl">类型</view>
    <view class="type-selector">
      <view class="type-opt {{postType===0?'active':''}}" data-type="0" bindtap="onType">问题反馈</view>
      <view class="type-opt {{postType===1?'active':''}}" data-type="1" bindtap="onType">建议留言</view>
      <view class="type-opt {{postType===2?'active':''}}" data-type="2" bindtap="onType">求助求助</view>
    </view>
  </view>

  <view class="field">
    <view class="field-lbl">标签（最多 3 个，空格分隔）</view>
    <input class="input" placeholder="孙燕姿 广州 二开" value="{{postTags}}" bindinput="onTagInput" />
  </view>

  <view class="acts">
    <button class="btn btn-ghost press" bindtap="closePost" hover-class="press-hover">取消</button>
    <button class="btn btn-primary press" bindtap="submitPost" hover-class="press-hover">发布</button>
  </view>
</view>

<!-- 放大查看某张便签 -->
<view class="zoom-mask" wx:if="{{zoomIdx >= 0}}" bindtap="closeZoom">
  <view class="zoom-card" catchtap="">
    <view class="zoom-close press" bindtap="closeZoom" hover-class="press-hover">×</view>
    <view class="zoom-note-wrap" wx:if="{{posts[zoomIdx]}}">
      <image class="zoom-note-bg" src="{{posts[zoomIdx].bg}}" mode="widthFix" />
      <image class="note-clip" wx:if="{{!posts[zoomIdx].onSticker}}" src="/images/board/clip{{posts[zoomIdx].clipIdx}}.png" mode="aspectFit" />
      <view class="zoom-note-body">
        <view class="note-head">
          <image class="note-avatar" src="{{posts[zoomIdx].avatar || '/images/avatar_fox.png'}}" mode="aspectFill" />
          <view class="post-meta">
            <text class="note-name">{{posts[zoomIdx].nickname}}</text>
            <text class="note-time">{{posts[zoomIdx].rel}}</text>
          </view>
          <view class="post-type-tag" wx:if="{{posts[zoomIdx].type}}">{{posts[zoomIdx].type}}</view>
        </view>
        <view class="zoom-note-text {{posts[zoomIdx].dark ? 'note-text-dark' : ''}}">{{posts[zoomIdx].content}}</view>
        <view class="post-tags" wx:if="{{posts[zoomIdx].tags && posts[zoomIdx].tags.length}}">
          <text class="post-tag" wx:for="{{posts[zoomIdx].tags}}" wx:for-item="tag" wx:key="*this">#{{tag}}</text>
        </view>
      </view>
    </view>
  </view>
</view>
