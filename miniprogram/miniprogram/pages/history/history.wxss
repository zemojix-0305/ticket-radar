.page { padding-bottom: 8px; }

/* ---------- 汇总条 ---------- */
.sum {
  display: flex;
  align-items: center;
  margin: 12px;
  padding: 14px 8px;
  background: var(--card);
  border-radius: var(--r);
}
.sum-i { flex: 1; text-align: center; }
.sum-n { color: var(--brand); }
.sum-sep { width: 1px; height: 28px; background: var(--line); }

/* ---------- 单个监控 ---------- */
.h { padding: 16px; }
.h-head { display: flex; align-items: flex-start; justify-content: space-between; gap: 10px; }
.h-l { flex: 1; min-width: 0; }
.h-name { display: block; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
.h-sub { display: block; margin-top: 3px; }

/* 余票柱状图 */
.spark {
  display: flex;
  align-items: flex-end;
  gap: 2px;
  height: 58px;
  margin: 16px 0 4px;
}
.spark-b {
  flex: 1;
  min-width: 2px;
  border-radius: 2px 2px 0 0;
  background: var(--brand-line);
}
/* 零余票的采样用浅灰，一眼能看出「断档」在哪 */
.spark-b.zero { background: var(--bar-idle); }
.spark-ph {
  height: 58px;
  margin: 16px 0 4px;
  display: flex;
  align-items: center;
  justify-content: center;
  background: var(--none-weak);
  border-radius: var(--r-sm);
  font-size: 12px;
  color: var(--t3);
}

/* 指标 */
.h-metrics {
  display: flex;
  margin: 16px 0 4px;
  padding: 12px 0;
  background: var(--none-weak);
  border-radius: var(--r-sm);
}
.m-i { flex: 1; text-align: center; }
.m-n { color: var(--t1); }

/* 结论 */
.verdict {
  margin-top: 14px;
  padding: 11px 13px;
  border-radius: var(--r-sm);
  font-size: 13px;
  line-height: 1.65;
}
.verdict-ok { background: var(--ok-weak); color: var(--ok); }
.verdict-warn { background: var(--warn-weak); color: var(--warn); }
.verdict-none { background: var(--none-weak); color: var(--t2); }

/* ---------- 失败 / 骨架 / 空 ---------- */
.fail { padding: 16px; }
.fail-t { font-size: 15px; color: var(--bad); margin-bottom: 6px; }
.fail-b { font-size: 13px; color: var(--t2); line-height: 1.6; }
.sk-card { padding: 16px; }
.sk-t { height: 16px; }
