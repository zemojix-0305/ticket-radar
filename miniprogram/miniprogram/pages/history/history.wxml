<!-- 历史页：历史曲线 + 推送记录两个 tab -->
<view class="page">

  <!-- 背景拼贴层：贴纸素材压到 0.07~0.14 透明度，只在留白处透出 -->
  <view class="bg-collage">
    <image class="bg-stk bg-faint bg-h-note"  src="/images/board2/origami9.png"  mode="aspectFit" />
    <image class="bg-stk bg-visible bg-h-star" src="/images/board2/origami14.png" mode="aspectFit" />
    <image class="bg-stk bg-visible bg-h-star2" src="/images/board2/origami2.png" mode="aspectFit" />
  </view>

  <!-- tab 切换 -->
  <view class="tabs">
    <view class="tab {{tab === 0 ? 'tab-on' : ''}}" data-idx="0" bindtap="switchTab" hover-class="tab-hover">历史曲线</view>
    <view class="tab {{tab === 1 ? 'tab-on' : ''}}" data-idx="1" bindtap="switchTab" hover-class="tab-hover">推送记录</view>
  </view>

  <!-- ===== 历史曲线 ===== -->
  <view wx:if="{{tab === 0}}">

  <!-- 汇总 -->
  <view class="sum" wx:if="{{!loading && totalTasks}}">
    <view class="sum-i">
      <view class="num sum-n">{{totalTasks}}</view>
      <view class="t3">个在盯</view>
    </view>
    <view class="sum-sep"></view>
    <view class="sum-i">
      <view class="num sum-n">{{totalSamples}}</view>
      <view class="t3">次采样</view>
    </view>
    <view class="sum-sep"></view>
    <view class="sum-i">
      <view class="num sum-n">{{enoughCount}}</view>
      <view class="t3">个能看出规律</view>
    </view>
  </view>

  <view class="card fail" wx:if="{{fail}}">
    <view class="fail-t">读不到历史</view>
    <view class="fail-b">{{fail}}</view>
  </view>

  <view class="card sk-card" wx:if="{{loading && !rows.length}}">
    <view class="sk sk-t" style="width:50%"></view>
    <view class="sk" style="width:100%;height:58px;margin-top:14px"></view>
  </view>

  <!-- 一个监控都没有 -->
  <view class="card empty" wx:if="{{!loading && !rows.length && !fail}}">
    <view class="empty-mark"></view>
    <view class="empty-title">还没有数据</view>
    <view class="empty-sub">加个监控，盯几天这里就有用了。</view>
  </view>

  <!-- 每个监控一张 -->
  <view class="card h" wx:for="{{rows}}" wx:key="_id">
    <view class="h-head">
      <view class="h-l">
        <view class="t1 h-name">{{item.name}}</view>
        <view class="t3 h-sub">{{item.platform}} · 采了 {{item.samples}} 次 · 跨度 {{item.span}}</view>
      </view>
      <text class="tag {{item.ok ? 'tag-ok' : 'tag-bad'}}">{{item.ok ? '正常' : '抓取失败'}}</text>
    </view>

    <!-- 余票柱状图 -->
    <view class="spark" wx:if="{{item.samples > 1}}">
      <view class="spark-b {{b.n > 0 ? '' : 'zero'}}" wx:for="{{item.bars}}" wx:for-item="b" wx:key="index" style="height:{{b.h}}%"></view>
    </view>
    <view class="spark-ph" wx:elif="{{item.samples <= 1}}">
      只采了 {{item.samples}} 次，画不出曲线
    </view>

    <view class="h-metrics" wx:if="{{item.enough}}">
      <view class="m-i">
        <view class="num m-n">{{item.peak}}</view>
        <view class="t3">峰值余票</view>
      </view>
      <view class="m-i">
        <view class="num m-n">{{item.drops}}</view>
        <view class="t3">放票次数</view>
      </view>
      <view class="m-i">
        <view class="num m-n">{{item.samples}}</view>
        <view class="t3">采样数</view>
      </view>
    </view>

    <view class="verdict {{item.tone}}">{{item.verdict}}</view>
  </view>

  <view class="safe"></view>
  </view>

  <!-- ===== 推送记录 ===== -->
  <view wx:if="{{tab === 1}}">

    <!-- 推送健康 -->
    <view class="card health">
      <view class="health-row">
        <view class="health-l">
          <view class="t3">推送额度</view>
          <view class="health-v">
            <text class="num health-n {{credit > 0 ? '' : 'health-bad'}}">{{credit}}</text>
            <text class="t2"> 条</text>
          </view>
        </view>
        <view class="health-l">
          <view class="t3">平台连通</view>
          <view class="health-v">
            <text class="num health-n">{{healthy}}</text>
            <text class="t2"> / {{total}} 正常</text>
          </view>
        </view>
        <view class="health-l">
          <view class="t3">上次检查</view>
          <view class="health-v"><text class="t2">{{lastCheckRel || '—'}}</text></view>
        </view>
      </view>

      <view class="notice notice-warn" wx:if="{{credit === 0}}">
        额度用完了，现在有票也推不出去。点下面按钮重新领。
      </view>
      <view class="notice notice-ok" wx:else>
        一切正常。有余票变化会立刻推到你微信。
      </view>

      <view class="btn btn-primary health-btn" bindtap="goMine" hover-class="press-hover">
        {{credit > 0 ? '去领更多额度' : '现在去领额度'}}
      </view>
    </view>

    <!-- 活动流 -->
    <view class="sec">
      <text class="sec-title">检查记录</text>
      <text class="sec-more">只记状态变化，不刷屏</text>
    </view>

    <view class="card empty" wx:if="{{!activity.length}}">
      <view class="empty-mark"></view>
      <view class="empty-title">还没有记录</view>
      <view class="empty-sub">
        余票数量发生变化时，这里会留下一条。<br />
        没有变化说明一切正常——没票的时候本来就该安静。
      </view>
    </view>

    <view class="act" wx:for="{{activity}}" wx:key="t">
      <view class="act-dot {{item.kind}}"></view>
      <view class="act-l">
        <view class="act-top">
          <text class="act-name">{{item.name}}</text>
          <text class="t3">{{item.rel}}</text>
        </view>
        <view class="act-detail">
          <text class="tag {{item.kindTag}}">{{item.kindLabel}}</text>
          <text class="t2 act-txt">{{item.detail}}</text>
        </view>
      </view>
    </view>

    <view class="safe"></view>
  </view>

</view>
