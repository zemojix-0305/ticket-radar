<!-- 我的 -->
<view class="page" bindtap="onAnyTap">

  <!-- 背景拼贴层：贴纸素材压到 0.07~0.14 透明度，只在留白处透出 -->
  <view class="bg-collage">
    <image class="bg-stk bg-faint bg-note"   src="/images/board2/origami15.png" mode="aspectFit" />
    <image class="bg-stk bg-faint bg-trail"  src="/images/board2/cartoon10.png" mode="aspectFit" />
    <image class="bg-stk bg-visible bg-star7" src="/images/board2/origami19.png" mode="aspectFit" />
    <image class="bg-stk bg-visible bg-star8" src="/images/board2/origami6.png"  mode="aspectFit" />
  </view>

  <view class="nickname-sheet-mask" wx:if="{{editingName}}" bindtap="toggleEditName"></view>
  <view class="nickname-sheet" wx:if="{{editingName}}">
    <view class="sheet-title">你的昵称</view>
    <!-- 不用 type="nickname"：模拟器不支持，改用普通 text 输入 -->
    <input
      class="nickname-input"
      type="text"
      placeholder="给自己起个昵称"
      value="{{user.nickname}}"
      focus
      bindinput="onNicknameDraft"
    />
    <view class="acts">
      <view class="btn btn-ghost" bindtap="toggleEditName" hover-class="press-hover">取消</view>
      <view class="btn btn-primary" bindtap="saveNickname" hover-class="press-hover">保存</view>
    </view>
  </view>

  <!-- 用户资料 -->
  <view class="card profile">
    <!-- 头像：用 view 替代 button[open-type=chooseAvatar]，避免模拟器权限报错。
         点上去可以引导用户去微信设置里改头像，或以后版本再加图片选择器。 -->
    <view class="avatar-wrap press" bindtap="onChooseAvatar" hover-class="press-hover">
      <image class="avatar" src="{{user.avatar || '/images/avatar_fox.png'}}" mode="aspectFit" />
      <view class="avatar-edit">✎</view>
    </view>
    <view class="profile-info">
      <view wx:if="{{user.nickname}}" class="nickname-row">
        <text class="nickname">{{user.nickname}}</text>
        <text class="t3 nickname-edit press" bindtap="toggleEditName" hover-class="press-hover">改</text>
      </view>
      <view wx:else class="nickname-edit-btn press" bindtap="toggleEditName" hover-class="press-hover">点这里设昵称</view>

      <view class="uid-row" bindtap="copyUid" hover-class="press-hover">
        <text class="uid">{{user.uid}}</text>
        <text class="uid-copy">复制</text>
      </view>
    </view>
  </view>

  <!-- 推送开关：只有「开 / 关」两种状态，不出现额度、条数这些说法 -->
  <view class="card quota">
    <view class="quota-row">
      <view class="quota-v">
        <text class="t1">{{pushOn ? '推送已开启' : '推送已暂停'}}</text>
      </view>
      <view class="quota-sw {{pushOn ? 'quota-sw-on' : ''}}" bindtap="togglePush" hover-class="press-hover">{{pushOn ? '暂停推送' : '恢复推送'}}</view>
    </view>
    <text class="quota-hint" wx:if="{{!pushOn}}">弹窗里勾上「总是保持以上选择」，以后不再弹，推送自动续。</text>
    <text class="quota-msg" wx:if="{{authMsg}}">{{authMsg}}</text>
    <text class="quota-msg" wx:if="{{srvMsg}}">{{srvMsg}}</text>
  </view>

  <!-- 温馨提示：必看。放在外部提醒上面，先解释「为什么机票要走邮箱」 -->
  <view class="card notice">
    <view class="notice-hd" bindtap="toggleTips" hover-class="press-hover">
      <text class="notice-ic">!</text>
      <text class="notice-t">温馨提示 · 必看</text>
      <text class="notice-free">免费</text>
      <text class="notice-replay" catchtap="replayIntro">再看一次</text>
      <text class="bind-arrow {{tipsOpen ? 'bind-arrow-open' : ''}}">▾</text>
    </view>
    <view class="notice-bd" wx:if="{{tipsOpen}}">
      <view class="notice-item" wx:for="{{tips}}" wx:key="t">
        <text class="notice-i-t">{{index + 1}}. {{item.t}}</text>
        <text class="notice-i-d">{{item.d}}</text>
        <text class="notice-i-hi" wx:if="{{item.hi}}">{{item.hi}}</text>
      </view>
    </view>
    <text class="notice-mini" wx:else>免费 · 机票走邮箱不占额度 · 微信一天最多 20 条</text>
  </view>

  <!-- 外部提醒：微信之外的一条路。不占订阅额度、不限条数 -->
  <!-- 这里最容易踩的坑：收起状态下只显示一个「外部提醒」标题，用户压根不知道
       点进去能填邮箱。所以未绑定时默认展开，并且标题右侧直接写「去绑定」。 -->
  <view class="card ext {{extKind ? '' : 'ext-off'}}">
    <view class="ext-head" bindtap="toggleExt" hover-class="press-hover">
      <view class="ext-head-l">
        <text class="t1">外部提醒</text>
        <text class="ext-badge" wx:if="{{extKind}}">已绑 {{extLabel}}</text>
        <text class="ext-badge ext-badge-off" wx:else>还没绑</text>
      </view>
      <view class="ext-cta press" wx:if="{{!extOpen}}">
        <text class="ext-cta-t">{{extKind ? '管理' : '去填邮箱'}}</text>
        <text class="bind-arrow">▾</text>
      </view>
      <text class="bind-arrow {{extOpen ? 'bind-arrow-open' : ''}}" wx:else>▾</text>
    </view>

    <text class="ext-sub" wx:if="{{!extOpen}}">{{extKind ? '机票提醒走这里，不占微信额度' : '点「去填邮箱」，机票提醒就不再抢微信额度'}}</text>

    <view wx:if="{{extOpen}}">
      <text class="ext-hint">微信订阅消息是「授权一次收一条」，额度得省给演唱会回流票。这里绑一个通道之后：<text class="ext-strong">机票提醒走这个通道，演出提醒继续走微信</text>，两条互不抢额度。</text>

      <block wx:if="{{extKind}}">
        <view class="ext-bound">
          <view class="t2">{{extLabel}}</view>
          <text class="ext-mask">{{extMasked}}</text>
        </view>
        <view class="acts">
          <view class="btn btn-ghost" bindtap="clearExt" hover-class="press-hover">解绑</view>
        </view>
      </block>

      <block wx:else>
        <textarea class="ext-input" value="{{extInput}}" bindinput="onExtInput" placeholder="粘邮箱或推送地址，自动识别" placeholder-class="ext-ph" maxlength="300" auto-height></textarea>
        <view class="acts">
          <view class="btn {{extBusy ? 'btn-wait' : ''}}" bindtap="saveExt" hover-class="press-hover">{{extBusy ? '正在验证…' : '绑定并测试'}}</view>
        </view>
        <text class="ext-hint2">邮箱（推荐）：填 xxx@126.com 这样的地址，机票提醒发这里，不限条数、不用额外花钱</text>
        <text class="ext-hint2">企业微信：群 → 右上角 → 群机器人 → 添加 → 复制 webhook（不限量）</text>
        <text class="ext-hint2">Server酱：sct.ftqq.com 微信扫码 → SendKey（SCT 开头，免费 5 条/天）</text>
        <text class="ext-hint2">ntfy：App 内订阅 topic，粘 https://ntfy.sh/主题名</text>
      </block>
    </view>
  </view>

  <!-- 正在盯：入口按钮，点进独立页看列表 -->
  <view class="card watched-entry" bindtap="goWatched" hover-class="press-hover">
    <view class="watched-entry-main">
      <view class="t1">正在盯的</view>
      <view class="t3">{{watchedCount ? '正在盯 ' + watchedCount + ' 个' : '还没在盯任何票'}}</view>
    </view>
    <text class="watched-entry-arrow">›</text>
  </view>

  <!-- 微信绑定 -->
  <view class="card bind">
    <view class="bind-head" bindtap="toggleBind" hover-class="press-hover">
      <view class="t1">推送绑定</view>
      <text class="bind-arrow {{bindOpen ? 'bind-arrow-open' : ''}}">▾</text>
    </view>

    <view wx:if="{{bindOpen}}">
      <view class="code-box" wx:if="{{code}}">
        <text class="code" user-select="true">{{code}}</text>
      </view>
      <text class="t3" wx:else>正在获取…</text>

      <view class="acts" wx:if="{{code}}">
        <view class="btn btn-ghost" bindtap="copyCode" hover-class="press-hover">复制 code</view>
        <view class="btn btn-ghost" bindtap="refreshCode" hover-class="press-hover">换一个</view>
      </view>

      <view class="cmd" wx:if="{{code}}">
        <text class="cmd-c" user-select="true">radar wxbind {{code}}</text>
      </view>
    </view>
  </view>

  <!-- 平台凭证：纷玩岛票档/猫眼分档价/大麦风控都走登录通道，此处填一次全端生效 -->
  <view class="card bind">
    <view class="bind-head" bindtap="toggleCred" hover-class="press-hover">
      <view class="t1">平台凭证</view>
      <text class="bind-arrow {{credOpen ? 'bind-arrow-open' : ''}}">▾</text>
    </view>

    <view wx:if="{{credOpen}}">
      <view class="t3" style="padding: 4px 0;">填一次存本机，盯票时自动带上。不填也能用，只是那些平台看不到票档明细。</view>

      <view class="cred-section">
        <view class="cred-label">纷玩岛 token（按票档盯必填）</view>
        <view class="cred-hint" wx:if="{{!fwdToken}}">🔑 未登录 → 点下方按钮，30秒搞定</view>
        <view class="cred-hint" wx:elif="{{fwdToken}}">✓ 已登录</view>

        <!-- 一键获取流程 -->
        <view class="fwd-guide" wx:if="{{!fwdToken}}">
          <view class="fwd-big-btn press" bindtap="openFenwandao" hover-class="press-hover">
            <text class="fwd-big-icon">🎫</text>
            <text class="fwd-big-text">打开纷玩岛 → 获取 token</text>
          </view>
          <view class="fwd-steps">
            <view class="fwd-step">
              <text class="fwd-step-num">①</text>
              <text class="fwd-step-desc">点上面按钮打开纷玩岛，确保已登录账号</text>
            </view>
            <view class="fwd-step">
              <text class="fwd-step-num">②</text>
              <text class="fwd-step-desc">在电脑上打开微信 → 右键电脑上的纷玩岛聊天窗口 → 打开调试</text>
            </view>
            <view class="fwd-step">
              <text class="fwd-step-num">③</text>
              <text class="fwd-step-desc">随便点一个演出 → Network 标签 → 找到 authorization 头 → 复制 Bearer 后面的值</text>
            </view>
            <view class="fwd-step">
              <text class="fwd-step-num">④</text>
              <text class="fwd-step-desc">粘贴到下方输入框 → 点「保存并使用」</text>
            </view>
          </view>
          <input class="cred-input" password value="{{fwdTokenPending}}" placeholder="粘贴 authorization 里的 Bearer token" bindinput="onFwdTokenPendingInput" />
          <view class="btn btn-primary full-btn" bindtap="saveFwdTokenPending" hover-class="press-hover" wx:if="{{fwdTokenPending}}">保存并使用</view>
          <view class="btn btn-ghost full-btn" bindtap="clearFwdTokenPending" hover-class="press-hover" wx:else>清空</view>
        </view>

        <view class="cred-actions" wx:if="{{fwdToken}}">
          <view class="btn btn-ghost" bindtap="testFwdToken" hover-class="press-hover">测试连通</view>
          <view class="btn btn-ghost" bindtap="clearFwdToken" hover-class="press-hover">清除</view>
        </view>
      </view>

      <view class="cred-label">大麦 Cookie（看票档必填）</view>
      <view class="cred-hint" wx:if="{{!dmCookie}}">👇 点按钮，30秒获取</view>
      <view class="cred-hint" wx:elif="{{dmCookie}}">✓ 已配置</view>
      <view class="cred-guide" wx:if="{{!dmCookie}}">
        <view class="guide-step">① 点「打开大麦」→ 登录账号</view>
        <view class="guide-step">② 随便点一个演出</view>
        <view class="guide-step">③ 右上角「···」→ 在浏览器中打开</view>
        <view class="guide-step">④ 地址栏复制 URL 里的 itemId 值</view>
        <view class="guide-step">⑤ 粘贴到下方 → 保存</view>
      </view>
      <view class="cred-actions" wx:if="{{!dmCookie}}">
        <view class="btn btn-primary full-width" bindtap="openDamai" hover-class="press-hover">打开大麦</view>
      </view>
      <input class="cred-input" value="{{dmCookie}}" placeholder="粘贴大麦 URL 里的 itemId（形如 1086111708947）" bindinput="onDmInput" />

      <view class="cred-label">猫眼 token（看票档必填）</view>
      <view class="cred-hint" wx:if="{{!myToken}}">👇 点按钮，30秒获取</view>
      <view class="cred-hint" wx:elif="{{myToken}}">✓ 已配置</view>
      <view class="cred-guide" wx:if="{{!myToken}}">
        <view class="guide-step">① 点「打开猫眼」→ 登录账号</view>
        <view class="guide-step">② 随便点一个演出</view>
        <view class="guide-step">③ 地址栏复制 performanceId 值</view>
        <view class="guide-step">④ 粘贴到下方 → 保存</view>
      </view>
      <view class="cred-actions" wx:if="{{!myToken}}">
        <view class="btn btn-primary full-width" bindtap="openMaoyan" hover-class="press-hover">打开猫眼</view>
      </view>
      <input class="cred-input" password value="{{myToken}}" placeholder="粘贴猫眼 URL 里的 performanceId" bindinput="onMyTokenInput" />

      <view class="acts">
        <view class="btn btn-primary" bindtap="saveCred" hover-class="press-hover">保存凭证</view>
      </view>
    </view>
  </view>

  <!-- 我的留言：本机发过的讨论区帖子，可删除 -->
  <view class="card bind">
    <view class="bind-head" bindtap="toggleMyPosts" hover-class="press-hover">
      <view class="t1">我的留言 {{myPosts.length ? '· ' + myPosts.length + ' 条' : ''}}</view>
      <text class="bind-arrow {{myPostsOpen ? 'bind-arrow-open' : ''}}">▾</text>
    </view>

    <view wx:if="{{myPostsOpen}}">
      <view class="mypost-wall press" bindtap="goMyWall" hover-class="press-hover">
        <view class="mypost-wall-t">我的留言墙 ›</view>
      </view>
      <view wx:if="{{!myPosts.length}}" class="t3" style="padding: 6px 0;">还没发过留言</view>
      <view class="mypost" wx:for="{{myPosts}}" wx:key="_id">
        <view class="mypost-main">
          <view class="mypost-text">{{item.content}}</view>
          <view class="mypost-meta">{{item.type}}{{item.type && item.time ? ' · ' : ''}}{{item.time}}</view>
        </view>
        <view class="mypost-del press" data-id="{{item._id}}" bindtap="deleteMyPost" hover-class="press-hover">删除</view>
      </view>
    </view>
  </view>

  <!-- 支持作者：默认字体 + 朴素排版（对齐用户给的参考截图） -->
  <view class="card support">
    <view class="support-main">
      <view class="support-t">支持作者</view>
      <view class="support-d" user-select="true">项目已在 GitHub 开源：zemojix-0305/ticket-radar（可长按复制）</view>
      <view class="support-d">感谢大家的反馈和建议，点个 star 就是最棒的支持！</view>
    </view>
    <view class="support-btn press" bindtap="goStar" hover-class="press-hover">☆ Star</view>
  </view>

  <view class="safe"></view>

  <van-toast id="van-toast" />
  <!-- 这页有 4 处 Dialog.alert / Dialog.confirm，但之前只挂了 toast 没挂 dialog，
       所以点了完全没反应（删除留言「点不下去」就是这个原因）。 -->
  <van-dialog id="van-dialog" />
</view>
