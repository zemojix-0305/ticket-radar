.page { padding-bottom: 8px; }

/* ---------- 额度卡 ---------- */
.quota { padding: 18px 16px 16px; }
.quota-head { margin-bottom: 12px; }
.quota-v { display: flex; align-items: baseline; margin-top: 2px; }
.quota-n { color: var(--brand); }
.quota-why {
  font-size: 13px;
  color: var(--t2);
  line-height: 1.7;
  background: var(--none-weak);
  padding: 11px 13px;
  border-radius: var(--r-sm);
  margin-bottom: 14px;
}
.quota-msg {
  display: block;
  font-size: 13px;
  color: var(--ok);
  margin-top: 10px;
}
.quota-tip {
  display: block;
  font-size: 12px;
  color: var(--t3);
  line-height: 1.6;
  margin-top: 12px;
}

/* ---------- 按钮组 ---------- */
.acts { display: flex; gap: 10px; margin-top: 14px; }
.acts .btn { flex: 1; }
.acts .btn-primary { flex: 1.1; }

/* ---------- 微信绑定 ---------- */
.bind { padding: 14px 16px; }
.bind-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
}
.bind-arrow {
  font-size: 14px;
  color: var(--t3);
  transition: transform .2s;
}
.bind-arrow-open { transform: rotate(180deg); }
.bind-why {
  font-size: 13px;
  line-height: 1.7;
  margin: 14px 0 12px;
}
.code-box {
  background: var(--none-weak);
  border-radius: var(--r-sm);
  padding: 11px 13px;
  margin-bottom: 4px;
}
.code {
  font-size: 13px;
  color: var(--t1);
  word-break: break-all;
  display: block;
  line-height: 1.6;
}
.cmd {
  margin-top: 12px;
  padding: 11px 13px;
  background: var(--brand-weak);
  border-radius: var(--r-sm);
}
.cmd-t { display: block; font-size: 12px; color: var(--t2); margin-bottom: 5px; }
.cmd-c {
  display: block;
  font-family: Menlo, Consolas, monospace;
  font-size: 12px;
  color: var(--brand);
  word-break: break-all;
}

/* ---------- 承诺 ---------- */
.pledge { padding: 16px; }
.pledge-title { font-size: 15px; font-weight: 500; margin-bottom: 12px; }
.pledge-item {
  display: flex;
  align-items: flex-start;
  gap: 9px;
  font-size: 13px;
  color: var(--t2);
  line-height: 1.6;
  padding: 5px 0;
}
.pmark {
  color: var(--t3);
  font-size: 15px;
  flex-shrink: 0;
  width: 14px;
  line-height: 22px;
}

.about { line-height: 1.7; }
