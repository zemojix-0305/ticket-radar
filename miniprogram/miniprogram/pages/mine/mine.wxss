/* 我的页 v5：纸感票根手账（第十七轮）
   资料卡 / 额度卡 / 绑定卡 / 支持作者卡，全部落在暖白期刊纸上。
   支持作者卡保持默认字体 + 朴素排版（对齐用户给的参考截图）。 */
.page { padding-bottom: 8px; position: relative; }

/* ---------- 背景拼贴层定位（素材见 wxml，样式在 app.wxss）---------- */
.bg-note  { width: 96px;  height: 96px;  top: 480px; right: -18px; transform: rotate(8deg); }
.bg-trail { width: 84px;  height: 84px;  top: 130px; left: -14px; }
.bg-star7 { width: 26px;  height: 26px;  top: 330px; right: 12%; transform: rotate(-12deg); }
.bg-star8 { width: 22px;  height: 22px;  top: 700px; left: 9%; transform: rotate(14deg); }

/* ---------- 用户资料 ---------- */
.profile {
  display: flex;
  align-items: center;
  gap: 14px;
  padding: 16px 18px;
}
/* button[open-type] 天生带 min-height / border / 自带背景，
   不全部重置它就会在 flex 里被撑成一个方块（踩过的坑） */
.avatar-wrap {
  width: 56px;
  height: 56px;
  min-width: 56px;
  min-height: 56px;
  padding: 0;
  margin: 0;
  border: none;
  background: transparent;
  border-radius: 50%;
  overflow: hidden;
  line-height: 1;
  flex-shrink: 0;
}
.avatar-wrap::after { border: none; }
.avatar {
  display: block;
  width: 56px;
  height: 56px;
  border: 1px solid var(--line);
  border-radius: 50%;
}
/* 编辑提示角标 */
.avatar-edit {
  position: absolute;
  bottom: -2px;
  right: -2px;
  width: 20px;
  height: 20px;
  border-radius: 50%;
  background: var(--accent);
  color: var(--on-brand);
  font-size: 10px;
  display: flex;
  align-items: center;
  justify-content: center;
  line-height: 1;
  border: 2px solid var(--card);
}
.profile-info { flex: 1; min-width: 0; }
.nickname-row { display: flex; align-items: center; gap: 8px; }
.nickname { font-size: 17px; font-weight: 500; color: var(--ink); }
.nickname-edit { color: var(--accent); }
.nickname-edit-btn { font-size: 15px; color: var(--ink3); }
.uid-row { display: flex; align-items: center; gap: 9px; margin-top: 5px; }
.uid { font-size: 12px; color: var(--ink2); background: var(--card2); padding: 3px 9px; border-radius: var(--r-pill); }
.uid-copy { font-size: 12px; color: var(--accent); }

/* ---------- 昵称弹层 ---------- */
.nickname-sheet-mask {
  position: fixed; inset: 0; background: rgba(0,0,0,.36); z-index: 90;
}
.nickname-sheet {
  position: fixed; left: 0; right: 0; bottom: 0; z-index: 91;
  background: var(--card); border-radius: 12px 12px 0 0;
  padding: 20px 18px calc(18px + env(safe-area-inset-bottom));
}
.nickname-sheet .sheet-title { margin-bottom: 14px; }
.nickname-input {
  width: 100%; box-sizing: border-box; height: 44px;
  background: var(--card); border: 1px solid var(--line); border-radius: var(--r);
  padding: 0 14px; font-size: 16px; color: var(--ink);
}

/* ---------- 推送开关 ---------- */
.quota { padding: 14px 18px; position: relative; }
.quota-row { display: flex; align-items: center; justify-content: space-between; }
.quota-v { display: flex; align-items: baseline; }
/* 开关做成一枚胶囊按钮：开着是灰描边（可暂停），关着是黑底（提示去开） */
.quota-sw {
  padding: 7px 14px;
  border-radius: var(--r-pill);
  background: var(--ink);
  color: #fff;
  font-size: 13px;
}
.quota-sw-on {
  background: transparent;
  color: var(--ink2);
  border: 1px solid var(--line);
}
.acts { display: flex; gap: 10px; margin-top: 14px; }
.acts .btn { flex: 1; }
.quota .acts { margin-top: 0; }
.quota-msg { display: block; font-size: 13px; color: var(--accent); margin-top: 10px; line-height: 1.6; }
/* 只在「还没开」时出现：告诉用户第一次弹窗里该勾哪个，勾了就再也不会弹 */
.quota-hint { display: block; font-size: 13px; color: var(--ink3); margin-top: 8px; line-height: 1.6; }

/* ---------- 推送绑定 ---------- */
.bind { padding: 14px 18px; }
.bind-head { display: flex; align-items: center; justify-content: space-between; }
.bind-arrow { font-size: 14px; color: var(--ink3); transition: transform .2s; }
.bind-arrow-open { transform: rotate(180deg); }
.code-box { background: var(--card2); border-radius: var(--r); padding: 11px 13px; margin-top: 12px; }
.cred-label { font-size: 12px; color: var(--ink2); margin-top: 12px; }
.cred-section { margin-top: 4px; }
.cred-hint {
  font-size: 11px;
  color: var(--ink3);
  margin-top: 4px;
  line-height: 1.5;
}
.cred-actions {
  display: flex;
  gap: 8px;
  margin-top: 8px;
  flex-wrap: wrap;
}
.cred-guide {
  margin: 12px 0;
  padding: 12px;
  background: var(--warn-weak);
  border-radius: var(--r-sm);
  border-left: 3px solid var(--warn);
}
.guide-step {
  font-size: 12px;
  color: var(--ink2);
  line-height: 1.8;
  padding-left: 4px;
}
.full-width {
  width: 100%;
}
.fwd-guide {
  margin: 12px 0;
  padding: 12px;
  background: var(--brand-weak, rgba(107, 79, 168, 0.06));
  border-radius: var(--r-sm);
}
.fwd-step {
  display: flex;
  align-items: center;
  gap: 10px;
}
.fwd-step-num {
  width: 22px;
  height: 22px;
  border-radius: 50%;
  background: var(--brand, #6B4FA8);
  color: #fff;
  font-size: 12px;
  font-weight: 700;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
}
.fwd-step-text {
  font-size: 13px;
  color: var(--ink);
  line-height: 1.4;
}
.fwd-arrow {
  text-align: center;
  color: var(--ink3);
  font-size: 16px;
  margin: 4px 0;
}
.fwd-link-input {
  margin-top: 8px;
}
.cred-input {
  margin-top: 6px;
  background: var(--card2);
  border-radius: var(--r);
  padding: 10px 12px;
  font-size: 12px;
  color: var(--ink);
  word-break: break-all;
}
.code { font-size: 13px; color: var(--ink); word-break: break-all; display: block; line-height: 1.6; }
.cmd { margin-top: 12px; padding: 10px 12px; background: var(--accent-weak); border-radius: var(--r); }
.cmd-c {
  display: block;
  font-size: 12px;
  color: var(--accent);
  word-break: break-all;
}

/* ---------- 支持作者：默认字体 + 朴素排版 ---------- */
.support {
  position: relative;
  display: flex;
  align-items: center;
  gap: 14px;
  overflow: hidden;
  padding: 18px;
}
.support-tape {
  top: -8px;
  left: 18px;
  width: 64px;
  transform: rotate(-5deg);
}
.support-main {
  flex: 1;
  min-width: 0;
}
.support-t {
  font-size: 17px;
  font-weight: 600;
  color: var(--ink);
  letter-spacing: 0.5px;
}
.support-d {
  font-size: 12px;
  color: var(--ink3);
  margin-top: 5px;
  line-height: 1.5;
}
.support-btn {
  flex-shrink: 0;
  padding: 9px 18px;
  background: var(--accent);
  color: var(--on-brand);
  border-radius: var(--r-pill);
  font-size: 13px;
  white-space: nowrap;
  letter-spacing: 0.5px;
}
/* ---------- 正在盯：入口按钮 ---------- */
.watched-entry {
  display: flex;
  align-items: center;
  gap: 12px;
  padding: 16px 18px;
}
.watched-entry-main { flex: 1; min-width: 0; }
.watched-entry-main .t3 { margin-top: 5px; }
.watched-entry-arrow {
  flex-shrink: 0;
  font-size: 22px;
  color: var(--ink3);
  line-height: 1;
}

/* ---------- 纷玩岛 Token ---------- */
.fwd-input {
  width: 100%;
  box-sizing: border-box;
  min-height: 64px;
  padding: 10px 12px;
  border-radius: 12px;
  background: var(--card2);
  font-size: 12px;
  color: var(--ink);
  word-break: break-all;
}
.fwd-ph { color: var(--ink3); }

/* 我的留言列表：小行 + 右侧删除 */
.mypost {
  display: flex;
  align-items: center;
  gap: 10px;
  padding: 10px 0;
  border-bottom: 1px dashed var(--line, rgba(0, 0, 0, 0.08));
}
.mypost:last-child { border-bottom: none; }
.mypost-main { flex: 1; min-width: 0; }
.mypost-text {
  font-size: 13px;
  color: var(--ink, #2A2620);
  line-height: 1.5;
  display: -webkit-box;
  -webkit-box-orient: vertical;
  -webkit-line-clamp: 2;
  overflow: hidden;
}
.mypost-meta { font-size: 11px; color: var(--ink3, #8A8378); margin-top: 3px; }
.mypost-del {
  flex-shrink: 0;
  font-size: 12px;
  color: #C0655A;
  padding: 4px 8px;
}

/* 留言墙入口：我的留言折叠卡里的跳转行 */
.mypost-wall {
  padding: 10px 12px;
  margin: 8px 0;
  border: 1px dashed var(--brand, #6B4FA8);
  border-radius: 10px;
  background: var(--brand-weak, rgba(107, 79, 168, 0.06));
}
.mypost-wall-t { font-size: 13px; font-weight: 500; color: var(--brand, #6B4FA8); }

/* ---- 外部提醒（企业微信 / Server酱 / ntfy）---- */
/* .card 本身不带 padding，ext 这张卡的内容全靠这里撑开，漏了就变成贴边的裸标题 */
.card.ext { padding: 14px 16px 16px; }
/* 未绑定：左边一条强调色，让它在整页白卡里一眼能被挑出来 */
.card.ext.ext-off {
  border-left: 3px solid var(--brand, #6B4FA8);
  background: linear-gradient(90deg, rgba(107, 79, 168, 0.06), var(--card) 42%);
}
.ext-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 10px;
}
.ext-head-l { display: flex; align-items: center; gap: 8px; min-width: 0; }
.ext-badge {
  font-size: 11px;
  color: var(--brand, #6B4FA8);
  background: var(--brand-weak, rgba(107, 79, 168, 0.08));
  border-radius: 999px;
  padding: 2px 8px;
  flex-shrink: 0;
}
.ext-badge-off { color: var(--ink3, #8A8378); background: rgba(0, 0, 0, 0.05); }
/* 收起时的「去填邮箱」小按钮：真正的行动指引，不能只是个箭头 */
.ext-cta {
  display: flex;
  align-items: center;
  gap: 4px;
  flex-shrink: 0;
  background: var(--brand, #6B4FA8);
  color: #fff;
  border-radius: 999px;
  padding: 5px 10px;
}
.ext-cta-t { font-size: 12px; color: #fff; font-weight: 500; }
.ext-cta .bind-arrow { color: rgba(255, 255, 255, 0.85); font-size: 11px; }
.ext-sub {
  display: block;
  font-size: 12px;
  color: var(--ink3, #8A8378);
  line-height: 1.6;
  margin-top: 8px;
}
.ext-hint {
  display: block;
  font-size: 12px;
  color: var(--ink3, #8A8378);
  line-height: 1.7;
  margin-top: 10px;
}
.ext-strong { color: var(--brand, #6B4FA8); font-weight: 500; }
.ext-hint2 {
  display: block;
  font-size: 11px;
  color: var(--ink3, #8A8378);
  line-height: 1.8;
  margin-top: 6px;
}
.ext-input {
  width: 100%;
  min-height: 72px;
  box-sizing: border-box;
  margin-top: 12px;
  padding: 10px 12px;
  font-size: 13px;
  line-height: 1.5;
  color: var(--ink, #2A2620);
  background: rgba(0, 0, 0, 0.025);
  border: 1px solid var(--line, rgba(0, 0, 0, 0.1));
  border-radius: 10px;
}
.ext-ph { color: var(--ink3, #B0A99E); font-size: 13px; }
.ext-bound {
  margin-top: 12px;
  padding: 10px 12px;
  border-radius: 10px;
  background: rgba(0, 0, 0, 0.025);
}
.ext-mask {
  display: block;
  font-size: 11px;
  color: var(--ink3, #8A8378);
  margin-top: 4px;
  word-break: break-all;
}
.btn-wait { opacity: 0.6; }

/* ---------- 温馨提示（必看） ---------- */
/* 与首页同款：左侧实心竖条 + 暖底，跟普通纸卡区分开 */
.notice {
  border-left: 4px solid var(--warn);
}
.notice-hd {
  display: flex;
  align-items: center;
  gap: 8px;
  padding: 13px 16px;
  background: var(--warn-weak);
}
.notice-ic {
  flex-shrink: 0;
  width: 17px;
  height: 17px;
  line-height: 17px;
  text-align: center;
  border-radius: 50%;
  background: var(--warn);
  color: #FFFFFF;
  font-size: 12px;
  font-weight: 600;
}
.notice-t {
  flex: 1;
  font-size: 13px;
  font-weight: 600;
  color: var(--warn);
  letter-spacing: 0.3px;
}
.notice-bd { padding: 12px 16px 14px; }
.notice-item { margin-bottom: 10px; }
.notice-item:last-child { margin-bottom: 0; }
.notice-i-t {
  display: block;
  font-size: 12.5px;
  font-weight: 600;
  color: var(--ink);
  line-height: 1.5;
}
.notice-i-d {
  display: block;
  margin-top: 3px;
  font-size: 12px;
  color: var(--ink2);
  line-height: 1.62;
}
/* 标题栏里的「全免费」小标签：不用点开就能看到最要紧的那个事实 */
.notice-free {
  flex-shrink: 0;
  font-size: 10.5px;
  font-weight: 600;
  color: #2E7D32;
  background: rgba(46, 125, 50, 0.12);
  border-radius: 999px;
  padding: 1px 7px;
  line-height: 1.6;
}
.notice-replay {
  flex-shrink: 0;
  font-size: 10.5px;
  color: var(--warn, #8D6308);
  text-decoration: underline;
  opacity: 0.8;
}
/* 每条里加粗的那一句。整段加粗等于没加粗，所以正文不动、只给这一句上重量 */
.notice-i-hi {
  display: block;
  margin-top: 5px;
  font-size: 12px;
  font-weight: 600;
  color: var(--warn, #8D6308);
  line-height: 1.6;
}
.notice-mini {
  display: block;
  padding: 0 16px 13px;
  font-size: 11.5px;
  color: var(--warn);
  line-height: 1.5;
}
