.page { padding-bottom: 8px; }

/* ---------- 链接粘贴模式说明 ---------- */
.link-hint {
  margin: 0 12px 6px;
  padding: 10px 14px;
  background: var(--card);
  border-radius: var(--r-sm);
  box-shadow: var(--shadow);
  font-size: 12px;
  color: var(--t3);
  line-height: 1.7;
}

/* ---------- 平台筛选 ---------- */
.platform-bar {
  display: flex;
  gap: 10px;
  padding: 10px 12px 0;
}
.platform-chip {
  padding: 7px 15px;
  border-radius: 999px;
  font-size: 13px;
  color: var(--t2);
  background: var(--brand-weak);
  letter-spacing: 0.3px;
}
.platform-on {
  background: var(--brand);
  color: var(--on-brand);
}

/* ---------- 搜索栏 ---------- */
.searchbar {
  display: flex;
  align-items: center;
  gap: 8px;
  padding: 10px 12px;
}
.search-box {
  flex: 1;
  min-width: 0;
  display: flex;
  align-items: center;
  height: 42px;
  padding: 0 14px;
  background: var(--card);
  border-radius: 21px;
  box-shadow: var(--shadow);
}
.search-ico {
  width: 14px;
  height: 14px;
  border: 2px solid var(--t3);
  border-radius: 50%;
  flex-shrink: 0;
  position: relative;
}
.search-ico::after {
  content: '';
  position: absolute;
  right: -5px;
  bottom: -3px;
  width: 6px;
  height: 2px;
  background: var(--t3);
  transform: rotate(45deg);
}
.search-inp {
  flex: 1;
  min-width: 0;
  margin-left: 9px;
  font-size: 15px;
  color: var(--t1);
}
.search-ph { color: var(--t3); font-size: 14px; }
.search-clear { font-size: 13px; color: var(--t3); padding-left: 8px; }

.search-btn {
  flex-shrink: 0;
  height: 42px;
  line-height: 42px;
  padding: 0 18px;
  border-radius: 21px;
  background: var(--brand);
  color: var(--on-brand);
  font-size: 15px;
  font-weight: 500;
}
.search-btn.disabled { background: var(--disabled); }

/* ---------- 12306 线路表单 ---------- */
.rail-form { padding: 4px 12px 2px; }
.rail-row { display: flex; align-items: center; gap: 8px; margin-bottom: 10px; }
.rail-row:last-child { margin-bottom: 2px; }
.rail-inp {
  flex: 1;
  min-width: 0;
  height: 42px;
  padding: 0 14px;
  background: var(--card);
  border-radius: 21px;
  font-size: 14px;
  color: var(--t1);
  box-shadow: var(--shadow);
  box-sizing: border-box;
}
.rail-arrow { flex-shrink: 0; color: var(--t3); font-size: 15px; }
.rail-date { flex: 1; min-width: 0; }
.rail-date-in {
  height: 42px;
  line-height: 42px;
  padding: 0 16px;
  background: var(--card);
  border-radius: 21px;
  font-size: 14px;
  color: var(--t1);
  box-shadow: var(--shadow);
  box-sizing: border-box;
}

/* ---------- 结果行：贴纸卡 ---------- */
.row-card {
  display: flex;
  align-items: center;
  gap: 12px;
  background: var(--card);
  border-radius: var(--r);
  margin: var(--gut);
  padding: 14px;
  box-shadow: var(--shadow);
}
.poster {
  width: 64px;
  height: 64px;
  border-radius: 16px;
  overflow: hidden;
  flex-shrink: 0;
  background: var(--none-weak);
}
.poster-img { width: 100%; height: 100%; display: block; }
.poster-blank { background: var(--brand-weak); }

.row-main { flex: 1; min-width: 0; }
.row-name {
  font-size: 15px;
  font-weight: 500;
  color: var(--t1);
  line-height: 1.35;
  overflow: hidden;
  text-overflow: ellipsis;
  display: -webkit-box;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
}
.row-meta { margin-top: 6px; display: flex; flex-wrap: wrap; gap: 6px; }
.row-sub {
  display: flex;
  align-items: baseline;
  gap: 10px;
  margin-top: 6px;
  font-size: 12px;
  color: var(--t3);
}
.row-price { color: var(--brand); font-weight: 500; }

/* 「盯」：实心莓粉小药丸 */
.row-add {
  flex-shrink: 0;
  width: 52px;
  height: 34px;
  line-height: 34px;
  text-align: center;
  border-radius: 17px;
  background: var(--brand);
  color: var(--on-brand);
  font-size: 15px;
  font-weight: 500;
  box-shadow: var(--shadow-brand);
}
.row-add-busy { background: var(--none-weak); color: var(--t3); box-shadow: none; }

/* ---------- 失败 / 骨架 ---------- */
.fail { padding: 16px; }
.fail-t { font-size: 15px; color: var(--bad); margin-bottom: 6px; }
.fail-b { font-size: 13px; color: var(--t2); line-height: 1.6; }
.sk-card { padding: 16px; }
.sk-t { height: 16px; }

/* ---------- 搜索历史 ---------- */
.hist { padding: 14px 16px; }
.hist-head { display: flex; align-items: baseline; justify-content: space-between; margin-bottom: 12px; }
.hist-title { font-size: 14px; font-weight: 500; color: var(--t1); }
.hist-clear { font-size: 12px; color: var(--t3); }
.hist-body { display: flex; flex-wrap: wrap; gap: 8px; }
.chip {
  padding: 7px 14px;
  background: var(--card);
  border-radius: 16px;
  font-size: 13px;
  color: var(--t2);
  box-shadow: var(--shadow);
}
