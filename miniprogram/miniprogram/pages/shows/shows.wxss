/* 场次页 v5：纸感票根手账（第十七轮）
   暖白期刊纸底 + 纸卡片 + 印章状态 + 胶带贴纸；
   演出卡像一张小票：海报在左、信息在右、底部虚线撕线。 */
.page { padding-bottom: 8px; position: relative; }

/* ---------- 背景拼贴层定位（素材见 wxml，样式在 app.wxss）---------- */
.bg-love   { width: 120px; height: 120px; top: 300px; right: -24px; transform: rotate(14deg); }
.bg-swirl  { width: 96px;  height: 96px;  top: 640px; left: -20px; }
.bg-burst  { width: 88px;  height: 88px;  top: 1000px; right: 8%; }
.bg-star1  { width: 30px;  height: 30px;  top: 210px; left: 8%; transform: rotate(-12deg); }
.bg-star2  { width: 24px;  height: 24px;  top: 470px; right: 12%; transform: rotate(16deg); }

/* ---------- 顶部：标题 + 英文小注 ---------- */
.head {
  padding: 26px 20px 6px;
  position: relative;   /* 容纳胶带 */
}
.head-hand {
  font-size: 24px;
  font-weight: 600;
  color: var(--ink);
  letter-spacing: 0.5px;
  margin-bottom: 8px;
  white-space: nowrap;
}
.head-row { display: flex; align-items: center; gap: 8px; }
.head-stks { display: flex; align-items: center; gap: 2px; }
.head-stk {
  width: 28px;
  height: 28px;
  transform: rotate(10deg);
  opacity: 0.95;
}

/* ---------- 平台 Tabs（vant，主题在 app.wxss） ---------- */
.platform-tabs {
  margin: 6px 8px 0;
}

/* ---------- 链接粘贴模式说明 ---------- */
.link-hint {
  margin: 10px 16px 6px;
  padding: 12px 14px;
  background: var(--card2);
  border-radius: var(--r);
  font-size: 12px;
  color: var(--ink2);
  line-height: 1.7;
}

/* ---------- 搜索栏 ---------- */
.searchbar {
  display: flex;
  align-items: center;
  gap: 8px;
  padding: 10px 16px;
  position: relative;
}
.search-box {
  flex: 1;
  min-width: 0;
  display: flex;
  align-items: center;
  height: 42px;
  padding: 0 14px;
  background: var(--card);
  border: 1px solid var(--line);
  border-radius: var(--r-pill);
}
/* 车票小图标：票身 + 中间虚线打孔线，微微倾斜 */
.search-ico {
  width: 17px;
  height: 12px;
  border: 2px solid var(--accent);
  border-radius: 3px;
  flex-shrink: 0;
  position: relative;
  transform: rotate(-10deg);
}
.search-ico::before {
  content: '';
  position: absolute;
  left: 50%;
  top: 0.5px;
  bottom: 0.5px;
  border-left: 1.5px dashed var(--accent);
}
.search-inp {
  flex: 1;
  min-width: 0;
  margin-left: 9px;
  font-size: 15px;
  color: var(--ink);
}
.search-ph { color: var(--ink3); font-size: 14px; }
.search-clear { font-size: 13px; color: var(--ink3); padding-left: 8px; }

.search-btn {
  flex-shrink: 0;
  height: 42px;
  line-height: 42px;
  padding: 0 18px;
  border-radius: var(--r);
  background: var(--accent);
  color: var(--on-brand);
  font-size: 15px;
  font-weight: 500;
  letter-spacing: 1px;
}
.search-btn.disabled { background: var(--disabled); }

/* ---------- 使用教程 / 常见问题 ---------- */
.faq { padding: 0; }
.faq-tape { top: -8px; left: 20px; }
.faq-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 16px 16px 14px;
}
.faq-head-l { display: flex; align-items: center; gap: 9px; min-width: 0; }
.faq-stk { width: 24px; height: 24px; flex-shrink: 0; }
.faq-title { font-size: 15px; color: var(--ink); white-space: nowrap; }
.faq-arrow { font-size: 13px; color: var(--ink3); transition: transform 0.2s; flex-shrink: 0; }
.faq-arrow-open { transform: rotate(180deg); }
.faq-body { padding: 0 16px 6px; }
.faq-item { padding: 2px 0 6px; }
.faq-q { display: flex; align-items: flex-start; }
.faq-q-t { font-size: 14px; font-weight: 600; color: var(--ink); line-height: 1.5; }
.faq-a {
  font-size: 13px;
  color: var(--ink2);
  line-height: 1.75;
  margin: 5px 0 10px 19px;
}

/* ---------- 12306 携程式表单 ---------- */
.rail-card {
  margin: 10px 16px;
  padding: 18px 16px 14px;
  border: 1px solid var(--line);
  border-radius: var(--r);
  background: var(--card);
}
.rail-top {
  display: flex;
  align-items: center;
  gap: 6px;
}
.rail-station { flex: 1; min-width: 0; }
.rail-station-lbl {
  font-size: 11px;
  letter-spacing: 1.5px;
  color: var(--ink3);
  margin-bottom: 6px;
}
.rail-station-inp {
  width: 100%;
  height: 40px;
  font-size: 17px;
  font-weight: 500;
  color: var(--ink);
}
.rail-swap {
  flex-shrink: 0;
  width: 40px;
  height: 40px;
  display: flex;
  align-items: center;
  justify-content: center;
  position: relative;
}
.rail-swap-line {
  position: absolute;
  left: 4px;
  right: 4px;
  top: 50%;
  height: 1.5px;
  background: var(--line2);
}
.rail-swap-arrow {
  position: relative;
  font-size: 17px;
  color: var(--accent);
  background: var(--card);
  padding: 0 3px;
  z-index: 1;
}
.rail-station-r .rail-station-inp { text-align: right; }

.rail-bottom {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-top: 16px;
  padding-top: 14px;
  border-top: 1px dashed var(--line2);
}
.rail-dates {
  display: flex;
  align-items: center;
  gap: 8px;
  flex: 1;
  min-width: 0;
}
.rail-date-chip {
  padding: 6px 13px;
  border-radius: var(--r-pill);
  background: var(--card2);
  font-size: 13px;
  color: var(--ink2);
  white-space: nowrap;
}
.rail-date-chip.chip-on {
  background: var(--accent-weak);
  color: var(--accent);
  font-weight: 500;
}
.rail-date-pick { flex-shrink: 0; }
.rail-bottom .search-btn { height: 38px; line-height: 38px; padding: 0 16px; font-size: 14px; }

/* ---------- 分区标题：标题 + 印章 ---------- */
.sec-stamp {
  font-size: 10px;
  letter-spacing: 2px;
  padding: 2px 8px;
  align-self: center;
}

/* ---------- 演出卡：小票样式 ---------- */
.hot-list { padding: 0 12px; }
.show-card {
  display: flex;
  gap: 14px;
  padding: 14px;
  margin-bottom: 10px;
  background: var(--card);
  border: 1px solid var(--line);
  border-radius: var(--r);
  position: relative;
}
.poster {
  width: 84px;
  height: 112px;
  border-radius: var(--r);
  overflow: hidden;
  flex-shrink: 0;
  background: var(--card2);
  border: 1px solid var(--line);
}
.poster-img { width: 100%; height: 100%; display: block; }
.poster-blank { background: var(--card2); }

.show-main { flex: 1; min-width: 0; display: flex; flex-direction: column; }
.show-name {
  font-size: 16px;
  font-weight: 600;
  color: var(--ink);
  line-height: 1.4;
  display: -webkit-box;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
  overflow: hidden;
}
.show-meta { margin-top: 8px; display: flex; flex-wrap: wrap; align-items: center; gap: 6px; }
.show-sub {
  margin-top: 5px;
  font-size: 12px;
  color: var(--ink3);
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}
.show-foot {
  margin-top: auto;
  padding-top: 10px;
  display: flex;
  align-items: center;
  gap: 8px;
  border-top: 1px dashed var(--line);
}
.show-more {
  margin-left: auto;
  font-size: 12px;
  color: var(--accent);
  letter-spacing: 0.3px;
  white-space: nowrap;
}
.show-price {
  font-size: 14px;
  font-weight: 600;
  color: var(--ink);
}

/* 「盯」：茶绿小药丸，全页唯一彩色 CTA */
.btn-watch {
  flex-shrink: 0;
  min-width: 56px;
  height: 32px;
  line-height: 32px;
  text-align: center;
  padding: 0 16px;
  border-radius: var(--r-pill);
  background: var(--accent);
  color: var(--on-brand);
  font-size: 14px;
  font-weight: 500;
}
.btn-watch-busy { background: var(--card2); color: var(--ink3); }

/* ---------- 失败 / 骨架 ---------- */
.fail { padding: 16px; }
.fail-t { font-size: 15px; color: var(--stamp); margin-bottom: 6px; }
.fail-b { font-size: 13px; color: var(--ink2); line-height: 1.6; }
.sk-card { padding: 16px; }
.sk-t { height: 16px; }

/* ---------- 搜索历史 ---------- */
.hist { padding: 14px 16px; }
.hist-head { display: flex; align-items: baseline; justify-content: space-between; margin-bottom: 12px; }
.hist-title { font-size: 14px; font-weight: 500; color: var(--ink); }
.hist-clear { font-size: 12px; color: var(--ink3); }
.hist-body { display: flex; flex-wrap: wrap; gap: 8px; }
.chip {
  padding: 6px 13px;
  background: var(--card2);
  border-radius: var(--r-pill);
  font-size: 13px;
  color: var(--ink2);
}
