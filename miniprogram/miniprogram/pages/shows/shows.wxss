.page { padding-bottom: 8px; }

/* ---------- 顶部：手写体标题 + 英文小注 ---------- */
.head {
  padding: 26px 20px 4px;
}
.head-hand {
  font-size: 26px;
  color: var(--t1);
  letter-spacing: 2px;
  margin-bottom: 8px;
  white-space: nowrap;   /* 标题类一律单行 */
}
.head-row { display: flex; align-items: center; gap: 8px; }
.head-stk {
  width: 28px;
  height: 28px;
  transform: rotate(10deg);
  opacity: 0.95;
}

/* ---------- 链接粘贴模式说明 ---------- */
.link-hint {
  margin: 0 16px 6px;
  padding: 12px 14px;
  background: var(--bg-soft);
  border-radius: var(--r-sm);
  font-size: 12px;
  color: var(--t2);
  line-height: 1.7;
}

/* ---------- 平台筛选 ---------- */
.platform-bar {
  display: flex;
  gap: 8px;
  padding: 12px 16px 4px;
  flex-wrap: wrap;
}
.platform-chip {
  padding: 6px 14px;
  border-radius: 999px;
  font-size: 13px;
  color: var(--t2);
  background: var(--bg-soft);
  letter-spacing: 0.3px;
}
.platform-on {
  background: var(--t1);
  color: var(--on-brand);
}

/* ---------- 搜索栏 ---------- */
.searchbar {
  display: flex;
  align-items: center;
  gap: 8px;
  padding: 10px 16px;
}
.search-box {
  flex: 1;
  min-width: 0;
  display: flex;
  align-items: center;
  height: 42px;
  padding: 0 14px;
  background: var(--bg-soft);
  border-radius: 21px;
}
/* 车票小图标：圆角票身 + 中间虚线打孔线，微微倾斜 */
.search-ico {
  width: 17px;
  height: 12px;
  border: 2px solid var(--brand);
  border-radius: 3px;
  flex-shrink: 0;
  position: relative;
  transform: rotate(-10deg);
}
.search-ico::before {
  content: '';
  position: absolute;
  left: 50%;
  top: 0.5px;
  bottom: 0.5px;
  border-left: 1.5px dashed var(--brand);
}
.search-inp {
  flex: 1;
  min-width: 0;
  margin-left: 9px;
  font-size: 15px;
  color: var(--t1);
}
.search-ph { color: var(--t3); font-size: 14px; }
.search-clear { font-size: 13px; color: var(--t3); padding-left: 8px; }

.search-btn {
  flex-shrink: 0;
  height: 42px;
  line-height: 42px;
  padding: 0 18px;
  border-radius: 21px;
  background: var(--brand);
  color: var(--on-brand);
  font-size: 15px;
  font-weight: 500;
}
.search-btn.disabled { background: var(--disabled); }

/* ---------- 12306 携程式表单 ---------- */
.rail-card {
  margin: 10px 16px;
  padding: 18px 16px 14px;
  border: 1px solid var(--line);
  border-radius: var(--r);
}
.rail-top {
  display: flex;
  align-items: center;
  gap: 6px;
}
.rail-station { flex: 1; min-width: 0; }
.rail-station-lbl {
  font-size: 11px;
  letter-spacing: 1.5px;
  color: var(--t3);
  margin-bottom: 6px;
}
.rail-station-inp {
  width: 100%;
  height: 40px;
  font-size: 17px;
  font-weight: 500;
  color: var(--t1);
}
.rail-swap {
  flex-shrink: 0;
  width: 40px;
  height: 40px;
  display: flex;
  align-items: center;
  justify-content: center;
  position: relative;
}
.rail-swap-line {
  position: absolute;
  left: 4px;
  right: 4px;
  top: 50%;
  height: 1.5px;
  background: var(--line);
}
.rail-swap-arrow {
  position: relative;
  font-size: 17px;
  color: var(--brand);
  background: var(--card);
  padding: 0 3px;
  z-index: 1;
}
.rail-station-r .rail-station-inp { text-align: right; }

.rail-bottom {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-top: 16px;
  padding-top: 14px;
  border-top: 1px solid var(--line);
}
.rail-dates {
  display: flex;
  align-items: center;
  gap: 8px;
  flex: 1;
  min-width: 0;
}
.rail-date-chip {
  padding: 6px 13px;
  border-radius: 999px;
  background: var(--bg-soft);
  font-size: 13px;
  color: var(--t2);
  white-space: nowrap;
}
.rail-date-chip.chip-on {
  background: var(--brand-weak);
  color: var(--brand);
  font-weight: 500;
}
.rail-date-pick { flex-shrink: 0; }
.rail-bottom .search-btn { height: 38px; line-height: 38px; padding: 0 16px; font-size: 14px; }

/* ---------- 演出卡：海报左 + 信息右 ---------- */
.hot-list { padding: 0 12px; }
.show-card {
  display: flex;
  gap: 14px;
  padding: 16px 4px;
  border-bottom: 1px solid var(--line);
}
.show-card:last-child { border-bottom: none; }
.poster {
  width: 84px;
  height: 112px;
  border-radius: 10px;
  overflow: hidden;
  flex-shrink: 0;
  background: var(--bg-soft);
}
.poster-img { width: 100%; height: 100%; display: block; }
.poster-blank { background: var(--bg-soft); }

.show-main { flex: 1; min-width: 0; display: flex; flex-direction: column; }
.show-name {
  font-size: 16px;
  font-weight: 600;
  color: var(--t1);
  line-height: 1.4;
  display: -webkit-box;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
  overflow: hidden;
}
.show-meta { margin-top: 7px; display: flex; flex-wrap: wrap; gap: 6px; }
.show-sub {
  margin-top: 5px;
  font-size: 12px;
  color: var(--t3);
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}
.show-foot {
  margin-top: auto;
  padding-top: 8px;
  display: flex;
  align-items: center;
  justify-content: space-between;
}
.show-price {
  font-size: 14px;
  font-weight: 600;
  color: var(--t1);
}

/* 「盯」：钴蓝实心小药丸，全页唯一彩色 CTA */
.btn-watch {
  flex-shrink: 0;
  min-width: 56px;
  height: 32px;
  line-height: 32px;
  text-align: center;
  padding: 0 16px;
  border-radius: 16px;
  background: var(--brand);
  color: var(--on-brand);
  font-size: 14px;
  font-weight: 500;
}
.btn-watch-busy { background: var(--none-weak); color: var(--t3); }

/* 刺绣字说明 */
.stitch-wrap {
  display: flex;
  justify-content: center;
  padding: 18px 0 6px;
}

/* ---------- 失败 / 骨架 ---------- */
.fail { padding: 16px; }
.fail-t { font-size: 15px; color: var(--bad); margin-bottom: 6px; }
.fail-b { font-size: 13px; color: var(--t2); line-height: 1.6; }
.sk-card { padding: 16px; }
.sk-t { height: 16px; }

/* ---------- 搜索历史 ---------- */
.hist { padding: 14px 16px; }
.hist-head { display: flex; align-items: baseline; justify-content: space-between; margin-bottom: 12px; }
.hist-title { font-size: 14px; font-weight: 500; color: var(--t1); }
.hist-clear { font-size: 12px; color: var(--t3); }
.hist-body { display: flex; flex-wrap: wrap; gap: 8px; }
.chip {
  padding: 6px 13px;
  background: var(--bg-soft);
  border-radius: 16px;
  font-size: 13px;
  color: var(--t2);
}
