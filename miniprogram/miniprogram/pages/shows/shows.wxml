<!-- 场次页 v5：纸感票根手账（第十七轮）
     语言：暖白期刊纸 + 平台用 van-tabs 切换 + 演出卡带印章状态。
     全部文字系统默认字体；交互反馈走 vant Toast/Dialog（纸感主题）。 -->
  <view class="page">

  <!-- 启动兜底：onLoad 抛错时可见，不再整页静默死 -->
  <view class="card fail" wx:if="{{bootError}}">
    <view class="fail-t">页面启动出错</view>
    <view class="fail-b">{{bootError}}</view>
  </view>

  <!-- 背景拼贴层：贴纸透明度压到 0.06~0.12，只在留白缝隙透出 -->
  <view class="bg-collage">
    <image class="bg-stk bg-faint bg-love"   src="/images/board2/origami24.png" mode="aspectFit" />
    <image class="bg-stk bg-faint bg-swirl"  src="/images/board2/cartoon12.png" mode="aspectFit" />
    <image class="bg-stk bg-faint bg-burst"  src="/images/board2/collage3.png"  mode="aspectFit" />
    <image class="bg-stk bg-visible bg-star1" src="/images/board2/origami1.png" mode="aspectFit" />
    <image class="bg-stk bg-visible bg-star2" src="/images/board2/origami22.png" mode="aspectFit" />
  </view>

  <!-- 顶部：标题 + 英文小注 + 胶带/蝴蝶结/贴纸 -->
  <view class="head">
    <view class="head-row">
      <view class="head-hand title-strong">今天想看什么</view>
      <view class="head-stks">
        <image class="head-stk stk-a" src="/images/board2/origami21.png" mode="aspectFit" />
      </view>
    </view>
  </view>

  <!-- 平台筛选：vant Tabs（纸感主题，app.wxss 覆盖） -->
  <van-tabs
    class="platform-tabs"
    active="{{platformIndex}}"
    swipeable
    animated
    ellipsis="{{false}}"
    color="#445C38"
    title-active-color="#2A2620"
    title-inactive-color="#6E6558"
    line-width="26px"
    line-height="3px"
    bind:change="onPlatform"
  >
    <van-tab wx:for="{{platforms}}" wx:key="key" title="{{item.label}}"></van-tab>
  </van-tabs>

  <!-- 搜索栏 / 链接粘贴 / 12306 线路表单 -->
  <view class="searchbar" wx:if="{{platforms[platformIndex].key !== 'rail12306'}}">
    <view class="search-box">
      <text class="search-ico"></text>
      <input
        class="search-inp"
        placeholder="{{platforms[platformIndex].linkOnly ? '粘贴该平台的演出分享链接' : '搜索演出、巡演、场馆'}}"
        placeholder-class="search-ph"
        value="{{kw}}"
        confirm-type="search"
        bindinput="onInput"
        bindconfirm="onSearch"
      />
      <text class="search-clear press" wx:if="{{kw}}" bindtap="clearAll" hover-class="press-hover">清除</text>
    </view>
    <view class="search-btn {{searching ? 'disabled' : ''}}" bindtap="onSearch" hover-class="press-hover">
      {{searching ? '搜着' : (platforms[platformIndex].linkOnly ? '识别' : '搜索')}}
    </view>
  </view>

  <!-- 贴链接模式说明（票星球 / 纷玩岛） -->
  <view class="link-hint" wx:if="{{platforms[platformIndex].linkOnly}}">
    这个平台不让小程序自动搜索。去 App 打开想盯的演出 → 分享 → 复制链接，粘到这里就能<text wx:if="{{platforms[platformIndex].key === 'fenwandao'}}">看到演出信息</text><text wx:else>盯它的回流票——状态从「无票」翻回「可售」的第一时间推给你</text>。
  </view>
  <view class="link-hint" wx:if="{{platforms[platformIndex].key === 'fenwandao'}}">
    想按具体票档盯票，在「我的」页填一次纷玩岛凭证即可。
  </view>

  <!-- 12306：携程式表单 —— 起点终点两大块 + 交换 + 日期 -->
  <view class="rail-card" wx:if="{{platforms[platformIndex].key === 'rail12306'}}">
    <view class="rail-top">
      <view class="rail-station">
        <view class="rail-station-lbl">出发地</view>
        <input class="rail-station-inp" placeholder="如 广州南" value="{{from}}" bindinput="onFrom" />
      </view>
      <view class="rail-swap press" bindtap="swapStations" hover-class="press-hover">
        <view class="rail-swap-line"></view>
        <view class="rail-swap-arrow">⇌</view>
      </view>
      <view class="rail-station rail-station-r">
        <view class="rail-station-lbl">目的地</view>
        <input class="rail-station-inp" placeholder="如 长沙南" value="{{to}}" bindinput="onTo" />
      </view>
    </view>
    <view class="rail-bottom">
      <view class="rail-dates">
        <view class="rail-date-chip press {{date === todayStr ? 'chip-on' : ''}}" data-off="0" bindtap="quickDate" hover-class="press-hover">今天</view>
        <view class="rail-date-chip press {{date === tomorrowStr ? 'chip-on' : ''}}" data-off="1" bindtap="quickDate" hover-class="press-hover">明天</view>
        <picker mode="date" value="{{date}}" start="{{todayStr}}" bindchange="onDate" class="rail-date-pick">
          <view class="rail-date-chip">{{date}}</view>
        </picker>
      </view>
      <view class="search-btn {{searching ? 'disabled' : ''}}" bindtap="onSearch" hover-class="press-hover">
        {{searching ? '查着' : '查余票'}}
      </view>
    </view>
  </view>

  <!-- ============ 使用教程 / 常见问题 ============ -->
  <view class="card faq">
    <view class="faq-head" bindtap="toggleFaq" hover-class="press-hover">
      <view class="faq-head-l">
        <image class="faq-stk" src="/images/board2/cartoon7.png" mode="aspectFit" />
        <view class="faq-title title-strong">使用教程 · 常见问题</view>
      </view>
      <text class="faq-arrow {{faqOpen ? 'faq-arrow-open' : ''}}">▾</text>
    </view>
    <view class="faq-body" wx:if="{{faqOpen}}">
      <view class="faq-item" wx:for="{{faqList}}" wx:key="q">
        <view class="faq-q">
          <text class="faq-q-t">{{item.q}}</text>
        </view>
        <view class="faq-a">{{item.a}}</view>
      </view>
    </view>
  </view>

  <!-- 搜索失败 -->
  <view class="card fail" wx:if="{{fail}}">
    <view class="fail-t">搜索失败</view>
    <view class="fail-b">{{fail}}</view>
  </view>

  <!-- 搜索中：骨架 -->
  <view class="card sk-card" wx:if="{{searching}}">
    <view class="sk sk-t" style="width:60%"></view>
    <view class="sk" style="width:40%;height:12px;margin-top:12px"></view>
  </view>

  <!-- ============ 正在热卖（每个平台都有自己的榜；12306 是查票没有榜） ============ -->
  <block wx:if="{{platforms[platformIndex].key !== 'rail12306' && !searched && !searching}}">

    <view class="sec">
      <view class="sec-title title-strong">正在热卖</view>
      <view class="tag tag-bad">在售</view>
    </view>

    <view class="card sk-card" wx:if="{{hotLoading}}">
      <view class="sk sk-t" style="width:55%"></view>
      <view class="sk" style="width:35%;height:12px;margin-top:12px"></view>
    </view>

    <view class="card empty" wx:if="{{!hotLoading && hotFail}}">
      <view class="empty-mark"></view>
      <view class="empty-title">这个平台的热卖榜还没拿到</view>
      <view class="empty-sub">{{hotFail}}</view>
    </view>

    <view class="hot-list" wx:if="{{!hotLoading && hot.length}}">
      <view class="show-card press-card" wx:for="{{hot}}" wx:key="_uk" hover-class="press-card-hover" data-row="{{item}}" bindtap="openDetail">
        <block wx:if="{{item.platform !== 'rail12306'}}">
          <view class="poster">
            <image class="poster-img" src="{{item.poster}}" mode="aspectFill" lazy-load />
          </view>
          <view class="poster poster-blank" wx:if="{{!item.poster}}"></view>
        </block>
        <view class="show-main">
          <view class="show-name">{{item.name}}</view>
          <view class="show-meta">
            <text class="tag">{{item.platformLabel}}</text>
            <text class="tag {{item.statusCls}}" wx:if="{{item.status}}">{{item.status}}</text>
          </view>
          <view class="show-sub">
            <text wx:if="{{item.city}}">{{item.city}}</text>
            <text wx:if="{{item.city && item.dateRange}}"> · </text>
            <text wx:if="{{item.dateRange}}">{{item.dateRange}}</text>
          </view>
          <view class="show-foot">
            <text class="show-price" wx:if="{{item.price}}">{{item.price}} 起</text>
            <view class="show-more" catchtap="openDetail" data-row="{{item}}">详情 ›</view>
            <view
              class="btn-watch {{adding === item.id ? 'btn-watch-busy' : ''}}"
              data-row="{{item}}"
              catchtap="add"
              hover-class="press-hover"
            >{{adding === item.id ? '…' : '盯'}}</view>
          </view>
        </view>
      </view>
    </view>

    <view class="sec-more" wx:if="{{hot.length}}">点开看场次和票档 · 数据来自{{platforms[platformIndex].label}}</view>
  </block>

  <!-- ============ 搜索结果 ============ -->
  <block wx:if="{{searched && !searching}}">
    <!-- 搜过没结果 -->
    <view class="card empty" wx:if="{{!rows.length && !fail}}">
      <view class="empty-mark"></view>
      <view class="empty-title">没搜到</view>
      <view class="empty-sub">换个词试试。</view>
    </view>

    <view class="hot-list" wx:if="{{rows.length}}">
      <view class="show-card press-card" wx:for="{{rows}}" wx:key="_uk" hover-class="press-card-hover" data-row="{{item}}" bindtap="openDetail">
        <block wx:if="{{item.platform !== 'rail12306'}}">
          <view class="poster">
            <image class="poster-img" src="{{item.poster}}" mode="aspectFill" lazy-load />
          </view>
          <view class="poster poster-blank" wx:if="{{!item.poster}}"></view>
        </block>
        <view class="show-main">
          <view class="show-name">{{item.name}}</view>
          <view class="show-meta">
            <text class="tag">{{item.platformLabel}}</text>
            <text class="tag {{item.statusCls}}" wx:if="{{item.status}}">{{item.status}}</text>
            <text class="tag tag-none" wx:if="{{!item.status && item.city}}">{{item.city}}</text>
          </view>
          <view class="show-sub">
            <text wx:if="{{item.dateRange}}">{{item.dateRange}}</text>
            <text wx:if="{{item.route}}">{{item.route}}</text>
          </view>
          <view class="show-foot">
            <text class="show-price" wx:if="{{item.price}}">{{item.price}} 起</text>
            <view class="show-more" catchtap="openDetail" data-row="{{item}}">详情 ›</view>
            <view
              class="btn-watch {{adding === item.id ? 'btn-watch-busy' : ''}}"
              data-row="{{item}}"
              catchtap="add"
              hover-class="press-hover"
            >{{adding === item.id ? '…' : '盯'}}</view>
          </view>
        </view>
      </view>
    </view>
  </block>

  <!-- 搜索历史 -->
  <view class="card hist" wx:if="{{history.length && !rows.length && !searching && platforms[platformIndex].key !== 'rail12306'}}">
    <view class="hist-head">
      <text class="hist-title">最近搜过</text>
      <text class="hist-clear press" bindtap="clearHistory" hover-class="press-hover">清空</text>
    </view>
    <view class="hist-body">
      <view class="chip" wx:for="{{history}}" wx:key="*this" data-kw="{{item}}" bindtap="useHistory" hover-class="press-hover">
        {{item}}
      </view>
    </view>
  </view>

  <view class="safe"></view>

  <!-- vant 反馈节点（函数式 API 需要页面里有这两个组件） -->
  <van-toast id="van-toast" />
  <van-dialog id="van-dialog" />
</view>
