<!-- 场次页：打名字 → 搜 → 点一下开始盯。整页只有一个输入框，不做多余的事。 -->
<view class="page">

  <!-- 搜索栏 -->
  <view class="searchbar">
    <view class="search-box">
      <text class="search-ico"></text>
      <input
        class="search-inp"
        placeholder="演出名 / 巡演名，中英文都行"
        placeholder-class="search-ph"
        value="{{kw}}"
        confirm-type="search"
        bindinput="onInput"
        bindconfirm="onSearch"
      />
      <text class="search-clear" wx:if="{{kw}}" bindtap="clearAll">清除</text>
    </view>
    <view class="search-btn {{searching ? 'disabled' : ''}}" bindtap="onSearch">
      {{searching ? '搜着' : '搜'}}
    </view>
  </view>

  <!-- 还没搜过：给例子，别留白 -->
  <view class="card empty" wx:if="{{!searched && !searching}}">
    <view class="empty-icon"></view>
    <view class="empty-title">想盯什么就打什么</view>
    <view class="empty-sub">
      不用去别的 App 翻链接、抠 id。<br />
      打「孙燕姿」「周杰伦」，或者英文巡演名都行。
    </view>
  </view>

  <!-- 搜过没结果：说清是「没搜到」还是「平台挂了」 -->
  <view class="card empty" wx:if="{{!searching && searched && !rows.length && !fail}}">
    <view class="empty-icon"></view>
    <view class="empty-title">没搜到这个</view>
    <view class="empty-sub">
      换个说法再试试：短一点的关键词、或者英文原名。<br />
      摩天轮是二手票平台，冷门场次确实可能没挂单。
    </view>
  </view>

  <view class="card fail" wx:if="{{fail}}">
    <view class="fail-t">搜索失败</view>
    <view class="fail-b">{{fail}}</view>
  </view>

  <!-- 搜索中：骨架卡，比转圈更有耐心 -->
  <view class="card sk-card" wx:if="{{searching}}">
    <view class="sk sk-t" style="width:60%"></view>
    <view class="sk" style="width:40%;height:12px;margin-top:12px"></view>
  </view>

  <!-- 结果 -->
  <view class="row-card" wx:for="{{rows}}" wx:key="tourId">
    <view class="poster" wx:if="{{item.poster}}">
      <image class="poster-img" src="{{item.poster}}" mode="aspectFill" lazy-load />
    </view>
    <view class="poster poster-blank" wx:else></view>

    <view class="row-main">
      <view class="row-name">{{item.name}}</view>
      <view class="row-meta">
        <text class="tag tag-brand">{{item.city || '未知城市'}}</text>
      </view>
      <view class="row-sub">
        <text wx:if="{{item.dateRange}}">{{item.dateRange}}</text>
        <text wx:if="{{item.price}}" class="row-price">{{item.price}} 起</text>
      </view>
    </view>

    <view
      class="row-add {{adding === item.tourId ? 'row-add-busy' : ''}}"
      data-row="{{item}}"
      bindtap="add"
    >
      {{adding === item.tourId ? '…' : '盯'}}
    </view>
  </view>

  <!-- 搜索历史 -->
  <view class="card hist" wx:if="{{history.length && !rows.length && !searching}}">
    <view class="hist-head">
      <text class="hist-title">最近搜过</text>
      <text class="hist-clear" bindtap="clearHistory">清空</text>
    </view>
    <view class="hist-body">
      <view class="chip" wx:for="{{history}}" wx:key="*this" data-kw="{{item}}" bindtap="useHistory">
        {{item}}
      </view>
    </view>
  </view>

  <view class="safe"></view>
</view>
