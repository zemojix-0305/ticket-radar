<!-- 开屏页 v6：纯拼贴，无文字（第十八轮）
     整个屏幕 = 一张暖白纸上的拼贴：
     顶部手撕条（纯图形）→ 打孔线 → 主视觉区（大折纸星 + 手绘星轨 + 小星 + 两片手剪胶带，不对称、大面积留白）
     → 打孔线 → 底部条码（纯图形）+ 圆形纸片按钮（贴纸星星 + 胶带）。
     没有任何文字；点任意处进入，2.4s 自动进入（逻辑在 splash.js）。
     贴纸逐张「贴上」：外层定位 + 旋转，内层做 scale/淡入动画（避免动画覆盖自身 rotate）。 -->
<view class="splash-page" bindtap="goHome">

  <!-- 顶部手撕条：纯图形，底边锯齿撕口 -->
  <view class="tear-strip anim-fade" style="animation-delay:.02s"></view>
  <view class="tear-edge anim-fade" style="animation-delay:.02s"></view>

  <view class="perf splash-perf anim-fade" style="animation-delay:.1s"></view>

  <!-- 主视觉拼贴区 -->
  <view class="stage">
    <!-- 大折纸星：视觉重心，偏左上 -->
    <view class="stk stk-main">
      <view class="stk-in" style="animation-delay:.18s">
        <image src="/images/board2/origami11.png" mode="widthFix" />
      </view>
    </view>
    <!-- 手剪胶带：斜贴大星星上沿 -->
    <view class="stk stk-tape1">
      <view class="stk-in" style="animation-delay:.62s">
        <view class="tape tape-kraft"></view>
      </view>
    </view>
    <!-- 手绘星轨：右上，和大星呼应 -->
    <view class="stk stk-trail">
      <view class="stk-in" style="animation-delay:.3s">
        <image src="/images/board2/cartoon10.png" mode="widthFix" />
      </view>
    </view>
    <!-- 小黄折纸星：左下 -->
    <view class="stk stk-yellow">
      <view class="stk-in" style="animation-delay:.42s">
        <image src="/images/board2/origami22.png" mode="widthFix" />
      </view>
    </view>
    <!-- 小红折纸星：右中点缀 -->
    <view class="stk stk-red">
      <view class="stk-in" style="animation-delay:.54s">
        <image src="/images/board2/origami8.png" mode="widthFix" />
      </view>
    </view>
    <!-- 小红胶带：右下角压住一点空白 -->
    <view class="stk stk-tape2">
      <view class="stk-in" style="animation-delay:.7s">
        <view class="tape tape-red"></view>
      </view>
    </view>
  </view>

  <view class="perf splash-perf anim-fade" style="animation-delay:.78s"></view>

  <!-- 底部：条码（纯图形）+ 圆形纸片按钮 -->
  <view class="dock">
    <view class="dock-barcode anim-fade" style="animation-delay:.86s">
      <view class="barcode"></view>
    </view>
    <view class="stk stk-btn">
      <view class="stk-in" style="animation-delay:.95s">
        <view class="enter-disc">
          <view class="enter-tape"></view>
          <image class="enter-stk" src="/images/board2/origami22.png" mode="widthFix" />
        </view>
      </view>
    </view>
  </view>

</view>
