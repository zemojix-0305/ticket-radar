/* 开屏页 v6：纯拼贴，无文字（第十八轮）
   暖白纸 + 手撕条 + 打孔线 + 折纸星星/手绘星轨/手剪胶带拼贴。
   动效克制：撕条/打孔线淡入，贴纸逐张「贴上」（内层 scale，外层旋转），全部 1.5s 内完成。 */
.splash-page {
  position: fixed;
  top: 0; left: 0; right: 0; bottom: 0;
  background: var(--paper);
  z-index: 9999;
  overflow: hidden;
  display: flex;
  flex-direction: column;
}

/* ---------- 顶部手撕条：纯图形 ---------- */
.tear-strip {
  height: 56rpx;
  margin-top: env(safe-area-inset-top);
  background: #ECE3CE;
  border-bottom: 1rpx solid var(--line);
}
/* 撕条底边锯齿：两片 45° 渐变三角交错出撕口 */
.tear-edge {
  height: 12rpx;
  background-image:
    linear-gradient(135deg, #ECE3CE 50%, transparent 50%),
    linear-gradient(-135deg, #ECE3CE 50%, transparent 50%);
  background-size: 24rpx 12rpx;
  background-repeat: repeat-x;
  background-position: 0 0, 12rpx 0;
}
.splash-perf { margin: 0 40rpx; }

/* ---------- 主视觉拼贴区 ---------- */
.stage {
  flex: 1;
  position: relative;
  min-height: 0;
}

/* 外层：定位 + 手贴旋转；内层：贴上动画 */
.stk { position: absolute; }
.stk-in {
  opacity: 0;
  animation: stk-in 0.5s cubic-bezier(0.34, 1.56, 0.64, 1) forwards;
}
.stk image { display: block; width: 100%; }
@keyframes stk-in {
  from { opacity: 0; transform: scale(1.35); }
  to   { opacity: 0.95; transform: scale(1); }
}

/* 大折纸星：280rpx，中央偏左上，视觉重心 */
.stk-main {
  width: 280rpx;
  top: 120rpx;
  left: 190rpx;
  transform: rotate(-7deg);
}
/* 胶带1：斜压大星星上沿 */
.stk-tape1 {
  top: 96rpx;
  left: 258rpx;
  transform: rotate(-24deg);
}
.stk-tape1 .tape { width: 150rpx; height: 40rpx; }
/* 手绘星轨：右上 */
.stk-trail {
  width: 180rpx;
  top: 70rpx;
  right: 36rpx;
  transform: rotate(12deg);
}
/* 小黄折纸星：左下 */
.stk-yellow {
  width: 96rpx;
  top: 470rpx;
  left: 84rpx;
  transform: rotate(-16deg);
}
/* 小红折纸星：右中点缀 */
.stk-red {
  width: 60rpx;
  top: 520rpx;
  right: 150rpx;
  transform: rotate(10deg);
}
/* 胶带2：右下 */
.stk-tape2 {
  top: 600rpx;
  right: 210rpx;
  transform: rotate(16deg);
}
.stk-tape2 .tape { width: 120rpx; height: 34rpx; }

/* ---------- 底部：条码 + 圆形纸片按钮 ---------- */
.dock {
  display: flex;
  align-items: flex-end;
  justify-content: space-between;
  padding: 34rpx 56rpx calc(env(safe-area-inset-bottom) + 40rpx);
}
.dock-barcode .barcode {
  width: 260rpx;
  height: 60rpx;
  opacity: 0.85;
}

/* 圆形纸片按钮：纸卡底 + 墨色细边 + 贴纸星星 + 斜压胶带 */
.stk-btn { padding-bottom: 8rpx; }
.enter-disc {
  position: relative;
  width: 216rpx;
  height: 216rpx;
  border-radius: 50%;
  background: var(--card);
  border: 1rpx solid var(--line2);
  box-shadow: 0 2rpx 0 rgba(42, 38, 32, 0.05);
  display: flex;
  align-items: center;
  justify-content: center;
  transform: rotate(-4deg);
}
.enter-tape {
  position: absolute;
  top: -16rpx;
  left: 50%;
  margin-left: -46rpx;
  width: 92rpx;
  height: 30rpx;
  background: rgba(162, 59, 46, 0.32);
  transform: rotate(-8deg);
}
.enter-stk {
  width: 96rpx;
  display: block;
  margin-top: 10rpx;
}

/* ---------- 淡入（撕条 / 打孔线 / 条码用） ---------- */
.anim-fade {
  opacity: 0;
  animation: fade-in 0.5s ease forwards;
}
@keyframes fade-in {
  from { opacity: 0; }
  to   { opacity: 1; }
}
