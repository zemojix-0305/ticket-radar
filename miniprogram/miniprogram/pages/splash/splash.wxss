/* 开屏页 v3：一张真·车票
   构图 = 纯白底 + 中央车票卡（微转 -3°，打孔线分主券/副券）
   + 三张贴纸点缀。动画：车票先落定，贴纸错峰「啪」地贴上。 */
.splash-page {
  position: fixed;
  top: 0; left: 0; right: 0; bottom: 0;
  background: #FFFFFF;
  display: flex;
  align-items: center;
  justify-content: center;
  z-index: 9999;
  overflow: hidden;
}

/* ---------- 贴纸（克制：三张） ---------- */
.stk {
  position: absolute;
  opacity: 0;
  animation: sticker-in 0.4s cubic-bezier(0.34, 1.56, 0.64, 1) forwards;
}
.stk-star  { width: 130rpx; top: 17%; right: 14%; animation-delay: 0.55s; }
.stk-crane { width: 150rpx; bottom: 20%; left: 9%;  animation-delay: 0.75s; }
.stk-spark { width: 84rpx;  top: 24%; left: 12%;   animation-delay: 0.95s; }
@keyframes sticker-in {
  from { opacity: 0; scale: 1.4; }
  to   { opacity: 1; scale: 1; }
}

/* ---------- 车票 ---------- */
.ticket {
  position: relative;
  display: flex;
  align-items: stretch;
  width: 600rpx;
  padding: 56rpx 0;
  background: #FFFFFF;
  border: 2rpx solid #ECECEE;
  border-radius: 20rpx;
  box-shadow: 0 18rpx 60rpx rgba(26, 26, 26, 0.08);
  transform: rotate(-3deg);
  opacity: 0;
  animation: ticket-up 0.55s cubic-bezier(0.22, 1, 0.36, 1) 0.1s forwards;
}
@keyframes ticket-up {
  from { opacity: 0; transform: rotate(-3deg) translateY(40rpx); }
  to   { opacity: 1; transform: rotate(-3deg) translateY(0); }
}

/* 胶带：压在票顶 */
.tape {
  position: absolute;
  top: -18rpx;
  left: 50%;
  width: 150rpx;
  height: 40rpx;
  background: rgba(235, 220, 160, 0.8);
  transform: translateX(-50%) rotate(-4deg);
  box-shadow: 0 2rpx 6rpx rgba(26, 26, 26, 0.06);
}

/* 主券 */
.ticket-main {
  flex: 1;
  padding: 0 40rpx 0 48rpx;
  display: flex;
  flex-direction: column;
  justify-content: center;
}
.ticket-cn {
  font-size: 72rpx;
  font-weight: 600;
  line-height: 1.15;
  color: #1A1A1A;
  letter-spacing: 6rpx;
}
.ticket-en {
  margin-top: 18rpx;
  font-size: 19rpx;
  letter-spacing: 3rpx;
  color: #9A9A9F;
}
.ticket-slogan {
  margin-top: 34rpx;
  font-size: 26rpx;
  color: #2456DB;
  letter-spacing: 3rpx;
}

/* 打孔线 */
.perforation {
  width: 0;
  border-left: 3rpx dashed #D9D9DE;
}
/* 打孔圆缺：白圆 + 浅环，模拟被撕票口 */
.hole {
  position: absolute;
  left: 424rpx;
  width: 34rpx;
  height: 34rpx;
  border-radius: 50%;
  background: #FFFFFF;
  box-shadow: inset 0 0 0 2rpx #ECECEE;
}
.hole-top    { top: -19rpx; }
.hole-bottom { bottom: -19rpx; }

/* 副券 */
.ticket-stub {
  width: 150rpx;
  padding: 0 30rpx 0 26rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 18rpx;
}
.stub-txt {
  font-size: 17rpx;
  letter-spacing: 2rpx;
  color: #9A9A9F;
  text-transform: uppercase;
}
/* 条码：硬边条纹（不是视觉渐变），像真票 */
.barcode {
  width: 96rpx;
  height: 56rpx;
  background: repeating-linear-gradient(
    90deg,
    #1A1A1A 0 3rpx, transparent 3rpx 7rpx,
    #1A1A1A 7rpx 9rpx, transparent 9rpx 14rpx
  );
}
.stub-no {
  font-size: 17rpx;
  letter-spacing: 2rpx;
  color: #B9B9BE;
}

/* ---------- 底部提示 ---------- */
.splash-hint {
  position: absolute;
  bottom: 70rpx;
  font-size: 22rpx;
  letter-spacing: 5rpx;
  color: #C4C4C9;
  animation: hint-blink 2.2s ease-in-out infinite;
}
@keyframes hint-blink {
  0%, 100% { opacity: 0.4; }
  50% { opacity: 1; }
}
