/* 开屏页 v4：coquette 手账票根（第十五轮重做）
   构图 = 纯白底 + 满底高透明拼贴层 + 中央票根卡（微转 -3°，打孔线分主券/副券）
   + 胶带与蝴蝶结压票顶 + 五张贴纸错峰「啪」地贴上。
   配色 = 白 + 玫瑰粉 #BC3565 + 浅粉 #F2C7D4；文字全部系统默认字体。 */
.splash-page {
  position: fixed;
  top: 0; left: 0; right: 0; bottom: 0;
  background: #FFFFFF;
  display: flex;
  align-items: center;
  justify-content: center;
  z-index: 9999;
  overflow: hidden;
}

/* ---------- 满底拼贴层 ----------
   八张素材，透明度 0.10~0.16，像桌面上垫着的拼贴纸。
   纯装饰：不响应点击。 */
.splash-bg {
  position: absolute;
  top: 0; left: 0; right: 0; bottom: 0;
  pointer-events: none;
}
.sbg { position: absolute; }
.sbg-1 { width: 200rpx; height: 200rpx; top: 8%;   right: -40rpx; transform: rotate(14deg); opacity: 0.13; }
.sbg-2 { width: 150rpx; height: 150rpx; top: 22%;  left: -30rpx;  transform: rotate(-10deg); opacity: 0.12; }
.sbg-3 { width: 170rpx; height: 170rpx; bottom: 16%; left: -36rpx; transform: rotate(8deg);  opacity: 0.11; }
.sbg-4 { width: 120rpx; height: 120rpx; bottom: 8%;  right: 6%;   transform: rotate(-14deg); opacity: 0.12; }
.sbg-5 { width: 60rpx;  height: 60rpx;  top: 14%;  left: 18%;    transform: rotate(-12deg); opacity: 0.15; }
.sbg-6 { width: 52rpx;  height: 52rpx;  top: 40%;  right: 10%;   transform: rotate(16deg);  opacity: 0.15; }
.sbg-7 { width: 48rpx;  height: 48rpx;  bottom: 30%; right: 20%; transform: rotate(-8deg);  opacity: 0.15; }
.sbg-8 { width: 130rpx; height: 130rpx; top: 60%;  right: -30rpx; transform: rotate(10deg); opacity: 0.10; }

/* ---------- 贴纸（错峰贴上：五张） ---------- */
.stk {
  position: absolute;
  opacity: 0;
  animation: sticker-in 0.4s cubic-bezier(0.34, 1.56, 0.64, 1) forwards;
}
.stk-heart { width: 120rpx; top: 20%;  left: 10%;  animation-delay: 0.55s; }
.stk-star  { width: 96rpx;  top: 13%;  right: 16%; animation-delay: 0.75s; }
.stk-star2 { width: 72rpx;  bottom: 22%; right: 11%; animation-delay: 0.95s; }
.stk-trail { width: 110rpx; top: 30%;  left: 6%;   animation-delay: 1.15s; }
.stk-love  { width: 100rpx; bottom: 15%; left: 16%; animation-delay: 1.35s; }
@keyframes sticker-in {
  from { opacity: 0; scale: 1.4; }
  to   { opacity: 1; scale: 1; }
}

/* ---------- 票根 ---------- */
.ticket {
  position: relative;
  display: flex;
  align-items: stretch;
  width: 600rpx;
  padding: 56rpx 0;
  background: #FFFFFF;
  border: 2rpx solid #F2C7D4;          /* 玫瑰粉描边，替代原来的灰 */
  border-radius: 28rpx;                 /* coquette：更圆的角 */
  box-shadow: 0 18rpx 60rpx rgba(188, 53, 101, 0.10);
  transform: rotate(-3deg);
  opacity: 0;
  animation: ticket-up 0.55s cubic-bezier(0.22, 1, 0.36, 1) 0.1s forwards;
}
@keyframes ticket-up {
  from { opacity: 0; transform: rotate(-3deg) translateY(40rpx); }
  to   { opacity: 1; transform: rotate(-3deg) translateY(0); }
}

/* 和纸胶带：粉色，斜压在票顶 */
.tape {
  position: absolute;
  top: -18rpx;
  left: 50%;
  width: 150rpx;
  height: 40rpx;
  background: rgba(188, 53, 101, 0.22);
  transform: translateX(-50%) rotate(-4deg);
  border-radius: 3rpx;
  box-shadow: 0 2rpx 6rpx rgba(26, 26, 26, 0.05);
}
/* 蝴蝶结：骑在胶带上方，coquette 签名元素 */
.ticket-bow {
  position: absolute;
  top: -34rpx;
  left: 50%;
  margin-left: -15px;
  transform: scale(1.6) rotate(-4deg);
}

/* 主券 */
.ticket-main {
  flex: 1;
  padding: 0 40rpx 0 48rpx;
  display: flex;
  flex-direction: column;
  justify-content: center;
}
.ticket-cn {
  font-size: 72rpx;
  font-weight: 600;
  line-height: 1.15;
  color: #1A1A1A;
  letter-spacing: 6rpx;
}
.ticket-en {
  margin-top: 18rpx;
  font-size: 19rpx;
  letter-spacing: 3rpx;
  color: #9A9A9F;
}
.ticket-slogan {
  margin-top: 34rpx;
  font-size: 26rpx;
  color: #BC3565;
  letter-spacing: 3rpx;
}
/* 三颗小星：粉 / 蓝 / 黄，坐在口号下方 */
.ticket-stars {
  display: flex;
  align-items: center;
  gap: 10rpx;
  margin-top: 26rpx;
}
.ticket-stars image {
  width: 34rpx;
  height: 34rpx;
}
.ticket-stars image:nth-child(2) { transform: rotate(12deg); }
.ticket-stars image:nth-child(3) { transform: rotate(-10deg); }

/* 打孔线 */
.perforation {
  width: 0;
  border-left: 3rpx dashed #F2C7D4;
}
/* 打孔圆缺：白圆 + 粉环，模拟被撕票口 */
.hole {
  position: absolute;
  left: 424rpx;
  width: 34rpx;
  height: 34rpx;
  border-radius: 50%;
  background: #FFFFFF;
  box-shadow: inset 0 0 0 2rpx #F2C7D4;
}
.hole-top    { top: -19rpx; }
.hole-bottom { bottom: -19rpx; }

/* 副券 */
.ticket-stub {
  width: 150rpx;
  padding: 0 30rpx 0 26rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 18rpx;
}
.stub-txt {
  font-size: 17rpx;
  letter-spacing: 2rpx;
  color: #9A9A9F;
  text-transform: uppercase;
}
/* 条码：硬边条纹（不是视觉渐变），像真票 */
.barcode {
  width: 96rpx;
  height: 56rpx;
  background: repeating-linear-gradient(
    90deg,
    #1A1A1A 0 3rpx, transparent 3rpx 7rpx,
    #1A1A1A 7rpx 9rpx, transparent 9rpx 14rpx
  );
}
.stub-no {
  font-size: 17rpx;
  letter-spacing: 2rpx;
  color: #B9B9BE;
}

/* ---------- 底部提示 ---------- */
.splash-hint {
  position: absolute;
  bottom: 70rpx;
  font-size: 22rpx;
  letter-spacing: 5rpx;
  color: #C4C4C9;
  animation: hint-blink 2.2s ease-in-out infinite;
}
@keyframes hint-blink {
  0%, 100% { opacity: 0.4; }
  50% { opacity: 1; }
}
