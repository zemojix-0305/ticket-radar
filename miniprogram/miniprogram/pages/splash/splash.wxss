/* 开屏页 v5：整屏票根（第十七轮）
   整个屏幕 = 一张暖白期刊纸票根：
   顶部撕条（TICKET-RADAR / NO.2026）→ 打孔线 → 主券（眉题/大标题/口号/场次信息格/印章）
   → 打孔线 → 副券（条码/编号/进入按钮）。
   动效克制（MOTION 5）：内容级联上浮 60ms 一档，贴纸「啪」地贴上。
   配色：纸 #F7F2E7 + 暖墨 #2A2620，茶绿只给「进入」按钮和「监控中」印章。 */
.splash-page {
  position: fixed;
  top: 0; left: 0; right: 0; bottom: 0;
  background: var(--paper);
  z-index: 9999;
  overflow: hidden;
  display: flex;
  flex-direction: column;
}

/* ---------- 拼贴层：透明度 0.06~0.09，只在四角留白处 ---------- */
.splash-bg {
  position: absolute;
  top: 0; left: 0; right: 0; bottom: 0;
  pointer-events: none;
}
.sbg { position: absolute; }
.sbg-1 { width: 180rpx; height: 180rpx; top: 5%;    right: -46rpx; transform: rotate(14deg);  opacity: 0.08; }
.sbg-2 { width: 140rpx; height: 140rpx; top: 30%;   left: -40rpx;  transform: rotate(-10deg); opacity: 0.07; }
.sbg-3 { width: 150rpx; height: 150rpx; bottom: 8%; left: -40rpx;  transform: rotate(8deg);   opacity: 0.07; }
.sbg-4 { width: 120rpx; height: 120rpx; bottom: 30%; right: -30rpx; transform: rotate(-14deg); opacity: 0.06; }
.sbg-5 { width: 54rpx;  height: 54rpx;  top: 11%;   left: 13%;     transform: rotate(-12deg); opacity: 0.09; }

/* ---------- 右侧竖排水印 ---------- */
.watermark {
  position: absolute;
  right: 6rpx;
  top: 0; bottom: 0;
  width: 34rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  pointer-events: none;
}
.watermark-t {
  white-space: nowrap;
  font-size: 17rpx;
  letter-spacing: 7rpx;
  color: var(--ink);
  opacity: 0.07;
  transform: rotate(90deg);
}

/* ---------- 票根：整屏一列 ---------- */
.ticket {
  flex: 1;
  display: flex;
  flex-direction: column;
  padding: 0 40rpx;
  min-height: 100%;
}

/* 顶部撕条 */
.ticket-top {
  display: flex;
  align-items: baseline;
  justify-content: space-between;
  padding: calc(env(safe-area-inset-top) + 24rpx) 4rpx 20rpx;
}
.top-name {
  font-size: 24rpx;
  font-weight: 600;
  letter-spacing: 5rpx;
  color: var(--ink);
}
.top-no {
  font-size: 20rpx;
  letter-spacing: 2rpx;
  color: var(--ink3);
  font-variant-numeric: tabular-nums;
}
/* 打孔线在票内通栏 */
.ticket-perf { margin: 0 -40rpx; }

/* 主券 */
.ticket-main {
  flex: 1;
  display: flex;
  flex-direction: column;
  justify-content: center;
  padding: 48rpx 4rpx;
  position: relative;   /* 容纳印章 / 胶带 / 贴纸 */
}
.ticket-eyebrow {
  font-size: 20rpx;
  letter-spacing: 5rpx;
  color: var(--ink3);
  margin-bottom: 22rpx;
}
.ticket-title {
  font-size: 96rpx;
  font-weight: 700;
  letter-spacing: 10rpx;
  line-height: 1.12;
  color: var(--ink);
}
.ticket-slogan {
  margin-top: 28rpx;
  font-size: 26rpx;
  letter-spacing: 2rpx;
  line-height: 1.6;
  color: var(--ink2);
}

/* 场次信息格：虚线分栏，像真票的演出信息 */
.ticket-info {
  margin-top: 72rpx;
  display: flex;
}
.info-cell { flex: 1; min-width: 0; }
.info-cell + .info-cell {
  border-left: 1px dashed var(--line2);
  padding-left: 24rpx;
}
.info-lbl {
  display: block;
  font-size: 17rpx;
  letter-spacing: 2rpx;
  color: var(--ink3);
  margin-bottom: 12rpx;
}
.info-v {
  display: block;
  font-size: 30rpx;
  font-weight: 600;
  letter-spacing: 1rpx;
  color: var(--ink);
}

/* 印章：监控中 */
.ticket-stamp {
  position: absolute;
  top: 56rpx;
  right: 4rpx;
  transform: rotate(-8deg);
  font-size: 22rpx;
  letter-spacing: 5rpx;
  padding: 8rpx 20rpx;
  border-width: 2rpx;
  border-radius: 6rpx;
  opacity: 0.8;
}

/* 胶带 + 贴纸：贴在主券两角 */
.ticket-tape {
  top: 34rpx;
  left: 4rpx;
  width: 130rpx;
  height: 36rpx;
  transform: rotate(-6deg);
}
.ticket-stk {
  position: absolute;
  opacity: 0;
  animation: sticker-in 0.45s cubic-bezier(0.34, 1.56, 0.64, 1) forwards;
}
.stk-a { width: 88rpx; top: 150rpx; right: 4rpx;   transform: rotate(12deg); animation-delay: 0.8s;  opacity: 0; }
.stk-b { width: 72rpx; bottom: 64rpx; left: 4rpx;  transform: rotate(-9deg); animation-delay: 0.95s; opacity: 0; }
@keyframes sticker-in {
  from { opacity: 0; scale: 1.4; }
  to   { opacity: 0.92; scale: 1; }
}

/* 副券 */
.ticket-stub {
  display: flex;
  align-items: flex-end;
  justify-content: space-between;
  gap: 28rpx;
  padding: 30rpx 4rpx calc(env(safe-area-inset-bottom) + 30rpx);
}
.stub-barcode {
  width: 230rpx;
  height: 66rpx;
}
.stub-no {
  display: block;
  margin-top: 14rpx;
  font-size: 18rpx;
  letter-spacing: 3rpx;
  color: var(--ink3);
  font-variant-numeric: tabular-nums;
}
.stub-r {
  display: flex;
  flex-direction: column;
  align-items: flex-end;
  gap: 16rpx;
}
.btn-enter {
  min-width: 208rpx;
  height: 86rpx;
  line-height: 86rpx;
  text-align: center;
  padding: 0 40rpx;
  background: var(--accent);
  color: var(--on-brand);
  border-radius: var(--r);
  font-size: 30rpx;
  font-weight: 500;
  letter-spacing: 8rpx;
  box-sizing: border-box;
}
.stub-hint {
  font-size: 20rpx;
  letter-spacing: 2rpx;
  color: var(--ink3);
  animation: hint-blink 2.2s ease-in-out infinite;
}
@keyframes hint-blink {
  0%, 100% { opacity: 0.45; }
  50% { opacity: 1; }
}

/* ---------- 入场动效：内容级联上浮 ---------- */
.anim {
  opacity: 0;
  animation: fade-up 0.5s cubic-bezier(0.22, 1, 0.36, 1) forwards;
}
@keyframes fade-up {
  from { opacity: 0; transform: translateY(26rpx); }
  to   { opacity: 1; transform: translateY(0); }
}
/* 只有淡入（不覆盖自身 transform 的元素用） */
.anim-fade {
  opacity: 0;
  animation: fade-in 0.5s ease forwards;
}
@keyframes fade-in {
  from { opacity: 0; }
  to   { opacity: 0.85; }
}
