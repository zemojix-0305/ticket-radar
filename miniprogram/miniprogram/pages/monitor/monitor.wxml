<!-- 监控页：首屏回答三个问题——我在盯几个、现在有没有票、上次什么时候查的 -->
<view class="page">

  <!-- 额度条：微信一次性订阅会消耗额度，不说出来用户只会觉得"推送到此为止" -->
  <view class="credit {{credit > 0 ? '' : 'credit-empty'}}" bindtap="goMine">
    <view class="credit-l">
      <text class="credit-t">还能收 <text class="credit-n">{{credit > 0 ? credit : 0}}</text> 条推送</text>
      <text class="credit-s">{{credit > 0 ? '用完了点这领新的' : '去领额度，否则有票也收不到'}}</text>
    </view>
    <text class="credit-go">{{credit > 0 ? '领额度' : '去领'}}</text>
  </view>

  <!-- 概览 -->
  <view class="hero">
    <view class="hero-l">
      <view class="hero-line">
        <text class="num hero-n">{{okCount}}</text>
        <text class="hero-sep">/</text>
        <text class="num hero-total">{{states.length}}</text>
      </view>
      <view class="hero-sub">
        个监控有票<text wx:if="{{loading}}"> · 正在刷新</text>
      </view>
    </view>
    <button class="hero-add" bindtap="openAdd">
      <text class="hero-plus">＋</text>
      <text class="hero-add-t">加监控</text>
    </button>
  </view>

  <!-- 拿不到数据要说清是哪一类问题，否则用户只会以为小程序坏了 -->
  <view class="card fail" wx:if="{{fail}}">
    <view class="fail-t">读不到状态</view>
    <view class="fail-b">{{fail}}</view>
    <button class="btn btn-ghost fail-btn" bindtap="refresh">重试</button>
  </view>

  <!-- 骨架屏：给形状而不是转圈 -->
  <view class="card sk-card" wx:if="{{loading && !states.length}}">
    <view class="sk sk-t" style="width:45%"></view>
    <view class="sk" style="width:70%;height:12px;margin-top:12px"></view>
    <view class="sk" style="width:35%;height:12px;margin-top:10px"></view>
  </view>

  <!-- 空状态：给动作，不只说"暂无数据" -->
  <view class="card empty" wx:if="{{!loading && !states.length && !fail}}">
    <view class="empty-icon"></view>
    <view class="empty-title">还没在盯任何场次</view>
    <view class="empty-sub">
      去「场次」页搜演出名字，点一下就能加。<br />
      火车票也行，填「广州南 长沙南」就成。
    </view>
    <view class="empty-acts">
      <button class="btn btn-primary" bindtap="goShows">去找演出</button>
    </view>
  </view>

  <!-- 任务卡片 -->
  <view class="card task" wx:for="{{states}}" wx:key="_id">
    <view class="task-bar {{item.barClass}}"></view>
    <view class="task-body">
      <view class="task-top" bindtap="toggle" data-id="{{item._id}}">
        <view class="task-l">
          <view class="t1 task-name">{{item.name}}</view>
          <view class="t2 task-sub">{{item.platform}}<text wx:if="{{item.sub2}}"> · {{item.sub2}}</text></view>
        </view>
        <text class="tag {{item.headClass}}">{{item.head}}</text>
      </view>

      <view class="err" wx:if="{{!item.ok}}">
        <text class="err-t">{{item.error}}</text>
        <text class="t3" wx:if="{{item.error_kind === 'blocked'}}">
          这通常是云函数 IP 被平台风控了，不是你的设置问题。
        </text>
      </view>

      <view class="task-foot" bindtap="toggle" data-id="{{item._id}}">
        <text class="t3">{{item.relTime}}</text>
        <view class="task-foot-r">
          <text class="t3" wx:if="{{item.more}}">展开 {{item.total}} 项</text>
          <text class="link">余票历史 ›</text>
        </view>
      </view>

      <view class="items" wx:if="{{expanded[item._id]}}">
        <view class="item" wx:for="{{item.show}}" wx:for-item="it" wx:key="label">
          <text class="i-label">{{it.label}}</text>
          <text class="t3">{{it.when}}</text>
          <text class="t2 i-st">{{it.status}}</text>
        </view>
        <text class="t3" wx:if="{{item.more}}">…… 另有 {{item.more}} 条</text>
      </view>
    </view>
  </view>

  <view class="safe"></view>
</view>

<!-- 添加任务的底部弹层 -->
<view class="mask" wx:if="{{showAdd}}" bindtap="closeAdd"></view>
<view class="sheet" wx:if="{{showAdd}}">
  <view class="sheet-grab"></view>
  <view class="sheet-title">加一个监控</view>
  <view class="sheet-sub">不用去别的 App 找链接，填个名字或线路就行。</view>

  <view class="field">
    <view class="field-lbl">平台</view>
    <picker mode="selector" range="{{platforms}}" range-key="label" bindchange="onPlatform">
      <view class="input-pick">{{platforms[platformIndex].label}} ▾</view>
    </picker>
  </view>
  <view class="sheet-sub">{{platforms[platformIndex].hint}}</view>

  <view class="field">
    <view class="field-lbl">{{platforms[platformIndex].key === 'rail12306' ? '线路（例：广州南 长沙南）' : 'ID'}}</view>
    <input class="input" placeholder="{{platforms[platformIndex].ph}}" value="{{form.id}}" data-k="id" bindinput="onInput" />
  </view>

  <view class="field">
    <view class="field-lbl">备注名（可留空）</view>
    <input class="input" placeholder="留空就自动生成" value="{{form.name}}" data-k="name" bindinput="onInput" />
  </view>

  <view class="field" wx:if="{{platforms[platformIndex].key === 'moretickets'}}">
    <view class="field-lbl">城市（可留空）</view>
    <input class="input" placeholder="例：广州" value="{{form.city}}" data-k="city" bindinput="onInput" />
  </view>

  <view class="field" wx:if="{{platforms[platformIndex].key === 'rail12306'}}">
    <view class="field-lbl">乘车日期</view>
    <picker mode="date" value="{{form.date}}" bindchange="onDate">
      <view class="input-pick">{{form.date || '点这里选'}}</view>
    </picker>
  </view>

  <view class="acts">
    <button class="btn btn-ghost" bindtap="closeAdd">取消</button>
    <button class="btn btn-primary" bindtap="submitAdd">开始盯</button>
  </view>
</view>
