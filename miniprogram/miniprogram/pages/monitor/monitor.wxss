.page { padding-bottom: 8px; position: relative; }

/* ---------- 背景拼贴层定位（素材见 wxml，样式在 app.wxss）---------- */
.bg-youme   { width: 110px; height: 110px; top: 520px; right: -22px; transform: rotate(-10deg); }
.bg-cloud   { width: 100px; height: 100px; top: 900px; left: -18px; transform: rotate(6deg); }
.bg-sparkle { width: 70px;  height: 70px;  top: 180px; right: 6%; }
.bg-star3   { width: 26px;  height: 26px;  top: 330px; left: 7%; transform: rotate(-14deg); }
.bg-star4   { width: 22px;  height: 22px;  top: 720px; right: 14%; transform: rotate(12deg); }

/* ---------- 顶部：极简排版 ---------- */
.hero {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 26px 20px 16px;
  position: relative;   /* 容纳胶带 */
}
.hero-title-row {
  display: flex;
  align-items: center;
  gap: 8px;
}
.hero-title {
  /* 粗黑体大标题：干净、不土；手账感由胶带+贴纸表达 */
  font-size: 26px;
  font-weight: 600;
  letter-spacing: 0.5px;
  color: var(--t1);
  white-space: nowrap;
  margin-bottom: 6px;
}
.hero-l { flex: 1; min-width: 0; }
.hero-stks { display: flex; align-items: center; gap: 2px; }
.hero-stk {
  width: 30px;
  height: 30px;
  margin-bottom: 6px;
  transform: rotate(10deg);
  opacity: 0.95;
}
.hero-stk.stk-b { width: 24px; height: 24px; transform: rotate(-8deg); margin-left: -4px; }
.hero-count { display: flex; align-items: baseline; gap: 5px; margin-top: 12px; }
.hero-ok { color: var(--t1); }
.hero-total { color: var(--t3); }
.hero-sep { font-size: 20px; font-weight: 300; color: var(--t3); margin: 0 2px; }
.hero-sub { font-size: 13px; color: var(--t2); margin-left: 4px; }
.hero-add {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  width: 80px;
  height: 44px;
  padding: 0;
  background: var(--accent);
  border-radius: 22px;
  line-height: 1.15;
  flex-shrink: 0;
  box-shadow: 0 4px 12px rgba(78, 107, 224, 0.25);
}
.hero-add::after { border: none; }
.hero-plus { font-size: 21px; color: #FFFFFF; }
.hero-add-t { font-size: 11px; color: #FFFFFF; }

/* ---------- 快捷入口：4 列一行，线性图标 + 灰字，克制不抢戏 ---------- */
.quick-grid {
  display: grid;
  grid-template-columns: 1fr 1fr 1fr 1fr;
  gap: 0;
  margin: 4px 12px 8px;
  padding: 14px 0;
  background: var(--card);
  border-radius: var(--r);
  border: 1px solid var(--line);
}
.quick-item {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 8px;
}
.quick-icon {
  width: 40px;
  height: 40px;
  border-radius: 50%;
  background: var(--none-weak);
  display: flex;
  align-items: center;
  justify-content: center;
}
.quick-t {
  font-size: 12px;
  color: var(--t2);
}

/* 图标统一近黑，克制 */
.quick-cross {
  position: relative;
  width: 15px;
  height: 15px;
}
.quick-cross::before,
.quick-cross::after {
  content: '';
  position: absolute;
  background: var(--t2);
  border-radius: 2px;
}
.quick-cross::before { width: 15px; height: 3px; left: 0; top: 6px; }
.quick-cross::after { width: 3px; height: 15px; left: 6px; top: 0; }

/* 扫一扫 */
.scan-frame {
  width: 15px;
  height: 15px;
  border: 2px solid var(--t2);
  border-radius: 3px;
  position: relative;
}
.scan-frame::after {
  content: '';
  position: absolute;
  left: 2px;
  right: 2px;
  top: 50%;
  height: 2px;
  background: var(--t2);
  transform: translateY(-50%);
}

/* 搜索 */
.search-mag {
  width: 12px;
  height: 12px;
  border: 2px solid var(--t2);
  border-radius: 50%;
  position: relative;
}
.search-mag::after {
  content: '';
  position: absolute;
  right: -5px;
  bottom: -3px;
  width: 6px;
  height: 2px;
  background: var(--t2);
  transform: rotate(45deg);
  border-radius: 2px;
}

/* 图表 */
.chart-bars {
  display: flex;
  align-items: flex-end;
  gap: 2.5px;
  height: 15px;
}
.chart-bars view {
  width: 4px;
  background: var(--t2);
  border-radius: 2px;
}
.chart-bars view:nth-child(1) { height: 7px; }
.chart-bars view:nth-child(2) { height: 13px; }
.chart-bars view:nth-child(3) { height: 10px; }

/* ---------- 筛选 ---------- */
.segs {
  display: flex;
  gap: 2px;
  margin: 4px 12px 2px;
  padding: 3px;
  background: var(--card);
  border-radius: 999px;
  border: 1px solid var(--line);
}
.seg {
  flex: 1;
  text-align: center;
  padding: 7px 0;
  border-radius: 999px;
  font-size: 13px;
  color: var(--t2);
  letter-spacing: 0.3px;
  transition: all 0.15s;
}
.seg-on {
  background: var(--brand);
  color: var(--on-brand);
  font-weight: 500;
}
.seg-hover { background: var(--brand-weak); }
.seg-on.seg-hover { background: var(--brand-deep); }

/* ---------- 额度条 ---------- */
.credit {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin: 12px 12px 0;
  padding: 10px 14px;
  background: var(--card);
  border-radius: var(--r-sm);
  border: 1px solid var(--line);
}
.credit-empty { background: var(--warn-weak); }
.credit-l { min-width: 0; }
.credit-t { display: block; font-size: 14px; color: var(--brand); }
.credit-empty .credit-t { color: var(--warn); }
.credit-s { display: block; font-size: 12px; color: var(--t2); margin-top: 2px; }
.credit-n { font-size: 17px; font-weight: 600; }
.credit-go {
  font-size: 13px;
  color: var(--brand);
  border: 1px solid var(--brand-line);
  border-radius: 20px;
  padding: 4px 12px;
  flex-shrink: 0;
  margin-left: 12px;
}
.credit-empty .credit-go { color: var(--warn); border-color: var(--warn); }

/* ---------- 公告 banner ---------- */
.banner {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 10px;
  margin: 10px 12px 0;
  padding: 10px 12px;
  background: var(--warn-weak);
  border-radius: var(--r-sm);
}
.banner-t {
  flex: 1;
  font-size: 12px;
  color: var(--warn);
  line-height: 1.55;
}
.banner-x {
  flex-shrink: 0;
  width: 20px;
  height: 20px;
  line-height: 20px;
  text-align: center;
  border-radius: 50%;
  font-size: 15px;
  color: var(--warn);
}

/* ---------- 失败卡片 ---------- */
.fail { padding: 16px; }
.fail-t { font-size: 15px; color: var(--bad); margin-bottom: 6px; }
.fail-b { font-size: 13px; color: var(--t2); line-height: 1.6; }
.fail-btn { margin-top: 12px; }

/* ---------- 骨架 ---------- */
.sk-card { padding: 16px; }
.sk-t { height: 16px; }

/* ---------- 空状态补充 ---------- */
.empty-acts { margin-top: 18px; display: flex; justify-content: center; }

/* ---------- 任务列表 ---------- */
.task-list { margin: 10px 12px; }
.task-card {
  position: relative;
  background: var(--card);
  border-radius: var(--r);
  margin-bottom: 12px;
  overflow: hidden;
  border: 1px solid var(--line);
}
.task-topline {
  height: 5px;
  width: 100%;
}
.task-topline.task-bar-ok { background: var(--ok); }
.task-topline.task-bar-none { background: var(--bar-idle); }
.task-topline.task-bar-bad { background: var(--bad); }
.task-body { padding: 14px 16px 16px; }
.task-top { display: flex; align-items: flex-start; justify-content: space-between; gap: 10px; }
/* 海报缩略图：竞品同款「卡片带图」。旧任务没有 poster 字段时 wx:if 自动隐藏 */
.task-poster {
  width: 46px;
  height: 62px;
  border-radius: 8px;
  overflow: hidden;
  flex-shrink: 0;
  background: var(--bg-soft);
}
.task-l { flex: 1; min-width: 0; }
.task-name {
  font-size: 16px;
  font-weight: 500;
  color: var(--t1);
  line-height: 1.35;
}
.task-sub { display: block; margin-top: 4px; font-size: 12px; color: var(--t3); }
.task-foot {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-top: 14px;
  padding-top: 10px;
  border-top: 1px dashed var(--line);
}
.task-foot-r { display: flex; align-items: center; gap: 12px; }
.link { font-size: 12px; color: var(--brand); }

/* ---------- 抓取失败 ---------- */
.err {
  margin-top: 10px;
  padding: 10px 12px;
  background: var(--bad-weak);
  border-radius: var(--r-sm);
}
.err-t { display: block; font-size: 13px; color: var(--bad); margin-bottom: 4px; }

/* ---------- 展开的明细 ---------- */
.items { margin-top: 12px; }
.item {
  display: flex;
  align-items: center;
  gap: 10px;
  padding: 9px 0;
  border-top: 1px solid var(--line);
}
.i-label { flex: 1; min-width: 0; font-size: 14px; color: var(--t1); }
.i-st { flex-shrink: 0; }

/* ---------- 弹层 ---------- */
.acts { display: flex; gap: 10px; margin-top: 18px; }
.acts .btn { flex: 1; }

/* ---------- FAQ（常见问题 · 使用教程）---------- */
.faq { padding: 14px 16px; margin-bottom: 12px; }
.faq-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
}
.faq-head-l { display: flex; align-items: center; gap: 9px; min-width: 0; }
.faq-stk { width: 24px; height: 24px; flex-shrink: 0; }
.faq-title { font-size: 15px; font-weight: 600; color: var(--t1); letter-spacing: 0.5px; }
.faq-arrow { font-size: 13px; color: var(--t3); transition: transform 0.2s; flex-shrink: 0; }
.faq-arrow.open { transform: rotate(180deg); }
.faq-list { margin-top: 12px; }
.faq-item { padding: 10px 0; border-top: 1px solid var(--line); }
.faq-item:first-child { border-top: none; }
.faq-q {
  display: flex;
  align-items: flex-start;
  gap: 8px;
  font-size: 14px;
  color: var(--t1);
  line-height: 1.5;
}
.faq-dot { color: var(--brand); font-size: 12px; margin-top: 2px; flex-shrink: 0; }
.faq-a {
  margin-top: 8px;
  padding: 10px 12px;
  background: var(--bg);
  border-radius: var(--r-sm);
  font-size: 13px;
  color: var(--t2);
  line-height: 1.7;
}

/* ---------- 分享画布 ---------- */
.share-canvas {
  position: fixed;
  left: -9999px;
  top: 0;
  width: 300px;
  height: 180px;
}


/* 空状态的千纸鹤点缀 */
.empty-stk {
  width: 74px;
  height: 74px;
  margin: 0 auto 6px;
  display: block;
  transform: rotate(-8deg);
  opacity: 0.9;
}
